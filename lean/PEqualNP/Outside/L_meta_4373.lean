    (run : Live graph k t S) (ht : t=0) (sub : ∀ w ∈ S, w ∈ signedRoots a b) :
    ∀ i : Fin 9, primary i ∈ S := by
  have data : ∀ a b : Fin 9, legalPair a b → ∀ i : Fin 9,
      bit (posRow a b i) graph && !bit (negRow a b i) graph &&
      (signedRoots a b).all (fun w => w == primary i || !bit (posRow a b i) w || bit (negRow a b i) w)
       = true := by
    unfold legalPair
    decide +kernel
  intro i
  have hr := data a b ab i
  simp only [Bool.and_eq_true,Bool.not_eq_true',List.all_eq_true,Bool.or_eq_true,beq_iff_eq,decide_eq_true_eq] at hr
  obtain ⟨w,hw,p,q⟩ := mono_row_difference run ht hr.1.1 hr.1.2
  have hh := hr.2 w (sub w hw)
  rcases hh with (eq | hp) | hn
  · exact eq ▸ hw
  · rw [p] at hp
    contradiction
  · rw [q] at hn
    contradiction

theorem preparedGateExcluded {T : Sig} {roots : List Sig} (hp : proper T)
    (lower : Lower roots T 15) {c : Choice} {bank : List Sig}
    (build : makePool one roots [c] = some bank) {ws : Finset Sig}
    (mem : ∀ v ∈ ws, availableB one bank v = true) :
    Impossible T 13 ws := by
  have cut : poolCut one 15 13 [c].length bank ws.toList = true := by
    simp only [poolCut,Bool.and_eq_true,decide_eq_true_eq,List.all_eq_true,List.length_singleton]
    exact ⟨by omega,fun v hv => mem v (Finset.mem_toList.mp hv)⟩
  have no := poolCut_sound (slice_self hp lower) [c] build (Finset.nodup_toList _) cut
  simpa using no

set_option maxHeartbeats 0 in
theorem needAux {a b : Fin 9} (ab : legalPair a b) {k t S}
    (run : Live graph k t S) (small : k ≤ 13)
    (sub : ∀ w ∈ S, w ∈ signedRoots a b) (lower : Lower inputs graph 15) :
    seed ∈ S ∧ orValue a b ∈ S := by
  have join (c : Choice) (bank : List Sig) (skip : Sig)
      (ready : makePool one inputs [c] = some bank)
      (covers : (signedRoots a b).all (fun w => w == skip || availableB one bank w) = true) :
      skip ∈ S := by
    by_contra absent
    apply preparedGateExcluded graph_proper lower ready _ k t small run
    intro w hw
    have ok := List.all_eq_true.mp covers w (sub w hw)
    simp only [Bool.or_eq_true,beq_iff_eq] at ok
    rcases ok with same | works
    · exact False.elim (absent (same ▸ hw))
    · exact works
  have negReady : makePool one inputs [(2, primary 0,primary 0)] = some (seed::inputs) := by decide +kernel
  have orReady : ∀ a b : Fin 9, legalPair a b →
      makePool one inputs [orChoice a b] = some (orValue a b :: inputs) := by unfold legalPair; decide +kernel
  have covers : ∀ a b : Fin 9,
      (signedRoots a b).all (fun w => w == seed || availableB one (orValue a b::inputs) w) = true ∧
      (signedRoots a b).all (fun w => w == orValue a b || availableB one (seed::inputs) w) = true := by decide +kernel
  exact ⟨join _ _ _ (orReady _ _ ab) (covers _ _).1,join _ _ _ negReady (covers _ _).2⟩

theorem signedState {a b : Fin 9} (ab : legalPair a b) {k t S} (run : Live graph k t S)
    (ht : t=0) (small : k≤13) (sub : ∀ w ∈ S, w ∈ signedRoots a b)
    (lower : Lower inputs graph 15) : S=(signedRoots a b).toFinset := by
  have aux := needAux ab run small sub lower
  have all := allRaw ab run ht sub
  have eq : List.ofFn primary = inputs := input_list
  ext w
  rw [List.mem_toFinset]
  refine ⟨sub w,?_⟩
  intro hw
  simp only [signedRoots,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at hw
  rcases hw with hr | rfl | rfl
  · rw [←eq] at hr
    obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hr
    exact all i
  · exact aux.1
  · exact aux.2
def witnessM (w : List Sig) (z : Sig) : Prop :=
  ∃ d a b, a ∈ w ∧ b ∈ w ∧ proper a ∧ proper b ∧ a ≠ b ∧ z = bin d a b

private lemma bin_repM {w a b} (d : Bool) (ha : represented w a) (hb : represented w b) :
    represented w (bin d a b) ∨ witnessM w (bin d a b) := by
  have rz : represented w zero := Or.inr (fun h => h.1 rfl)
  have ro : represented w one := Or.inr (fun h => h.2 rfl)
  obtain ⟨a1,a0,az,ao,aa,aa'⟩ := bin_laws a
  obtain ⟨b1,b0,bz,bo,bb,bb'⟩ := bin_laws b
  rcases operand_cases ha with rfl | rfl | ⟨ham,hap⟩
  · rw [bin_comm]; cases d <;> simp_all
  · rw [bin_comm]; cases d <;> simp_all
  rcases operand_cases hb with rfl | rfl | ⟨hbm,hbp⟩
  · cases d <;> simp_all
  · cases d <;> simp_all
  by_cases he : a=b
  · subst b; cases d <;> simp_all
  exact Or.inr ⟨d,a,b,ham,hbm,hap,hbp,he,rfl⟩

private lemma gate_repM (w : List Sig) (g : Gate)
    (h : g.op ∈ ({GateOp.and,GateOp.or} : Set GateOp) ∧ g.inputs.length≤2) :
    represented w (gv w g) ∨ witnessM w (gv w g) := by
  obtain ⟨o,l⟩ := g
  simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at h
  obtain ⟨ho,hl⟩ := h
  have rz : represented w zero := Or.inr (fun h => h.1 rfl)
  have ro : represented w one := Or.inr (fun h => h.2 rfl)
  cases l with
  | nil =>
    rcases ho with rfl | rfl
    · exact Or.inl ro
    · exact Or.inl rz
  | cons i l =>
    cases l with
    | nil =>
      rcases ho with rfl | rfl
      · simpa only [gv,List.map_cons,List.map_nil,List.foldr_cons,List.foldr_nil,(bin_laws _).1] using Or.inl (b := witnessM w (w.getD i zero)) (get_rep w i)
      · simpa only [gv,List.map_cons,List.map_nil,List.foldr_cons,List.foldr_nil,(bin_laws _).2.1] using Or.inl (b := witnessM w (w.getD i zero)) (get_rep w i)
    | cons j l =>
      cases l with
      | cons a l => simp at hl
      | nil =>
        rcases ho with rfl | rfl
        · simpa only [gv,List.map_cons,List.map_nil,List.foldr_cons,List.foldr_nil,(bin_laws _).1] using bin_repM false (get_rep w i) (get_rep w j)
        · simpa only [gv,List.map_cons,List.map_nil,List.foldr_cons,List.foldr_nil,(bin_laws _).2.1] using bin_repM true (get_rep w i) (get_rep w j)

-- Remove a last computed signal from a backward derivation. A gate whose value
-- is already available, or is unused by the suffix, needs no entry in the plan.


private lemma pull_gateM {w : List Sig} {z : Sig} {k S} (h : Live target k 0 S)
    (hz : represented w z ∨ witnessM w z) (sub : ∀ a ∈ S, a ∈ w++[z]) :
    ∃ k' S', k' ≤ k+1 ∧ Live target k' 0 S' ∧ ∀ a ∈ S', a ∈ w := by
  by_cases hm : z ∈ S
  · by_cases hw : z ∈ w
    · refine ⟨k,S,by omega,h,?_⟩
      intro a ha
      have hu : a ∈ w ∨ a = z := by simpa using sub a ha
      rcases hu with hu | rfl
      · exact hu
      · exact hw
    · have hp := live_proper h z hm
      rcases hz with hr | ⟨d,a,b,ha,hb,pa,pb,hab,eq⟩
      · exact False.elim ((hr.resolve_left hw) hp)
      · subst z
        let U := S.erase (bin d a b)
        have ht : Live target k 0 (insert (bin d a b) U) := by simpa [U,Finset.insert_erase hm] using h
        have hu : ∀ v ∈ U, v ∈ w := by
          intro v hv
          obtain ⟨hne,hm⟩ := Finset.mem_erase.mp hv
          simpa [hne] using sub v hm
        have hf : bin d a b ∉ insert a (insert b U) := by
          intro hh
          rcases Finset.mem_insert.mp hh with eq | u
          · exact hw (eq.symm ▸ ha)
          rcases Finset.mem_insert.mp u with eq | u
          · exact hw (eq.symm ▸ hb)
          · exact hw (hu _ u)
        exact ⟨_,_,Nat.le_refl _,Live.binary pa pb hab hf ht,by simpa using And.intro ha (And.intro hb hu)⟩
  · refine ⟨k,S,by omega,h,?_⟩
    intro a ha
    have hn : a ≠ z := fun hh => hm (hh ▸ ha)
    simpa [hn] using sub a ha

private lemma extractM (gs : List Gate) (w : List Sig)
    (legal : ∀ g ∈ gs, g.op ∈ ({GateOp.and,GateOp.or} : Set GateOp) ∧ g.inputs.length≤2)
    (hp : proper target) (hout : target ∈ execute gs w) :
    ∃ k S, k ≤ gs.length ∧ Live target k 0 S ∧ ∀ a ∈ S, a ∈ w := by
  induction gs generalizing w with
  | nil => exact ⟨0,{target},by simp,Live.stop hp,by simpa [execute] using hout⟩
  | cons g gs ih =>
    obtain ⟨k,S,hk,ht,hs⟩ := ih (w++[gv w g]) (fun a ha => legal a (by simp [ha])) hout
    obtain ⟨l,T,hl,hu,hT⟩ := pull_gateM ht (gate_repM w g (legal g (by simp))) hs
    exact ⟨l,T,by simp; omega,hu,hT⟩

theorem getm (y : Fin 9 → Bool) (m : ℕ) (h : m < 9) : (List.ofFn y).getD m false = y ⟨m, h⟩ := by
  interval_cases m <;> rfl
theorem any_edge (y : Fin 9 → Bool) : ([1, 12, 23, 34, 40, 5, 16, 27, 38, 57, 68, 85] : List Nat).any
    (fun m => y (Fin.ofNat 9 (m / 10)) && y (Fin.ofNat 9 (m % 10))) = edge y := by
  simp only [List.any_cons, List.any_nil, Bool.or_false, edge, Bool.or_assoc]
  rfl
def fullCircuit (a b : Fin 9) (C : Circuit) : Circuit :=
  ⟨⟨GateOp.not,[0]⟩ :: ⟨GateOp.or,[a.val,b.val]⟩ :: C.gates, C.output⟩

theorem full_eval (a b : Fin 9) (C : Circuit) (x : Fin 9 → Bool) :
    (fullCircuit a b C).eval (List.ofFn x) =
      C.eval ((List.ofFn x ++ [!x 0]) ++ [x a || x b]) := by
  have get (i : Fin 9) : (List.ofFn x ++ [!x 0]).getD i.val false = x i := by
    rw [List.getD_append _ _ _ _ (by simp),getm _ _ i.isLt]
  have zero : (List.ofFn x).getD 0 false = x 0 := by simp
  simp only [fullCircuit,Circuit.eval,Circuit.wires,List.foldl_cons,List.map_cons,List.map_nil,
    GateOp.eval,List.headD_cons,zero,List.any_cons,List.any_nil,id_eq,Bool.or_false,get a,get b]

theorem noMoreNot (a b : Fin 9) (C : Circuit) (fan : PEqualNP.MetaComplexity.FanInTwo C)
    (small : C.size ≤ 13)
    (correct : ∀ x : Fin 9 → Bool, C.eval ((List.ofFn x ++ [!x 0]) ++ [x a || x b]) = edge x) :
    ∀ g ∈ C.gates, g.op ∈ ({GateOp.and,GateOp.or} : Set GateOp) ∧ g.inputs.length ≤ 2 := by
  intro gate hg
  obtain ⟨allow,len⟩ := fan gate hg
  refine ⟨?_,len⟩
  simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at allow ⊢
  rcases allow with h | h | h
  · exact Or.inl h
  · exact Or.inr h
  exfalso
  apply Binary.petersen_binary_bound (fullCircuit a b C)
  · intro g hm
    change g ∈ (⟨GateOp.not,[0]⟩ : Gate) :: ⟨GateOp.or,[a.val,b.val]⟩ :: C.gates at hm
    rcases List.mem_cons.mp hm with rfl | hm
    · simp
    rcases List.mem_cons.mp hm with rfl | hm
    · simp
    · exact fan g hm
  · intro x
    rw [full_eval,correct]
    simp only [edge,Binary.petersenF,Binary.PetersenNine.edgeFun,Binary.PetersenNine.edges,
      List.any_cons,List.any_nil,Bool.or_false,Bool.or_assoc]
  · have total := Binary.nonNotCount_add_notCount C.gates
    have someNot : gate ∈ (C.gates.filter (fun g => Binary.CircuitProof.isNotGate g.op)) := by
      exact List.mem_filter.mpr ⟨hg, by simp [h,Binary.CircuitProof.isNotGate]⟩
    have pos := List.length_pos_of_mem someNot
    have sz : C.gates.length ≤ 13 := small
    have short : Binary.CircuitProof.nonNotCount C.gates + 1 ≤ 13 := by omega
    simpa [fullCircuit,Binary.CircuitProof.nonNotCount,List.countP_cons,Binary.CircuitProof.isNotGate]
      using short

theorem mismatch (a b : Fin 9) (ab : legalPair a b) (C : Circuit)
    (fan : PEqualNP.MetaComplexity.FanInTwo C) (small : C.size ≤ 13)
    (correct : ∀ x : Fin 9 → Bool, C.eval ((List.ofFn x ++ [!x 0]) ++ [x a || x b]) = edge x)
    (lower : Lower inputs graph 15)
    (closed : ImpossibleM graph 13 (signedRoots a b).toFinset) : False := by
  have mon := noMoreNot a b C fan small correct
  have vals : ∀ r : Row, (signedRoots a b).map (bit r) =
      (List.ofFn (sample r) ++ [!(sample r 0)]) ++ [sample r a || sample r b] := by
    intro r
    rw [sampled]
    simp [signedRoots,seed,orValue,primary,bit_neg,bit_bin,sample,List.append_assoc]
  have eq : (execute C.gates (signedRoots a b)).getD C.output zero = graph := by
    apply BitVec.eq_of_getLsbD_eq
    intro j hj
    let r : Row := ⟨j,hj⟩
    change bit r ((execute C.gates (signedRoots a b)).getD C.output zero) = bit r graph
    rw [←b_read,execute_bits _ _ _ (fun g hg => (fan g hg).1),vals,edge_table]
    exact correct (sample r)
  have out := get_rep (execute C.gates (signedRoots a b)) C.output
  rw [eq] at out
  obtain ⟨k,S,hk,run,sub⟩ := extractM C.gates _ mon graph_proper (out.resolve_right (fun h => h graph_proper))
  have cap : k ≤ 13 := hk.trans small
  exact closed k 0 cap rfl (signedState ab run rfl cap sub lower ▸ run)
end Signed

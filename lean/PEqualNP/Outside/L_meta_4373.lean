lemma split_solve (k : Nat) (xs : List M) (c : M × M) (next : List M)
    (hc : (remaining xs).head? = some c) (eq : options c = next)
    (h : (next.any fun z => solve k (z :: xs)) = false) : solve (k+1) xs = false := by
  rw [solve]
  split
  · rfl
  · rw [hc]
    simpa only [eq] using h

def precedes (later : List (List M)) (xs : List M) : Bool :=
  match (remaining xs).head? with
  | none => false
  | some c => (options c).all fun z => later.contains (z::xs)

lemma previous_layer (k : Nat) (earlier later : List (List M))
    (ok : earlier.all (precedes later) = true)
    (no : ∀ xs ∈ later, solve k xs = false) :
    ∀ xs ∈ earlier, solve (k+1) xs = false := by
  intro xs hx
  have test := List.all_eq_true.mp ok xs hx
  cases e : (remaining xs).head? with
  | none => simp [precedes,e] at test
  | some c =>
    have all : (options c).all (fun z => later.contains (z::xs)) = true := by simpa [precedes,e] using test
    apply split_solve k xs c (options c) e rfl
    apply Bool.eq_false_iff.mpr
    intro yes
    obtain ⟨z,hz,truth⟩ := List.any_eq_true.mp yes
    have rejected := no (z :: xs) (List.contains_iff_mem.mp (List.all_eq_true.mp all z hz))
    rw [rejected] at truth
    contradiction


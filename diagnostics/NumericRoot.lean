def gate (d : Nat) (a b : Bool) :=
  if d=0 then a && b else if d=1 then a || b else if d=2 then a && !b else !a && b
abbrev Face := Nat × Nat × Nat × Nat × Nat × Nat

-- Codes zero and one are constants; higher codes identify raw input and phase.
def wire (f : Face) (i : Nat) : Nat :=
  let (off,on,_,v,w,neg) := f
  if off.testBit i then 0 else if on.testBit i then 1 else
  if v=i then 2*w+2+neg else 2*i+2

def value (x : Nat) (row : Nat) : Bool :=
  if x<2 then x==1 else Bool.xor (row.testBit ((x-2)/2)) (x%2==1)

def simplePrice (f : Face) (i j d m : Nat) : Bool :=
  let (off,on,bound,_,_,_) := f
  let a := wire f i
  let b := wire f j
  let ca := a<2
  let cb := b<2
  let known : Bool := decide ca || decide cb || a/2==b/2
  let g (u : Nat) := gate d (value a u) (value b u)
  let cz := known && g 0 == g (1 <<< ((a-2)/2)) && g 0 == g (1 <<< ((b-2)/2))
  let fixed := (List.range 12).countP (fun q => (off ||| on).testBit q)
  let lost := ((!m.testBit 0 && decide ca).toNat)+((!m.testBit 1 && decide cb).toNat)
  decide (18+(!known).toNat < bound+(fixed-lost)+cz.toNat)

def samplePass (i j d m : Nat) : Bool :=
  let rest := 4095 ^^^ ((if m.testBit 0 then 0 else 1 <<< i) ||| (if m.testBit 1 then 0 else 1 <<< j))
  rows.all (fun q => (q.1 ^^^ q.2) &&& rest != 0 ||
    gate d (q.1.testBit i) (q.1.testBit j) != gate d (q.2.testBit i) (q.2.testBit j))

def rootCheck : Bool :=
  (List.range 12).all (fun i => (List.range 12).all (fun j => i≥j ||
    (List.range 4).all (fun d => (List.range 4).all (fun m =>
      (samplePass i j d m && !prices.any (fun f => simplePrice f i j d m)) ==
        expected.contains (((i*12+j)*4+d)*4+m)))))

theorem all_root_choices : rootCheck=true := by decide +kernel


def col (l : D) : Nat := columns[l.val]!
def allowed (k j : K) (l : D) : Bool :=
  let f := 4294967295
  let c := col l
  ((c >>> (32*k.val)) &&& f == f) && ((c >>> (32*j.val)) &&& f == f)
def candidates (k j : K) := ((List.finRange 40).filter (allowed k j)).map col
def sums : List Nat → List Nat
  | [] => [full]
  | x::xs => let v:=sums xs; v ++ v.map (fun y=>x &&& y)
def mix (w : Nat) (k : K) : Bool :=
  let t := (w >>> (32*k.val)) &&& 4294967295
  t != 0 && t != 4294967295
def score (w : Nat) : Nat := (List.finRange 45).countP (mix w)
def family (a b : K) := (sums (candidates a b)).all (fun w=> w==full || decide (22≤score w))
def rowCheck (a : K) := (List.finRange 45).all (fun b => decide (b≤a) || family a b)
def sample (k : K) (i : I) := examples[32*k.val+i.val]!
def cell (l : D) := l.val/2
def sign (l : D) := l.val%2 == 1
def slot (k : K) (i : I) := 32*k.val+i.val

theorem captured {xs : List Nat} {ls : List Nat} (sub : ls.Sublist xs) :
    ls.foldr Nat.land full ∈ sums xs := by
  induction sub with
  | slnil => simp [sums]
  | cons x _ ih => exact List.mem_append_left _ ih
  | cons_cons x _ ih => exact List.mem_append_right _ (List.mem_map.mpr ⟨_,ih,rfl⟩)

theorem conclusion {a b : K} (row : rowCheck a=true) (lt : a<b)
    {ls : List Nat} (sub : ls.Sublist (candidates a b)) (proper : ls.foldr Nat.land full ≠ full) :
    22 ≤ score (ls.foldr Nat.land full) := by
  have h:=List.all_eq_true.mp row b (by simp)
  have e : decide (b≤a)=false := by simp [not_le.mpr lt]
  have H : family a b=true := by simpa [e] using h
  have v:=List.all_eq_true.mp H _ (captured sub)
  simpa [proper] using v


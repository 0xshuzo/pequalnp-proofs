abbrev KeyID := Fin 3306
def packed (i : KeyID) : Nat := (blocks[i.val / 64]!)[i.val % 64]!
def stateMask (i : KeyID) : Nat := packed i % 2^60
def rawCost (i : KeyID) : Nat := packed i >>> 60
def location (pos : Nat) : KeyID :=
  Fin.ofNat 3306 (((slots[pos/16]! >>> (12*(pos%16))) % 4096) - 1)
def keyOf (mask : Nat) : KeyID :=
  let x := location (((6020393187194243099*mask) % 2^64) >>> 51)
  if stateMask x == mask then x else location (((7359295400318889319*mask) % 2^64) >>> 51)
def child (i : KeyID) (v : V) (b : Bool) : KeyID :=
  keyOf (stateMask i &&& keep (v,!b))
def orbitReps : Array Nat := #[0,61,211,212,391,392,396,631,633,635,647,920,921,922,926,1301,1303,1304,1306,1307,1366,1721,1726,1937,1939,1940,1941,2297,2441,2443,2444,2451,2693,2705,2849,2885,2957,2958,2961,2962,3083,3095,3131,3203,3227,3239,3257,3293,3305]

abbrev Orbit := Fin 49
def rep (a : Orbit) : KeyID := Fin.ofNat 3306 orbitReps[a.val]!
def lane (a : Orbit) (b : KeyID) : Nat := 49*b.val+a.val
def laneMask : Nat := 2^(49*3306)-1
def tile : Nat := 2^49-1

def packing (scale : Nat) (f : Nat → Nat) : Nat → Nat
  | 0 => 0
  | n+1 => packing scale f n ||| (f n <<< (scale*n))

def flags (r : Nat) : Nat :=
  packing 1 (fun i => if (stateMask (rep (Fin.ofNat 49 i))).testBit r then 1 else 0) 49

def treePack (f : Nat → Nat) : Nat → Nat → Nat
  | 0, start => f start
  | d+1, start =>
    let span := 2^d
    treePack f d start ||| (treePack f d (start+span) <<< (49*span))

def singleCol (r : Nat) : Nat :=
  let f := flags r
  treePack (fun _ => f) 12 0

def doubleCol (r : Nat) : Nat :=
  treePack (fun b => if b < 3306 && (stateMask (Fin.ofNat 3306 b)).testBit r then tile else 0) 12 0

def colA : Array Nat := ((List.range 60).map singleCol).toArray
def colB : Array Nat := ((List.range 60).map doubleCol).toArray

def upperBox (m : Nat) (cols : Array Nat) : Nat :=
  (List.range 60).foldl (fun x r => if m.testBit r then x &&& cols[r]! else x) laneMask
def allowed (m : Nat) : Nat := laneMask ^^^ (upperBox m colA ||| upperBox m colB)

structure Panel where
  base : Nat
  mask : Nat
  cuts : List (Nat × Nat)
  deriving Inhabited

def panelAt (i : Nat) : Panel :=
  let z := packed (Fin.ofNat 3306 i)
  let m := z % 2^60
  let w := z >>> 60
  let pairs := if w ≤ 1 then [] else
    (List.range 12).foldl (fun acc v =>
      let a := (keyOf (m &&& zeros[v]!)).val
      let b := (keyOf (m &&& ones[v]!)).val
      let t := (min a b,max a b)
      if a < i && b < i && !(acc.contains t) then t::acc else acc) []
  ⟨w,m,pairs⟩



def convolution (l r : Array Nat) (k : Nat) : Nat :=
  let a := k+1-r.size
  let b := min (k+1) l.size
  (List.range (b-a)).foldl (fun m x =>
    let q := a+x
    m ||| (l[q]! &&& r[k-q]!)) 0

def fillRow (n : Panel) (prior : Nat → Array Nat) : Array Nat :=
  let ok := allowed n.mask
  ((List.range (n.base+1)).map (fun k =>
    if k ≤ 1 then laneMask else n.cuts.foldl (fun m p =>
      if m == 0 then 0 else m &&& convolution (prior p.1) (prior p.2) k) ok)).toArray

inductive Memo where
  | empty
  | leaf (v : Array Nat)
  | fork (lo hi : Memo)
  deriving Inhabited

def readMemo : Nat → Memo → Nat → Array Nat
  | 0,.leaf v,_ => v
  | d+1,.fork lo hi,i => if i.testBit d then readMemo d hi i else readMemo d lo i
  | _,_,_ => #[]

def putMemo : Nat → Memo → Nat → Array Nat → Memo
  | 0,_,_,v => .leaf v
  | d+1,p,i,v =>
    let (lo,hi) := match p with | .fork l h => (l,h) | _ => (.empty,.empty)
    if i.testBit d then .fork lo (putMemo d hi i v) else .fork (putMemo d lo i v) hi

def buildChunk : Nat → Nat → Memo → Memo
  | 0,_,t => t
  | n+1,i,t =>
    let fresh := fillRow (panelAt i) (readMemo 12 t)
    buildChunk n (i+1) (putMemo 12 t i fresh)


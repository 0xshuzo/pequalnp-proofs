def net (t : T) := circuits[t.val]!
def sample (i : Fin 58) (j : V) := masks[i.val]!.testBit j.val
def mk (C : Circuit) (j : ℕ) (k : V) : Prop :=
  (gateAt C j).op=.and ∧ InCone 14 C j (C.output-14) ∧ gateVal 14 C j (pairInput 0 7)=true ∧
  ∀ b : Fin 2,wireVal 14 C (opnd C j b) (pairInput k k)=false
instance (C : Circuit) (j : ℕ) (k : V) : Decidable (mk C j k) := by unfold mk; infer_instance
def witness (t : T) (k : Fin 16) (i : V) : Bool :=
  if k.val=14 ∨ k.val=extra[t.val]! then decide (i=0 ∨ i=7)
  else if k.val=15 then false else decide (i.val=k.val)
theorem gateTable : ∀ t : T, ∀ j : Fin (net t).gates.length,
      let g := (net t).gates[j.val]'(j.isLt)
      let a := g.inputs.getD 0 0
      let b := g.inputs.getD 1 0
      (g.op = .and ∨ g.op = .or) ∧ g.inputs = [a,b] ∧ a ≠ b ∧ a < 14+j.val ∧ b < 14+j.val := by decide +kernel

theorem budgets : ∀ t : T,(net t).size=27 ∧ 2≤((net t).output :: (net t).gates.flatMap Gate.inputs).count 17 := by decide +kernel
theorem marks : ∀ t : T,InCone 14 (net t) 4 7 ∧
    mk (net t) 4 (if swaps[t.val]! then 0 else 7) ∧ mk (net t) 7 (if swaps[t.val]! then 7 else 0) := by decide +kernel
theorem guards : ∀ (t : T) (k : Fin 16),wireVal 14 (net t) 17 (witness t k) = (net t).eval (List.ofFn (witness t k)) ∧
    wireVal 14 (net t) 17 (witness t k) ≠ (if h : k.val<14 then witness t k ⟨k.val,h⟩ else decide (k.val=15)) := by decide +kernel
theorem table : ∀ (t : T) (i : Fin 58), (net t).eval (List.ofFn (sample i)) = decide (i.val<21 ∧ i.val≠t.val+1) := by decide +kernel
end Research5962.Delete

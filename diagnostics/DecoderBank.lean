import PEqualNP.Defs
namespace PEqualNP.Outside.L_meta_9939_cut
def initial : List Nat := [0,255,170,204,240]
inductive Reach (paid : Nat → Prop) : Nat → Prop
  | input {x} : x∈initial → Reach paid x
  | majority : Reach paid 232 → Reach paid 23
  | conj {x y} : Reach paid x → Reach paid y → paid (x &&& y) → Reach paid (x &&& y)
  | disj {x y} : Reach paid x → Reach paid y → paid (x ||| y) → Reach paid (x ||| y)
structure Cut where
  closed : List Nat
  boundary : List Nat
  missing : Nat
def validate (targets : List Nat) (c : Cut) :=
  let ok := fun n => c.closed.contains n || c.boundary.contains n
  (((initial.all c.closed.contains &&
    (!c.closed.contains 232 || c.closed.contains 23)) &&
    (targets.contains c.missing && !c.closed.contains c.missing)) &&
    c.closed.all (fun x => c.closed.all (fun y => ok (x &&& y) && ok (x ||| y))))
theorem cut_needed {paid : Nat→Prop} {targets : List Nat} {c : Cut}
    (h : validate targets c=true) (need : ∀ t∈targets, Reach paid t) :
    ∃ v∈c.boundary, paid v := by
  classical
  simp only [validate,Bool.and_eq_true] at h
  by_contra absent
  have avoid {t} (yes : paid t) : t∉c.boundary := fun hit => absent ⟨t,hit,yes⟩
  have kept {x} (ok : (c.closed.contains x || c.boundary.contains x) = true) (yes : paid x) :
      x∈c.closed := by
    simp only [Bool.or_eq_true,List.contains_iff_mem] at ok
    exact ok.resolve_right (avoid yes)
  have inside {t : Nat} (re : Reach paid t) : t∈c.closed := by
    induction re with
    | input hm => exact List.contains_iff_mem.mp (List.all_eq_true.mp h.1.1.1 _ hm)
    | majority _ ih =>
      have me := h.1.1.2
      have yes : c.closed.contains 232=true := List.contains_iff_mem.mpr ih
      rw [yes] at me
      exact List.contains_iff_mem.mp (by simpa using me)
    | conj _ _ p hx hy =>
      have z := List.all_eq_true.mp (List.all_eq_true.mp h.2 _ hx) _ hy
      simp only [Bool.and_eq_true] at z
      exact kept z.1 p
    | disj _ _ p hx hy =>
      have z := List.all_eq_true.mp (List.all_eq_true.mp h.2 _ hx) _ hy
      simp only [Bool.and_eq_true] at z
      exact kept z.2 p
  have m := inside (need c.missing (List.contains_iff_mem.mp h.1.2.1))
  have ns := h.1.2.2
  have eq := (List.contains_iff_mem.mpr m : c.closed.contains c.missing=true)
  rw [eq] at ns
  contradiction

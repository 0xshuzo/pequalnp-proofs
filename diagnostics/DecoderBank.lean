theorem gates9 {paid : Nat→Prop} (goals : ∀ t∈([232, 150, 18, 159]:List Nat), Reach paid t) (c : Cut) (hc : c∈cuts9) : ∃v∈c.boundary, paid v := cut_needed (List.all_eq_true.mp valid9 c hc) goals
inductive Node
  | dead (i : Nat)
  | known (i : Nat)
  | branch (v : Nat) (left right : Node)
def replay (k : Nat) (cs : List Cut) (banks : List (List Nat)) :
    Node → Finset Nat → Finset Nat → Bool
  | .dead j, onv, offv =>
    match cs[j]? with
    | none => false
    | some c => c.boundary.all (fun v => decide (v∈offv ∨ (k≤onv.card ∧ v∉onv)))
  | .known j, onv, _ =>
    match banks[j]? with
    | none => false
    | some b => b.all (fun v => decide (v∈onv))
  | .branch v l r, onv, offv =>
    replay k cs banks l (insert v onv) offv && replay k cs banks r onv (insert v offv)
theorem replay_sound {k : Nat} {cs : List Cut} {banks : List (List Nat)} {paid : Finset Nat}
    (size : paid.card≤k) (hit : ∀ c∈cs, ∃ v∈c.boundary, v∈paid) (cert : Node)
    (onv offv : Finset Nat) (yes : onv⊆paid) (no : ∀ v∈offv, v∉paid)
    (ok : replay k cs banks cert onv offv=true) : ∃ b∈banks, ∀ v∈b, v∈paid := by
  induction cert generalizing onv offv with
  | dead j =>
    cases e : cs[j]? with
    | none => simp [replay,e] at ok
    | some c =>
      simp only [replay,e] at ok
      have hc : c∈cs := List.mem_of_getElem? e
      obtain ⟨v,hv,p⟩ := hit c hc
      have q : v∈offv ∨ (k≤onv.card ∧ v∉onv) := of_decide_eq_true (List.all_eq_true.mp ok v hv)
      rcases q with a | ⟨num,a⟩
      · exact False.elim (no v a p)
      · have eq := Finset.eq_of_subset_of_card_le yes (size.trans num)
        exact False.elim (a (eq.symm ▸ p))
  | known j =>
    cases e : banks[j]? with
    | none => simp [replay,e] at ok
    | some b =>
      simp only [replay,e] at ok
      exact ⟨b,List.mem_of_getElem? e, fun v hv => yes (of_decide_eq_true (List.all_eq_true.mp ok v hv))⟩
  | branch v l r il ir =>
    simp only [replay,Bool.and_eq_true] at ok
    by_cases p : v∈paid
    · exact il _ _ (Finset.insert_subset p yes) no ok.1
    · apply ir _ _ yes _ ok.2
      intro j hj
      rcases Finset.mem_insert.mp hj with eq | other
      · exact eq ▸ p
      · exact no j other
def readNode (tokens : List Nat) : Node :=
  let stack := tokens.foldl (fun (st : List Node) (n : Nat) =>
    if n%3=0 then Node.dead (n/3)::st else
    if n%3=1 then Node.known (n/3)::st else
    match st with
    | r::l::xs => Node.branch (n/3) l r :: xs
    | _ => []) []
  stack.headD (.dead 0)

open PEqualNP.Outside.L_meta_18065.Old3690 PEqualNP.CircuitLowerBounds in
theorem PEqualNP.Outside.L_meta_18065.Old3690 : ∀ (x1 : ℕ) (x2 : Finset (Fin x1 × Fin x1)) (x3 : Equiv.Perm (Fin x1)) (x4 : PEqualNP.CircuitLowerBounds.Circuit), (∀ (x5 : Fin x1), (x5, x3 x5) ∈ x2) → PEqualNP.TopForm.IsAO2 (x1 + x1) x4 → (∀ (x7 : Fin (x1 + x1) → Bool), PEqualNP.MetaComplexity.circuitFun (x1 + x1) x4 x7 = Decidable.decide (∃ (x8 : Fin x1) (x9 : Fin x1), (x8, x9) ∈ x2 ∧ x7 (Fin.castAdd x1 x8) = Bool.true ∧ x7 (Fin.natAdd x1 x9) = Bool.true)) → (2 : ℕ) * x1 ≤ x4.size + (1 : ℕ) := by
  intro N S σ C hmem hAO hev
  have hcn : ∀ (a b : Fin N), Fin.castAdd N a ≠ Fin.natAdd N b := by
    intro a b e
    have := congrArg Fin.val e
    simp at this
    omega
  have hni : ∀ (a b : Fin N), Fin.natAdd N a = Fin.natAdd N b → a = b := by
    intro a b e
    have := congrArg Fin.val e
    simp at this
    exact Fin.ext (by omega)
  have hci : ∀ (a b : Fin N), Fin.castAdd N a = Fin.castAdd N b → a = b := by
    intro a b e
    have := congrArg Fin.val e
    simp at this
    exact Fin.ext (by omega)
  have hsz : PEqualNP.MetaComplexity.HasCircuitSize (N + N)
      (PEqualNP.MetaComplexity.circuitFun (N + N) C) C.size := by
    refine ⟨C, ?_, le_refl _, fun x => rfl⟩
    intro g hg
    refine ⟨?_, le_of_eq (hAO.2.2 g hg)⟩
    rcases hAO.1 g hg with h | h
    · rw [h]; simp
    · rw [h]; simp
  have h := dep_lower (N + N) _ ?_ C.size hsz
  · omega
  · intro i
    refine Fin.addCases (fun p => ?_) (fun l => ?_) i
    · refine ⟨fun v => decide (v = Fin.natAdd N (σ p)), ?_⟩
      have hx0 : (decide (Fin.castAdd N p = Fin.natAdd N (σ p))) = false :=
        decide_eq_false (hcn p (σ p))
      intro heq
      rw [hev, hev] at heq
      have hA := (decide_eq_decide.1 heq).1 ⟨p, σ p, hmem p, by
        rw [Function.update_self]
        show (!decide (Fin.castAdd N p = Fin.natAdd N (σ p))) = true
        rw [hx0]; rfl, by
        rw [Function.update_of_ne (fun e => hcn p (σ p) e.symm)]
        exact decide_eq_true rfl⟩
      obtain ⟨a, b, _, ha, _⟩ := hA
      exact hcn a (σ p) (of_decide_eq_true ha)
    · refine ⟨fun v => decide (v = Fin.castAdd N (σ.symm l)), ?_⟩
      have hx0 : (decide (Fin.natAdd N l = Fin.castAdd N (σ.symm l))) = false :=
        decide_eq_false (fun e => hcn (σ.symm l) l e.symm)
      intro heq
      rw [hev, hev] at heq
      have hml : (σ.symm l, l) ∈ S := by
        have := hmem (σ.symm l)
        rw [Equiv.apply_symm_apply] at this
        exact this
      have hA := (decide_eq_decide.1 heq).1 ⟨σ.symm l, l, hml, by
        rw [Function.update_of_ne (fun e => hcn (σ.symm l) l e)]
        exact decide_eq_true rfl, by
        rw [Function.update_self]
        show (!decide (Fin.natAdd N l = Fin.castAdd N (σ.symm l))) = true
        rw [hx0]; rfl⟩
      obtain ⟨a, b, _, _, hb⟩ := hA
      exact hcn (σ.symm l) b (of_decide_eq_true hb).symm



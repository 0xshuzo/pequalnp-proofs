def sub (x y : Nat) := x &&& y == x
def lc (i : Nat) := lineCode[i]!
def colors (i : Nat) := safeColors[i]!
def area (i : Nat) := sector[i]!
def rules (i j k : Nat) (o : Bool) : Bool := Id.run do
  if k = i || k = j || k < 81 then return true
  if lc k != 0 then
    if lc i == 0 || lc j == 0 then return false
    if o then return lc k == (lc i ||| lc j)
    if lc k != (lc i &&& lc j) then return false
    if area k < 6 then
      let n := neighborhoods[area k]!
      return (sub (lc i) n && sub (lc k) (lc i)) || (sub (lc j) n && sub (lc k) (lc j))
    return true
  if colors k == 0 then return false
  if colors i != 0 || colors j != 0 then
    if o then return sub (colors k) (colors i ||| colors j)
    return (colors i != 0 && sub (colors k) (colors i)) || (colors j != 0 && sub (colors k) (colors j))
  if o then return false
  return (i < 6 && j == coefficient[i]! && colors k == 2^i) ||
         (j < 6 && i == coefficient[j]! && colors k == 2^j)

def trial (i j : Nat) (o : Bool) : Bool :=
  match lookup (if o then words[i]! ||| words[j]! else words[i]! &&& words[j]!) with
  | none => true
  | some k => rules i j k o

def perRow (i : Nat) : Bool := (List.range (i+1)).all (fun j => trial i j false && trial i j true)
def batch (a : Nat) : Bool := (List.range 15).all (fun j => perRow (15*a+j))

def positives : Set Input := {v | ∃ q ∈ edges, v = pairInput q}

theorem target_any (x : Input) :
    target x = edges.any (fun q => x q.1 && x q.2) := by
  dsimp only [target, edges, List.any]
  simp only [Bool.or_false, Bool.or_assoc]

theorem generated_target : Generated (fun x => target x = true) positives := by
  intro x
  change target x = true ↔ ∃ a ∈ positives, a ≤ x
  rw [target_any, List.any_eq_true]
  constructor
  · rintro ⟨q, hq, hv⟩
    exact ⟨pairInput q, ⟨q, hq, rfl⟩, (pair_le q x).2 (by simpa only [Bool.and_eq_true] using hv)⟩
  · rintro ⟨v, ⟨q, hq, rfl⟩, hv⟩
    exact ⟨q, hq, by simpa only [Bool.and_eq_true] using (pair_le q x).1 hv⟩

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

/-- A signed 118-gate witness can be submitted after checking the four
families against the displayed graph. The control may be any monotone DNF. -/
theorem certify (C : Circuit) (cb : FanInTwo C) (cs : C.size ≤ 118)
    {h : Input → Prop} {I T J : Set Input}
    (ni : NegativeCover (fun x => target x = true) I)
    (th : Generated h T) (nj : NegativeCover h J)
    (gm : FaceMono h (fun x => C.eval (List.ofFn x) = true))
    (p₀ : ∀ e ∈ positives, C.eval (List.ofFn e) = true)
    (p₁ : ∀ e ∈ positives, ∀ t ∈ T, C.eval (List.ofFn (e ⊔ t)) = true)
    (n₀ : ∀ i ∈ I, C.eval (List.ofFn i) ≠ true)
    (n₁ : ∀ i ∈ I, ∀ j ∈ J, C.eval (List.ofFn (i ⊓ j)) ≠ true) :
    HasCircuitSize 41 target 118 := by
  refine ⟨C, cb, cs, ?_⟩
  intro x
  rw [Bool.eq_iff_iff]
  exact (complete generated_target ni th nj gm p₀ p₁ n₀ n₁ x)


/-- Cutting the sole NOT gives two ordered monotone output functions. -/
structure Bracket {α : Type*} [PartialOrder α] (f h lo hi : α → Prop) : Prop where
  lowMono : ∀ ⦃x y⦄, x ≤ y → lo x → lo y
  highMono : ∀ ⦃x y⦄, x ≤ y → hi x → hi y
  ordered : ∀ x, lo x → hi x
  onFace : ∀ x, h x → (lo x ↔ f x)
  offFace : ∀ x, ¬ h x → (hi x ↔ f x)

theorem bracket_sandwich {α : Type*} [PartialOrder α] {f h lo hi : α → Prop}
    (b : Bracket f h lo hi) (x : α) : (lo x → f x) ∧ (f x → hi x) := by
  by_cases hx : h x
  · exact ⟨(b.onFace x hx).mp, fun fx => b.ordered x ((b.onFace x hx).mpr fx)⟩
  · exact ⟨fun lx => (b.offFace x hx).mp (b.ordered x lx), (b.offFace x hx).mpr⟩

/-- A low constant replacement needs to be tested only on the minimal
positive boundary. A high replacement needs only the maximal negative boundary. -/
theorem constant_test {α : Type*} [PartialOrder α] {f h lo hi : α → Prop} {E I : Set α}
    (b : Bracket f h lo hi) (ge : Generated f E) (ni : NegativeCover f I) :
    ((∀ x, lo x ↔ f x) ↔ ∀ e ∈ E, lo e) ∧
    ((∀ x, hi x ↔ f x) ↔ ∀ i ∈ I, ¬ hi i) := by
  constructor
  · constructor
    · exact fun eq e he => (eq e).mpr ((ge e).mpr ⟨e, he, le_rfl⟩)
    · intro all x
      refine ⟨(bracket_sandwich b x).1, ?_⟩
      intro fx
      obtain ⟨e, he, hex⟩ := (ge x).mp fx
      exact b.lowMono hex (all e he)
  · constructor
    · exact fun eq i hi' hx => ni.1 i hi' ((eq i).mp hx)
    · intro all x
      refine ⟨?_, (bracket_sandwich b x).2⟩
      intro hx
      by_contra nf
      obtain ⟨i, hi', hxi⟩ := ni.2 x nf
      exact all i hi' (b.highMono hxi hx)

/-- Every essential single NOT has an edge outside its control and an
independent upper witness within its control. Both can show the failure of a
physical constant replacement. -/
theorem critical_witnesses {α : Type*} [PartialOrder α] {f h lo hi : α → Prop} {E I : Set α}
    (b : Bracket f h lo hi) (ge : Generated f E) (ni : NegativeCover f I)
    (badLow : ¬ ∀ x, lo x ↔ f x) (badHigh : ¬ ∀ x, hi x ↔ f x) :
    (∃ e ∈ E, ¬ h e ∧ ¬ lo e) ∧ (∃ i ∈ I, h i ∧ hi i) := by
  classical
  obtain ⟨low, high⟩ := constant_test b ge ni
  have badE : ¬ ∀ e ∈ E, lo e := fun all => badLow (low.mpr all)
  have badI : ¬ ∀ i ∈ I, ¬ hi i := fun all => badHigh (high.mpr all)
  push_neg at badE badI
  obtain ⟨e, he, hle⟩ := badE
  obtain ⟨i, hi', hhi⟩ := badI
  refine ⟨⟨e, he, ?_, hle⟩, ⟨i, hi', ?_, hhi⟩⟩
  · exact fun ce => hle ((b.onFace e ce).mpr ((ge e).mpr ⟨e, he, le_rfl⟩))
  · by_contra hn
    exact ni.1 i hi' ((b.offFace i hn).mp hhi)

theorem comparable_control {α : Type*} [PartialOrder α] {f h lo hi : α → Prop}
    (b : Bracket f h lo hi) :
    ((∀ x, h x → f x) → ∀ x, hi x ↔ f x) ∧
    ((∀ x, f x → h x) → ∀ x, lo x ↔ f x) := by
  constructor
  · intro hf x
    by_cases hx : h x
    · exact ⟨fun _ => hf x hx, (bracket_sandwich b x).2⟩
    · exact b.offFace x hx
  · intro fh x
    exact ⟨(bracket_sandwich b x).1, fun fx => (b.onFace x (fh x fx)).mpr fx⟩


-- Monotonicity of a list of physical AND/OR gates, from L-meta-3012.
def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

theorem getD_le {w v : List Bool} (h : List.Forall₂ (fun a b => a ≤ b) w v) (i : ℕ) :
    w.getD i false ≤ v.getD i false := by
  induction h generalizing i with
  | nil => simp
  | cons hab _ ih =>
    cases i with
    | zero => simpa using hab
    | succ i => simpa using ih i

theorem bool_le {a b : Bool} : a ≤ b ↔ (a = true → b = true) := by
  cases a <;> cases b <;> decide

theorem gate_le (g : Gate) (hg : g.op = GateOp.and ∨ g.op = GateOp.or) {w v : List Bool}
    (h : List.Forall₂ (fun a b => a ≤ b) w v) :
    g.op.eval (g.inputs.map fun i => w.getD i false) ≤
      g.op.eval (g.inputs.map fun i => v.getD i false) := by
  rw [bool_le]
  rcases hg with hg | hg
  · rw [hg]
    simp only [GateOp.eval, List.all_eq_true, List.mem_map, id]
    intro hx x hx2
    obtain ⟨i, hi, rfl⟩ := hx2
    exact bool_le.mp (getD_le h i) (hx _ ⟨i, hi, rfl⟩)
  · rw [hg]
    simp only [GateOp.eval, List.any_eq_true, List.mem_map, id]
    rintro ⟨x, ⟨i, hi, rfl⟩, hx⟩
    exact ⟨_, ⟨i, hi, rfl⟩, bool_le.mp (getD_le h i) hx⟩

theorem fold_le (gs : List Gate) (hgs : ∀ g ∈ gs, g.op = GateOp.and ∨ g.op = GateOp.or) :
    ∀ w v : List Bool, List.Forall₂ (fun a b => a ≤ b) w v →
      List.Forall₂ (fun a b => a ≤ b) (gs.foldl step w) (gs.foldl step v) := by
  induction gs with
  | nil => intro w v h; simpa using h
  | cons g gs ih =>
    intro w v h
    simp only [List.foldl_cons]
    apply ih (fun g2 hg2 => hgs g2 (List.mem_cons_of_mem _ hg2))
    exact List.rel_append h (List.Forall₂.cons (gate_le g (hgs g List.mem_cons_self) h) List.Forall₂.nil)


def positiveMin {α : Type*} [PartialOrder α] (p : α → Prop) : Set α :=
  {x | Minimal p x}

def negativeMax {α : Type*} [PartialOrder α] (p : α → Prop) : Set α :=
  {x | Maximal (fun y => ¬ p y) x}

theorem minima_generate {α : Type*} [PartialOrder α] [Finite α] {p : α → Prop}
    (mono : ∀ ⦃x y⦄, x ≤ y → p x → p y) : Generated p (positiveMin p) := by
  intro x
  constructor
  · intro hx
    obtain ⟨y, hyx, hy⟩ := Finite.exists_le_minimal (p := p) hx
    exact ⟨y, hy, hyx⟩
  · rintro ⟨y, hy, hyx⟩
    exact mono hyx hy.1

theorem maxima_cover {α : Type*} [PartialOrder α] [Finite α] (p : α → Prop) :
    NegativeCover p (negativeMax p) := by
  constructor
  · exact fun _ hm => hm.1
  · intro x hx
    obtain ⟨y, hxy, hy⟩ := Finite.exists_le_maximal (p := fun v => ¬ p v) hx
    exact ⟨y, hy, hxy⟩

def binaryBasis (gs : List Gate) :=
  ∀ g ∈ gs, g.op = GateOp.and ∨ g.op = GateOp.or

def cutCircuit (pre : List Gate) (s : Nat) (post : List Gate) (o : Nat) : Circuit :=
  ⟨pre ++ ⟨GateOp.not, [s]⟩ :: post, o⟩

def prefixW (pre : List Gate) (x : Input) := pre.foldl step (List.ofFn x)

def cutValue (pre : List Gate) (s : Nat) (x : Input) := (prefixW pre x).getD s false

def active (pre : List Gate) (s : Nat) (x : Input) := cutValue pre s x = true

theorem prefix_le (pre : List Gate) (hp : binaryBasis pre) {x y : Input} (hxy : x ≤ y) :
    List.Forall₂ (fun a b => a ≤ b) (prefixW pre x) (prefixW pre y) := by
  apply fold_le pre hp
  rw [List.forall₂_iff_get]
  refine ⟨by simp only [List.length_ofFn], fun i h1 h2 => ?_⟩
  simp only [List.get_eq_getElem, List.getElem_ofFn]
  exact hxy _

theorem active_mono (pre : List Gate) (hp : binaryBasis pre) (s : Nat) {x y : Input}
    (hxy : x ≤ y) : active pre s x → active pre s y :=
  bool_le.mp (getD_le (prefix_le pre hp hxy) s)

theorem cut_eval (pre : List Gate) (s : Nat) (post : List Gate) (o : Nat) (x : Input) :
    (cutCircuit pre s post o).eval (List.ofFn x) =
      (post.foldl step (prefixW pre x ++ [!(cutValue pre s x)])).getD o false := by
  unfold cutCircuit Circuit.eval Circuit.wires
  rw [List.foldl_append, List.foldl_cons]
  rfl

theorem physical_face (pre : List Gate) (s : Nat) (post : List Gate) (o : Nat)
    (hp : binaryBasis pre) (hq : binaryBasis post) :
    FaceMono (active pre s) (fun x => (cutCircuit pre s post o).eval (List.ofFn x) = true) := by
  intro x y hxy heq hx
  have same : cutValue pre s x = cutValue pre s y := Bool.eq_iff_iff.mpr heq
  have init : List.Forall₂ (fun a b => a ≤ b)
      (prefixW pre x ++ [!(cutValue pre s x)]) (prefixW pre y ++ [!(cutValue pre s y)]) := by
    rw [same]
    exact List.rel_append (prefix_le pre hp hxy) (List.Forall₂.cons le_rfl List.Forall₂.nil)
  change (cutCircuit pre s post o).eval (List.ofFn x) = true at hx
  change (cutCircuit pre s post o).eval (List.ofFn y) = true
  rw [cut_eval] at hx ⊢
  exact bool_le.mp (getD_le (fold_le post hq _ _ init) o) hx


theorem m1892_eval_eq (C : Circuit) (x : List Bool) :
    C.eval x = (C.gates.foldl step x).getD C.output false := rfl

theorem m1892_getD_snoc (W : List Bool) (v : Bool) (i : ℕ) :
    (W ++ [v]).getD i false = if i = W.length then v else W.getD i false := by
  rcases lt_trichotomy i W.length with h | h | h
  · rw [ite_eq_right (by omega)]
    simp [List.getD_eq_getElem?_getD, List.getElem?_append_left h]
  · subst h
    simp [List.getD_eq_getElem?_getD]
  · rw [ite_eq_right (by omega)]
    rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
      List.getElem?_eq_none (by simp; omega), List.getElem?_eq_none (by omega)]

def shift (cut replacement i : Nat) : Nat :=
  if i < cut then i else if i=cut then replacement else i-1

def change (cut replacement : Nat) (g : Gate) : Gate :=
  ⟨g.op,g.inputs.map (shift cut replacement)⟩

def bypass (n : Nat) (pre post : List Gate) (o replacement : Nat) : Circuit :=
  ⟨pre ++ post.map (change (n+pre.length) replacement),shift (n+pre.length) replacement o⟩

def value (w : List Bool) (g : Gate) := g.op.eval (g.inputs.map fun i => w.getD i false)

theorem foldLength (gs : List Gate) (xs : List Bool) :
    (gs.foldl step xs).length = xs.length + gs.length := by
  induction gs generalizing xs with
  | nil => simp
  | cons g gs ih => simp [List.foldl_cons,ih,step] <;> omega

theorem extendRead (old fresh : List Bool) (cut replacement : Nat)
    (size : old.length = fresh.length+1) (room : cut ≤ fresh.length)
    (valid : replacement < cut ∨ fresh.length < replacement)
    (agree : ∀ i, old.getD i false = fresh.getD (shift cut replacement i) false)
    (v : Bool) (i : Nat) :
    (old++[v]).getD i false = (fresh++[v]).getD (shift cut replacement i) false := by
  rw [m1892_getD_snoc,m1892_getD_snoc,agree]
  by_cases ie : i=old.length
  · have se : shift cut replacement i = fresh.length := by
      have gt : cut < i := by omega
      simp [shift,show ¬i < cut by omega,show i≠cut by omega] <;> omega
    rw [if_pos ie,if_pos se]
  · have se : shift cut replacement i ≠ fresh.length := by
      simp only [shift]
      split_ifs <;> omega
    rw [if_neg ie,if_neg se]

theorem foldAgree (cut replacement : Nat) (post : List Gate) (old fresh : List Bool)
    (size : old.length=fresh.length+1) (room : cut ≤ fresh.length)
    (valid : replacement < cut ∨ fresh.length+post.length ≤ replacement)
    (agree : ∀ i, old.getD i false = fresh.getD (shift cut replacement i) false) :
    ∀ i, (post.foldl step old).getD i false =
      ((post.map (change cut replacement)).foldl step fresh).getD (shift cut replacement i) false := by
  induction post generalizing old fresh with
  | nil => exact agree
  | cons g post ih =>
    have v : value old g = value fresh (change cut replacement g) := by
      unfold value change
      simp only [List.map_map]
      congr 1
      exact List.map_congr_left (fun i _ => agree i)
    simp only [List.map_cons,List.foldl_cons]
    apply ih
    · simp [step,size]
    · simp [step] <;> omega
    · simp [step,List.length_cons] at * <;> omega
    · intro i
      change (old ++ [value old g]).getD i false =
        (fresh ++ [value fresh (change cut replacement g)]).getD _ false
      rw [←v]
      apply extendRead old fresh cut replacement size room _ agree
      simp only [List.length_cons] at valid
      omega

theorem evalBypass (n : Nat) (pre post : List Gate) (o replacement : Nat)
    (valid : replacement < n+pre.length ∨ n+pre.length+post.length ≤ replacement)
    (x : Fin n → Bool) :
    (bypass n pre post o replacement).eval (List.ofFn x) =
      (let w := pre.foldl step (List.ofFn x);
       post.foldl step (w ++ [w.getD replacement false])).getD o false := by
  let w := pre.foldl step (List.ofFn x)
  have len : w.length = n+pre.length := by simp [w,foldLength]
  rw [m1892_eval_eq]
  change ((pre ++ post.map (change (n+pre.length) replacement)).foldl step _).getD _ false = _
  rw [List.foldl_append]
  change ((post.map (change (n+pre.length) replacement)).foldl step w).getD _ false = _
  symm
  apply foldAgree (n+pre.length) replacement post (w++[w.getD replacement false]) w
  · simp
  · omega
  · omega
  · intro i
    rw [m1892_getD_snoc]
    by_cases lt : i < w.length
    · simp [shift,←len,lt,show i≠w.length by omega]
    by_cases eq : i=w.length
    · simp [shift,←len,lt,eq]
    · have h1 : w.length ≤ i := by omega
      have h2 : w.length ≤ i-1 := by omega
      simp [shift,←len,lt,eq,List.getD_eq_getElem?_getD,List.getElem?_eq_none h1,
        List.getElem?_eq_none h2]

theorem short (n : Nat) (pre post : List Gate) (o r : Nat) (g : Gate) :
    (bypass n pre post o r).size+1=(Circuit.mk (pre++g::post) o).size := by
  simp [bypass,Circuit.size] <;> omega


def forcedOut (pre post : List Gate) (o : Nat) (x : Input) (b : Bool) : Bool :=
  (post.foldl step (prefixW pre x ++ [b])).getD o false

theorem forced_le (pre post : List Gate) (hp : binaryBasis pre) (hq : binaryBasis post)
    (o : Nat) {x y : Input} (hxy : x ≤ y) {a b : Bool} (hab : a ≤ b) :
    forcedOut pre post o x a ≤ forcedOut pre post o y b := by
  exact getD_le (fold_le post hq _ _ (List.rel_append (prefix_le pre hp hxy)
    (List.Forall₂.cons hab List.Forall₂.nil))) o

theorem bounded_forced (pre post : List Gate) (hp : binaryBasis pre) (hq : binaryBasis post)
    (s o : Nat) (good : ∀ x : Input, (cutCircuit pre s post o).eval (List.ofFn x) = target x)
    (x : Input) : forcedOut pre post o x false ≤ target x ∧ target x ≤ forcedOut pre post o x true := by
  rw [←good x,cut_eval]
  exact ⟨forced_le pre post hp hq o (x := x) le_rfl (Bool.false_le _),
    forced_le pre post hp hq o (x := x) le_rfl (Bool.le_true _)⟩

/-- Replacing the paid NOT by a prefix wire is exact precisely when that wire
accepts every missing edge and rejects every excess maximal independent input. -/
theorem exact_bypass_iff (pre post : List Gate) (hp : binaryBasis pre) (hq : binaryBasis post)
    (s o r : Nat) (earlier : r < 41+pre.length)
    (good : ∀ x : Input, (cutCircuit pre s post o).eval (List.ofFn x) = target x) :
    (∀ x : Input, (bypass 41 pre post o r).eval (List.ofFn x) = target x) ↔
    (∀ e ∈ positives, forcedOut pre post o e false = false → cutValue pre r e = true) ∧
    (∀ i ∈ negativeMax (fun x => target x = true),
      forcedOut pre post o i true = true → cutValue pre r i = false) := by
  have actual (x : Input) : (bypass 41 pre post o r).eval (List.ofFn x) =
      forcedOut pre post o x (cutValue pre r x) :=
    evalBypass 41 pre post o r (Or.inl earlier) x
  have mono {x y : Input} (h : x ≤ y) : forcedOut pre post o x (cutValue pre r x) ≤
      forcedOut pre post o y (cutValue pre r y) :=
    forced_le pre post hp hq o h (getD_le (prefix_le pre hp h) r)
  have ep (e : Input) (he : e ∈ positives) : target e = true :=
    (generated_target e).2 ⟨e,he,le_rfl⟩
  have ip (i : Input) (hi : i ∈ negativeMax (fun x => target x = true)) : target i = false := by
    have hn := (maxima_cover (fun x => target x = true)).1 i hi
    cases h : target i <;> simp_all
  constructor
  · intro correct
    constructor
    · intro e he low
      have h := (actual e).symm.trans ((correct e).trans (ep e he))
      cases hr : cutValue pre r e <;> simp_all
    · intro i hi high
      have h := (actual i).symm.trans ((correct i).trans (ip i hi))
      cases hr : cutValue pre r i <;> simp_all
  · rintro ⟨hit,avoid⟩ x
    rw [actual, Bool.eq_iff_iff]
    constructor
    · intro hx
      by_contra no
      obtain ⟨i,hi,hxi⟩ := (maxima_cover (fun y => target y = true)).2 x no
      have atI := (bool_le.mp (mono hxi)) hx
      have high := (bool_le.mp (forced_le pre post hp hq o (x:=i) le_rfl (Bool.le_true _))) atI
      rw [avoid i hi high] at atI
      exact (Bool.false_ne_true (by
        rw [← ip i hi]
        exact (bool_le.mp (bounded_forced pre post hp hq s o good i).1) atI))
    · intro yes
      obtain ⟨e,he,hex⟩ := (generated_target x).1 yes
      apply bool_le.mp (mono hex)
      cases low : forcedOut pre post o e false with
      | false =>
        rw [hit e he low]
        exact (bool_le.mp (bounded_forced pre post hp hq s o good e).2) (ep e he)
      | true =>
        exact (bool_le.mp (forced_le pre post hp hq o (x:=e) le_rfl (Bool.false_le _))) low

theorem one_gate_saved (pre post : List Gate) (s o r : Nat) :
    (bypass 41 pre post o r).size + 1 = (cutCircuit pre s post o).size :=
  short 41 pre post o r ⟨GateOp.not,[s]⟩

end SignedReplacement9764

    change _+_+H.card≤_ at expense
    omega
  · have thr := k4_three_cons hG live correct ports ha hb ab ac bc ua ub uc
    have expense := exp {u}
    rw [Finset.card_singleton] at expense
    change _+_+H.card≤_ at expense

theorem factor : F=(X-C 1)^17*Q := by
  have n6 : (C (6:ℝ) : ℝ[X])=6 := Polynomial.C_eq_natCast 6
  have n10 : (C (10:ℝ) : ℝ[X])=10 := Polynomial.C_eq_natCast 10
  have n15 : (C (15:ℝ) : ℝ[X])=15 := Polynomial.C_eq_natCast 15
  have n17 : (C (17:ℝ) : ℝ[X])=17 := Polynomial.C_eq_natCast 17
  have n18 : (C (18:ℝ) : ℝ[X])=18 := Polynomial.C_eq_natCast 18
  simp [F,Q,f0,f1,f2,four,n6,n10,n15,n17,n18] <;> ring

theorem value : Q.eval 1 = (-137507252650516686093750000000 : ℝ) := by norm_num [Q]

theorem checked : F≠0 ∧ rootMultiplicity 1 F=17 := by
  classical
  have unit : ¬Q.IsRoot 1 := by change Q.eval 1≠0; rw [value]; norm_num
  have qnz : Q≠0 := fun z => unit (by simp [z])
  have px : (X-C (1:ℝ))≠0 := X_sub_C_ne_zero 1
  have stage (n : ℕ) : rootMultiplicity (1:ℝ) ((X-C 1)^n)=n := by
    induction n with
    | zero => simp [rootMultiplicity_eq_zero]
    | succ n ih =>
      rw [pow_succ,rootMultiplicity_mul (mul_ne_zero (pow_ne_zero n px) px),ih,rootMultiplicity_X_sub_C]
      simp
  have nonz := mul_ne_zero (pow_ne_zero 17 px) qnz
  rw [factor]
  exact ⟨nonz,by rw [rootMultiplicity_mul nonz,stage,rootMultiplicity_eq_zero unit,Nat.add_zero]⟩

theorem example17 :
    ∃ (s : Fin 3 → ℝ) (g : Fin 3 → ℝ[X]),
      (∀ i,s i=1 ∨ s i= -1) ∧ (∀i,(g i).support.card≤4) ∧
      (∑i,C (s i)*g i^3)≠0 ∧ rootMultiplicity 1 (∑i,C (s i)*g i^3)=17 := by
  have cube (w : ℝ) (hw : 0≤w) : ∃r:ℝ,r^3=w := by
    refine ⟨w ^ ((1:ℝ)/3),?_⟩
    rw [← Real.rpow_natCast,← Real.rpow_mul hw]
    norm_num
  obtain ⟨r0,hr0⟩ := cube 17971276855468750 (by norm_num)
  obtain ⟨r1,hr1⟩ := cube 376776123046875 (by norm_num)
  obtain ⟨r2,hr2⟩ := cube 446497421087421 (by norm_num)
  let s : Fin 3 → ℝ := ![1,-1,1]
  let g : Fin 3 → ℝ[X] := ![C r0*f0,C r1*f1,C r2*f2]
  refine ⟨s,g,?_,?_,?_⟩
  · intro i
    fin_cases i <;> simp [s]
  · intro i
    fin_cases i <;> apply sparse
  · have same : (∑i,C (s i)*g i^3)=F := by
      have n376776123046875 : (C (376776123046875:ℝ) : ℝ[X])=376776123046875 := Polynomial.C_eq_natCast 376776123046875
      have n446497421087421 : (C (446497421087421:ℝ) : ℝ[X])=446497421087421 := Polynomial.C_eq_natCast 446497421087421
      have n17971276855468750 : (C (17971276855468750:ℝ) : ℝ[X])=17971276855468750 := Polynomial.C_eq_natCast 17971276855468750
      simp [Fin.sum_univ_three,s,g,F,mul_pow,←map_pow,hr0,hr1,hr2,n376776123046875,n446497421087421,n17971276855468750] <;> ring
    rw [same]
    exact checked
end

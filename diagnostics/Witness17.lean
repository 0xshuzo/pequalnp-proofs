def four (a b c d : ℕ) (α β γ δ : ℝ) : ℝ[X] :=
  C α*X^a+C β*X^b+C γ*X^c+C δ*X^d
theorem sparse (r : ℝ) (a b c d : ℕ) (α β γ δ : ℝ) :
    (C r*four a b c d α β γ δ).support.card≤4 := by
  classical
  let S : Finset ℕ := {a,b,c,d}
  have sub : (C r*four a b c d α β γ δ).support⊆S := by
    intro k hk
    by_contra nn
    have ne : k≠a ∧ k≠b ∧ k≠c ∧ k≠d := by simpa [S] using nn
    have h := Polynomial.mem_support_iff.mp hk
    apply h
    rw [coeff_C_mul]
    simp [four,coeff_add,coeff_C_mul_X_pow,ne.1,ne.2.1,ne.2.2.1,ne.2.2.2]
  have ca := Finset.card_insert_le a ({b,c,d}:Finset ℕ)
  have cb := Finset.card_insert_le b ({c,d}:Finset ℕ)
  have cc := Finset.card_insert_le c ({d}:Finset ℕ)
  have sm := Finset.card_le_card sub
  change _≤(insert a (insert b (insert c {d})):Finset ℕ).card at sm
  simp only [Finset.card_singleton] at cc
  omega

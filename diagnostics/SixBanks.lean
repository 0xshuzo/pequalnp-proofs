def shape : List Nat := [3,12,21,26,38,41,48]
def hit (p l : Nat) : Bool := edges.contains (p,l)
def mask (ls : List Nat) (p : Nat) : Nat :=
  (ls.zipIdx).foldl (fun n e => if hit p e.1 then n + 2^e.2 else n) 0
def joined (ls ps : List Nat) : Bool := (List.range 12).all fun j =>
  let l := j+13
  ls.contains l || ((List.range 7).all fun i =>
    (List.range 7).all fun k =>
      !(i<k && hit (ps.getD i 25) l && hit (ps.getD k 25) l) ||
      ([0,1,6] : List Nat).contains i && ([0,1,6] : List Nat).contains k)
def key (xs : List Nat) : Nat := xs.foldl (fun n x => n+2^x) 0
def valid (w : List Nat × List Nat) : Bool :=
  let ls := w.1
  let ps := w.2
  ls.length==6 && ls.eraseDups.length==6 && ls.all (fun l => 13 ≤ l && l < 25) &&
  ps.length==7 && ps.eraseDups.length==7 && ps.all (fun p => p<13) &&
  ps.map (mask ls) == shape && joined ls ps &&
  (List.range 13).all (fun p => ps.contains p || (ls.filter (hit p)).length == 1)
theorem count : witnesses.length = 126 := by decide +kernel
theorem distinct : (witnesses.map (fun w => key w.1)).eraseDups.length = 126 := by decide +kernel
theorem checked : witnesses.all valid = true := by decide +kernel
theorem geometry {w : List Nat × List Nat} (h : w ∈ witnesses) : valid w = true :=
  (List.all_eq_true.mp checked) w h

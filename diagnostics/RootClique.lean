def edge (a b : Nat) : Bool := (neighborBits[a]!).testBit b
def clique (S : Finset Nat) := ∀ x ∈ S, ∀ y ∈ S, x ≠ y → edge x y = true
def bound (L : List Nat) (k : Nat) := ∀ S : Finset Nat, (∀ x ∈ S, x ∈ L) → clique S → S.card ≤ k
def indep (L : List Nat) : Bool := L.all fun x => L.all fun y => (x == y) || !(edge x y)
def subsetC (L C : List Nat) : Bool := L.all fun x => C.contains x

theorem leaf (L : List Nat) (bins : List (List Nat)) (k : Nat) (h : subsetC L bins.flatten = true)
    (ind : bins.all indep = true) (size : bins.length ≤ k) : bound L k := by
  classical
  intro S sub ok
  let A (i : Fin bins.length) := S.filter fun x => x ∈ bins.get i
  have cover : S ⊆ univ.biUnion A := by
    intro x hx
    have hflat : x ∈ bins.flatten := by
      have v := List.all_eq_true.mp h x (sub x hx)
      simpa using v
    obtain ⟨b,hb,hx'⟩ := List.mem_flatten.mp hflat
    obtain ⟨i, rfl⟩ := List.mem_iff_get.mp hb
    exact mem_biUnion.mpr ⟨i, mem_univ _, mem_filter.mpr ⟨hx,hx'⟩⟩
  have one (i : Fin bins.length) : (A i).card ≤ 1 := by
    apply Finset.card_le_one.mpr
    intro x hx y hy
    obtain ⟨sx,bx⟩ := mem_filter.mp hx
    obtain ⟨sy,byy⟩ := mem_filter.mp hy
    by_contra neq
    have p := List.all_eq_true.mp ind (bins.get i) (List.get_mem bins i)
    have q := List.all_eq_true.mp (List.all_eq_true.mp p x bx) y byy
    simp [neq, ok x sx y sy neq] at q
  have count := Finset.card_biUnion_le (s := (univ : Finset (Fin bins.length))) (t := A)
  have total := sum_le_sum fun i (_ : i ∈ (univ : Finset (Fin bins.length))) => one i
  simp only [sum_const, card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.mul_one] at total
  exact (card_le_card cover).trans (count.trans (total.trans size))

theorem trim (L V : List Nat) (k : Nat) (h : subsetC L V = true) (b : bound V k) : bound L k := by
  intro S hs
  apply b S
  intro x hx
  have q := List.all_eq_true.mp h x (hs x hx)
  simpa using q

theorem branch (L P T : List Nat) (k : Nat) (h : subsetC L (P++T) = true)
    (tail : bound T (k+1)) (kids : ∀ x ∈ P, bound (L.filter (fun y => edge x y && !(y == x))) k) :
    bound L (k+1) := by
  classical
  intro S hs ok
  by_cases ex : ∃ x ∈ S, x ∈ P
  · obtain ⟨x,hx,hp⟩ := ex
    have child := kids x hp (S.erase x)
    have sub : ∀ y ∈ S.erase x, y ∈ L.filter (fun y => edge x y && !(y == x)) := by
      intro y hy
      obtain ⟨ne,sy⟩ := mem_erase.mp hy
      exact List.mem_filter.mpr ⟨hs y sy, by simp [ok x hx y sy (Ne.symm ne),ne]⟩
    have legal : clique (S.erase x) :=
      fun a ha b hb ne => ok a (mem_of_mem_erase ha) b (mem_of_mem_erase hb) ne
    have ct := child sub legal
    have e := Finset.card_erase_add_one hx
    omega
  · apply tail S _ ok
    intro x hx
    have q := List.all_eq_true.mp h x (hs x hx)
    have z : x ∈ P ++ T := by simpa using q
    exact (List.mem_append.mp z).resolve_left (fun p => ex ⟨x,hx,p⟩)


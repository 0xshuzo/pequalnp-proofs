theorem uniqueCircuit (C : Circuit) (hf : FanInTwo C) (hs : C.size ≤ 9)
    (hr : ∀ i j : Fin 6, C.eval (pairInput i j) =
      (6524607 : ℕ).testBit (6 * min i.val j.val + max i.val j.val)) :
    ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = reference x := by
  let f : BFn 6 := fun x => C.eval (List.ofFn x)
  have he (p : Fin 6 × Fin 6) : f (pt 6 (pairCode p)) = reference (pt 6 (pairCode p)) := by
    obtain ⟨i,j⟩ := p
    change C.eval (List.ofFn (pt 6 (pairCode (i,j)))) = _
    rw [codeInputs, graphRow]
    exact hr i j
  have encode : encL f points = Y_ := by
    calc
      encL f points = encL reference points := by
        apply enc_congr_rows
        intro v hv
        obtain ⟨p,_,rfl⟩ := List.mem_map.mp hv
        exact he p
      _ = Y_ := by decide +kernel
  have hn : ∃ x y : Fin 6 → Bool, f x ≠ f y := by
    refine ⟨pt 6 (pairCode (0,0)),pt 6 (pairCode (1,2)),?_⟩
    rw [he (0,0),he (1,2)]
    decide +kernel
  have hz : clip (encL f fullPoints) = Y_ := (clip_full f points pointBound).trans encode
  obtain ⟨s,hs',ws,hsub,hrun⟩ := exists_run f hn 9 ⟨C,hf,hs,fun _ => rfl⟩
  have hfull : NatRun FMask (encL f fullPoints) s (ws.map (fun a => encL a fullPoints)) :=
    Run.map (fun a : BFn 6 => encL a fullPoints)
      (fun a => by rw [show FMask = 2 ^ fullPoints.length - 1 by decide +kernel]; exact encL_inv a fullPoints)
      (fun a b => encL_and a b fullPoints) (fun a b => encL_or a b fullPoints) hrun
  have hsub' : (ws.map (fun a => encL a fullPoints)).Sublist rawFull := hsub.map _
  have hforce : encL f fullPoints = expected := by
    cases hw : ws.map (fun a => encL a fullPoints) with
    | nil => rw [hw] at hfull; exact (run_nil hfull).elim
    | cons a as =>
      rw [hw] at hfull hsub'
      have h9 := extend_run hfull hs'
      have hroot := List.all_eq_true.mp roots _ (List.mem_sublists.2 hsub')
      have vp := via_sound pchecks (transfer h9 hz)
      change (!via Y_ PD_ PM_ 9 (smaller (a::as)) || Winning_.mem (9 :: isort (a::as))) = true at hroot
      rw [vp] at hroot
      exact forced hz 9 _ h9 (by simpa using hroot)
  rw [← referenceFull] at hforce

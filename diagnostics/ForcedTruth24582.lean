theorem indexBit (f : BFn 6) (i : Nat) (hi : i < 64) :
    (encL f fullPoints).testBit i = f (pt 6 i) := by
  rw [encL_testBit, List.getD_eq_getElem _ _ (by simp [fullPoints,hi])]
  simp [fullPoints]

theorem clip_full (f : BFn 6) (l : List Nat) (small : ∀ j ∈ l, j < 64) :
    actL l (encL f fullPoints) = encL f l := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    simp only [actL, encL]
    rw [indexBit f a (small a (by simp)), ih (fun j hj => small j (by simp [hj]))]

theorem pointBound : ∀ j ∈ points, j < 64 := by decide +kernel
theorem referenceFull : encL reference fullPoints = expected := by decide +kernel
theorem allPoints : ∀ x : Fin 6 → Bool, ∃ i : Fin 64, pt 6 i.val = x := by decide +kernel

set_option maxRecDepth 100000 in

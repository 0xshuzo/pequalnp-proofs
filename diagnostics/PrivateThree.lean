def v (a : Nat) : V := ⟨a % 31, Nat.mod_lt _ (by decide)⟩
def decode (a : Nat) : Cell := (v (a / 31), v a)
def entry (p l : V) := (rows[p.val]!).testBit l.val
def hit (t : I) (a : Cell) := (rs[t.val]!).testBit a.1.val && (cs[t.val]!).testBit a.2.val
def tag (a : Cell) := singles[31*a.1.val+a.2.val]!
def holds (b : Box) (a : Cell) := a.1 ∈ b.1 ∧ a.2 ∈ b.2
def lawful (b : Box) := ∀ p ∈ b.1, ∀ l ∈ b.2, entry p l = false
def clash (a b : Cell) := entry a.1 b.2 = true ∨ entry b.1 a.2 = true
def witness (i j k : I) (a : Fin 3) :=
  let n := k.val*(k.val-1)*(k.val-2)/6 + j.val*(j.val-1)/2+i.val
  decode ((tbl[n]! >>> (10*a.val)) % 1024)
def select (i j k : I) (a : Fin 3) : I :=
  if a.val = 0 then i else if a.val = 1 then j else k
def test (i j k : I) : Bool :=
  if i < j ∧ j < k then
    (List.finRange 3).all (fun a =>
      let w := witness i j k a
      tag w == (select i j k a).val + 1 &&
      (List.finRange 3).all (fun b => a == b ||
        (entry w.1 (witness i j k b).2 || entry (witness i j k b).1 w.2)))
  else true
set_option maxRecDepth 5000 in
theorem privateNode : ∀ p l : V, tag (p,l) ≠ 0 → entry p l = false := by decide +kernel

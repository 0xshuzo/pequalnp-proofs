theorem threeNew (i j k : I) (ij : i < j) (jk : j < k) (keep : I → Prop)
    (lost : ¬ keep i ∧ ¬ keep j ∧ ¬ keep k)
    (m : Nat) (extra : Fin m → Box) (legal : ∀ t, lawful (extra t))
    (cover : ∀ z : Cell, entry z.1 z.2 = false →
      (∃ t, keep t ∧ hit t z = true) ∨ ∃ t, holds (extra t) z) : 3 ≤ m := by
  classical
  have good := census i j k
  simp only [test, if_pos ⟨ij,jk⟩, List.all_eq_true] at good
  have law (a : Fin 3) := good a (by simp)
  have tags (a : Fin 3) : tag (witness i j k a) = (select i j k a).val + 1 := by
    have ha := law a
    simpa using (Bool.and_eq_true_iff.mp ha).1
  have absent (a : Fin 3) : ¬ keep (select i j k a) := by
    fin_cases a <;> simp [select,lost.1,lost.2.1,lost.2.2]
  let W := witness i j k
  have chosen (a : Fin 3) : ∃ t, holds (extra t) (W a) := by
    have pos : tag (W a) ≠ 0 := by rw [show tag (W a) = _ from tags a]; omega
    have empty := privateNode (W a).1 (W a).2 pos
    rcases cover (W a) empty with ⟨d,kd,hd⟩ | e
    · have h := privateOwner (W a).1 (W a).2 d pos hd
      have e : select i j k a = d := Fin.ext (by have := tags a; dsimp [W] at h; omega)
      exact False.elim (absent a (e.symm ▸ kd))
    · exact e
  let f (a : Fin 3) : Fin m := Classical.choose (chosen a)
  have chosen' (a : Fin 3) : holds (extra (f a)) (W a) := Classical.choose_spec (chosen a)
  have inj : Function.Injective f := by
    intro a b eq
    by_contra ne
    have ha := (Bool.and_eq_true_iff.mp (law a)).2
    have hb := List.all_eq_true.mp ha b (by simp)
    have cross : entry (W a).1 (W b).2 = true ∨ entry (W b).1 (W a).2 = true := by
      simpa [W,ne] using hb
    have av := chosen' a
    have bv : holds (extra (f a)) (W b) := eq.symm ▸ chosen' b
    have n1 := legal (f a) _ av.1 _ bv.2
    have n2 := legal (f a) _ bv.1 _ av.2
    rcases cross with h | h <;> simp_all
  simpa using Fintype.card_le_of_injective f inj
end PEqualNP.Outside.L_meta_10009.Private

def root : Ix := 234
def leaf : Ix := 4

def graph (i : Ix) := (states[i.val]!).1
def depth (i : Ix) := (states[i.val]!).2
def cell (x : X) := 5*x.1.val+x.2.val
def on (g : Nat) (v : X) : Bool := g.testBit (cell v)
def active (g : Nat) (r : Fin 6) : Bool := ((g / 2^(5*r.val))%32) != 0
def row (g : Nat) (r : Fin 6) : Clause X :=
  (Finset.univ.filter (fun h : Fin 5 => on g (r,h))).image (fun h : Fin 5 => ((r,h),true))
def col (a b : Fin 6) (j : Fin 5) : Clause X := {((a,j),false),((b,j),false)}
def Raw (g : Nat) : Set (Clause X) := {d |
 (∃ r : Fin 6, active g r ∧ d=row g r) ∨
 (∃ (a b : Fin 6) (j : Fin 5), a≠b ∧ on g (a,j) ∧ on g (b,j) ∧ d=col a b j)}
def entry (i : Ix) (v : X) := (edges[i.val]!)[5*v.1.val+v.2.val]!
def dest (i : Ix) (v : X) : Ix :=
 ⟨(entry i v).1 % _,Nat.mod_lt _ (by decide)⟩
def readIndex {n : Nat} [NeZero n] (s : Nat) (x : Fin n) : Fin n :=
 ⟨((s / 2^(3*x.val))%8)%n,Nat.mod_lt _ (NeZero.pos n)⟩
def rf (i : Ix) (v : X) : Fin 6 → Fin 6 := readIndex (entry i v).2.2.1
def cf (i : Ix) (v : X) : Fin 5 → Fin 5 := readIndex (entry i v).2.2.2
def rename (i : Ix) (v y : X) : X := (rf i v y.1,cf i v y.2)
def assign (i : Ix) (v y : X) : Option Bool :=
 if on (entry i v).2.1 y then some true
 else if on (graph (dest i v)) (rename i v y) then none else some false
def sat (s : Val X) (c : Clause X) : Bool := decide (∃ (r : Fin 6) (h : Fin 5) (b : Bool), ((r,h),b)∈c ∧ s (r,h)=some b)
theorem sat_iff (s : Val X) (c : Clause X) : sat s c = true ↔ satisfied s c := by
 simp only [sat,decide_eq_true_eq]
 constructor
 · rintro ⟨r,h,b,m,e⟩
   exact ⟨((r,h),b),m,e⟩
 · rintro ⟨⟨⟨r,h⟩,b⟩,m,e⟩
   exact ⟨r,h,b,m,e⟩
def guardedRow (i : Ix) (v : X) (r : Fin 6) : Prop :=
 let g:=graph i; let h:=graph (dest i v); let s:=assign i v; let d:=row g r
 active g r = true → sat s d = true ∨
   (active h (rf i v r)=true ∧ push (rename i v) (residue s d)=row h (rf i v r))
def guardedPair (i : Ix) (v : X) (a b : Fin 6) (j : Fin 5) : Prop :=
 let g:=graph i; let h:=graph (dest i v); let s:=assign i v; let d:=col a b j
 a≠b → on g (a,j)=true → on g (b,j)=true → sat s d=true ∨
  (rf i v a≠rf i v b ∧ on h (rf i v a, cf i v j)=true ∧ on h (rf i v b,cf i v j)=true ∧
   push (rename i v) (residue s d)=col (rf i v a) (rf i v b) (cf i v j))
def Check (i : Ix) (v : X) : Prop :=
 depth i≤2 ∨ i=leaf ∨
 (assign i v v≠none ∧ depth i≤depth (dest i v)+1 ∧
  (∀ r, guardedRow i v r) ∧ (∀ a b j, guardedPair i v a b j))
set_option synthInstance.maxSize 4096
set_option maxRecDepth 10000
set_option maxHeartbeats 0
local instance (i : Ix) (v : X) (r : Fin 6) : Decidable (guardedRow i v r) := by unfold guardedRow; infer_instance
local instance (i : Ix) (v : X) (a b : Fin 6) (j : Fin 5) : Decidable (guardedPair i v a b j) := by unfold guardedPair; infer_instance
local instance (i : Ix) (v : X) : Decidable (Check i v) := by unfold Check; infer_instance
def markCol (i : Ix) (v : X) (j : Fin 5) : Bool :=
  ((entry i v).2.1 &&& (34636833 <<< j.val)) != 0
def owner (i : Ix) (v : X) (j : Fin 5) : Nat :=
  Nat.log2 ((entry i v).2.1 &&& (34636833 <<< j.val)) / 5
def Cheap (i : Ix) (v : X) : Prop :=
 depth i≤2 ∨ i=leaf ∨
 (assign i v v≠none ∧ depth i≤depth (dest i v)+1 ∧
  (∀ a b, rf i v a=rf i v b → a=b) ∧
  (∀ j : Fin 5, ∃ l, cf i v l=j) ∧
  (∀ r : Fin 6, active (graph i) r=true →
    (∃ j : Fin 5, on (graph i) (r,j)=true ∧ assign i v (r,j)=some true) ∨
     active (graph (dest i v)) (rf i v r)=true) ∧
  (∀ (r : Fin 6) (j : Fin 5), on (graph (dest i v)) (rename i v (r,j))=true →
      on (graph i) (r,j)=true ∧ assign i v (r,j)=none) ∧
  (∀ (r : Fin 6) (j : Fin 5), assign i v (r,j)≠some false →
    if markCol i v j then r.val=owner i v j else assign i v (r,j)=none))
local instance (i : Ix) (v : X) : Decidable (Cheap i v) := by unfold Cheap; infer_instance

theorem row_mem (g : Nat) (r a : Fin 6) (j : Fin 5) (b : Bool) :
    (((a,j),b) : Literal X) ∈ row g r ↔ a=r ∧ b=true ∧ on g (r,j)=true := by
  constructor
  · intro h
    obtain ⟨l,hl,eq⟩ := Finset.mem_image.mp h
    cases eq
    exact ⟨rfl,rfl,(Finset.mem_filter.mp hl).2⟩
  · rintro ⟨rfl,rfl,h⟩
    exact Finset.mem_image.mpr ⟨j,Finset.mem_filter.mpr ⟨by simp,h⟩,rfl⟩

theorem free_on (i : Ix) (v y : X) (h : assign i v y=none) :
    on (graph (dest i v)) (rename i v y)=true := by
  unfold assign at h
  split at h
  · contradiction
  · split at h
    · assumption
    · contradiction

theorem cheap_to_full {i : Ix} {v : X} (cert : Cheap i v) : Check i v := by
  rcases cert with small|atleaf|⟨fixed,delta,inj,onto,rows,free,cols⟩
  · exact Or.inl small
  · exact Or.inr (Or.inl atleaf)
  refine Or.inr (Or.inr ⟨fixed,delta,?_,?_⟩)
  · intro r activeR
    rcases rows r activeR with ⟨j,hj,sj⟩|act
    · exact Or.inl ((sat_iff _ _).2 ⟨((r,j),true),(row_mem _ _ _ _ _).2 ⟨rfl,rfl,hj⟩,sj⟩)
    refine Or.inr ⟨act,?_⟩
    ext z
    rcases z with ⟨⟨p,j⟩,b⟩
    constructor
    · intro hz
      obtain ⟨⟨⟨u,l⟩,d⟩,mem,eq⟩ := Finset.mem_image.mp hz
      obtain ⟨mm,ss⟩ := Finset.mem_filter.mp mem
      obtain ⟨eqr,eqd,onU⟩ := (row_mem _ _ _ _ _).1 mm
      subst u
      subst d
      change (((rf i v r,cf i v l),true) : Literal X) = ((p,j),b) at eq
      cases eq
      exact (row_mem _ _ _ _ _).2 ⟨rfl,rfl,free_on i v (r,l) ss⟩
    · intro hz
      obtain ⟨eqr,eqb,hit⟩ := (row_mem _ _ _ _ _).1 hz
      subst p
      subst b
      obtain ⟨l,hl⟩ := onto j
      subst j
      obtain ⟨old,ss⟩ := free r l hit
      exact Finset.mem_image.mpr ⟨((r,l),true),Finset.mem_filter.mpr
        ⟨(row_mem _ _ _ _ _).2 ⟨rfl,rfl,old⟩,ss⟩,rfl⟩
  · intro a b j ne oa ob
    by_cases na : assign i v (a,j)=some false
    · exact Or.inl ((sat_iff _ _).2 ⟨((a,j),false),by simp [col],na⟩)
    by_cases nb : assign i v (b,j)=some false
    · exact Or.inl ((sat_iff _ _).2 ⟨((b,j),false),by simp [col],nb⟩)
    have aa := cols a j na
    have bb := cols b j nb
    cases mk : markCol i v j with
    | true =>
      simp only [mk,↓reduceIte] at aa bb
      exact (ne (Fin.ext (aa.trans bb.symm))).elim
    | false =>
      simp only [mk,↓reduceIte] at aa bb

    obtain ⟨a,ha,b,hb,eq⟩ := hw
    have ne := h.2 a ha b hb
    rcases eq with rfl | rfl
    · exact yes.elim ne.1 (fun x => x.elim ne.2.1 outside)
    · exact yes.elim ne.2.2.1 (fun x => x.elim ne.2.2.2 outside)

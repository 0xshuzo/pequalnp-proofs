  have hel : ∀ x : Fin 12, x ∉ ({0, 2, 6, 8} : Finset (Fin 12)) → x ∉ ineligSet 12 D :=
    fun x hx => hI ▸ hx
  
  have hnot22 : ∀ z k v iz ik : Fin 12,
      (iz ∈ ({0, 2, 6, 8} : Finset (Fin 12)) ∧ ik ∈ ({0, 2, 6, 8} : Finset (Fin 12)) ∧
       z ∉ ({0, 2, 6, 8} : Finset (Fin 12)) ∧ k ∉ ({0, 2, 6, 8} : Finset (Fin 12)) ∧

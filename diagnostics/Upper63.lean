def terms := (C.gates.foldl tstep T0).getD C.output []
def literalTerms : List (List Nat) := [[13, 1], [13, 3], [13, 9], [14, 1], [14, 2], [14, 4], [14, 10], [15, 2], [15, 3], [15, 5], [15, 11], [16, 3], [16, 4], [16, 6], [16, 12], [17, 0], [17, 4], [17, 5], [17, 7], [18, 1], [18, 5], [18, 6], [18, 8], [19, 2], [19, 6], [19, 7], [19, 9], [20, 3], [20, 7], [20, 8], [20, 10], [21, 4], [21, 8], [21, 9], [21, 11], [22, 5], [22, 9], [22, 10], [22, 12], [23, 0], [23, 6], [23, 10], [23, 11], [24, 1], [24, 7], [24, 11], [24, 12], [25, 0], [25, 2], [25, 8], [25, 12]]
def edges : List (Nat × Nat) := [(0, 17), (0, 23), (0, 25), (1, 13), (1, 14), (1, 18), (1, 24), (2, 14), (2, 15), (2, 19), (2, 25), (3, 13), (3, 15), (3, 16), (3, 20), (4, 14), (4, 16), (4, 17), (4, 21), (5, 15), (5, 17), (5, 18), (5, 22), (6, 16), (6, 18), (6, 19), (6, 23), (7, 17), (7, 19), (7, 20), (7, 24), (8, 18), (8, 20), (8, 21), (8, 25), (9, 13), (9, 19), (9, 21), (9, 22), (10, 14), (10, 20), (10, 22), (10, 23), (11, 15), (11, 21), (11, 23), (11, 24), (12, 16), (12, 22), (12, 24), (12, 25)]
theorem checked : terms = literalTerms := by decide +kernel
theorem reflect (x : Fin 26 → Bool) : C.eval (List.ofFn x) = evalD (fun i => x (Fin.ofNat 26 i)) terms := by
  have ok : ∀ g∈C.gates, okb g=true := by decide +kernel
  exact (good_fold _ C.gates ok _ _ (good_init x)).2 C.output
theorem near : ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ 63 ∧ (∀ x : Fin 26 → Bool, (C.eval (List.ofFn x) = true ↔ ∃ u v : Fin 26, (u.val, v.val) ∈ ([(0, 17), (0, 23), (0, 25), (1, 13), (1, 14), (1, 18), (1, 24), (2, 14), (2, 15), (2, 19), (2, 25), (3, 13), (3, 15), (3, 16), (3, 20), (4, 14), (4, 16), (4, 17), (4, 21), (5, 15), (5, 17), (5, 18), (5, 22), (6, 16), (6, 18), (6, 19), (6, 23), (7, 17), (7, 19), (7, 20), (7, 24), (8, 18), (8, 20), (8, 21), (8, 25), (9, 13), (9, 19), (9, 21), (9, 22), (10, 14), (10, 20), (10, 22), (10, 23), (11, 15), (11, 21), (11, 23), (11, 24), (12, 16), (12, 22), (12, 24), (12, 25)] : List (ℕ × ℕ)) ∧ x u = true ∧ x v = true)) := by
  refine ⟨C,?_,by decide,?_⟩
  · intro g hg
    simp only [C,List.mem_cons,List.not_mem_nil,or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    all_goals first | exact ⟨Or.inl rfl,le_rfl⟩ | exact ⟨Or.inr rfl,le_rfl⟩
  · intro x
    change C.eval (List.ofFn x) = true ↔ ∃ a b : Fin 26, (a.val,b.val) ∈ edges ∧ x a=true ∧ x b=true
    have enc : ∀ c ∈ literalTerms, ∃ a b : Fin 26, (a.val,b.val)∈edges ∧ c=[b.val,a.val] := by decide +kernel
    have full : ∀ a b : Fin 26, (a.val,b.val)∈edges → [b.val,a.val]∈literalTerms := by decide +kernel
    have norm : ∀ i : Fin 26, Fin.ofNat 26 i.val=i := by decide +kernel
    rw [reflect,checked,evalD,List.any_eq_true]
    constructor
    · rintro ⟨c,hc,hit⟩
      obtain ⟨a,b,ab,rfl⟩ := enc c hc
      simp only [List.all_cons,List.all_nil,Bool.and_true,norm,Bool.and_eq_true] at hit
      exact ⟨a,b,ab,hit.2,hit.1⟩
    · rintro ⟨a,b,ab,ap,bp⟩
      refine ⟨_, full _ _ ab, ?_⟩
      simp only [List.all_cons,List.all_nil,Bool.and_true,norm,Bool.and_eq_true]
      exact ⟨bp,ap⟩

    simp [gateAt,encodeCircuit,List.getD_eq_getElem?_getD,List.getElem?_map,List.getElem?_eq_getElem jd]
  have mem : i=D[j].2.1 ∨ i=D[j].2.2 := by simpa [next,encodeGate] using hi
  obtain ⟨da,db,_⟩ := strict j jd
  rw [opA_eq D j jd] at da
  rw [opB_eq D j jd] at db
  exact mem.elim (fun eq => eq.symm ▸ da) (fun eq => eq.symm ▸ db)

theorem normalizedAO (C : Circuit) (hm : Monotone2 C) (correct' : ∀ x : Fin 40 → Bool,

def encodeGate (g : Bool × Nat × Nat) : Gate :=
  ⟨if g.1 then .and else .or, [g.2.1,g.2.2]⟩
def encodeCircuit (n : Nat) (D : Dag) : Circuit := ⟨D.map encodeGate,outW n D⟩
theorem encodeWires (D : Dag) (w : List Bool) :
    (D.map encodeGate).foldl (fun acc (g : Gate) =>
      acc ++ [g.op.eval (g.inputs.map (fun i => acc.getD i false))]) w = wl D w := by
  induction D generalizing w with
  | nil => rfl
  | cons g D ih =>
    obtain ⟨t,a,b⟩ := g
    simp only [List.map_cons,List.foldl_cons,wl_cons]
    rw [ih]
    cases t <;> simp [encodeGate,wstep,gop,GateOp.eval]
theorem encodeEval {n : Nat} (D : Dag) (x : Fin n → Bool) :
    (encodeCircuit n D).eval (List.ofFn x)=val D x (outW n D) := by
  exact congrArg (fun w : List Bool => w.getD (outW n D) false) (encodeWires D (List.ofFn x))
theorem encodeLegal {n : Nat} (D : Dag) : Monotone2 (encodeCircuit n D) := by
  intro g hg
  obtain ⟨⟨t,a,b⟩,_,rfl⟩ := List.mem_map.mp hg
  cases t <;> simp [encodeGate]
theorem encodeBinary {n : Nat} (D : Dag) :
    ∀ g ∈ (encodeCircuit n D).gates, g.inputs.length=2 := by
  intro g hg
  obtain ⟨⟨t,a,b⟩,_,rfl⟩ := List.mem_map.mp hg
  rfl
open PEqualNP.MetaComplexity.NestedCover PEqualNP.TopForm
theorem strictAO {n : Nat} (D : Dag) (strict : Strict n D) :

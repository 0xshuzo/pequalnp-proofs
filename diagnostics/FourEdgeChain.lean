theorem fourEdgeChain (D : Circuit) (least : IsLeastAO G D) (top : TopForm G D)
    (small : D.size≤113) (four : (Ustar G D).card=4)
    (robust : ∀ K : Finset V, IsMinCover (G.deleteEdges (↑(Ustar G D))) K → 20≤K.card) :
    ∃ a b c : Nat, junk G D={a,b} ∧ InCone 40 D a b ∧ centreless G D=∅ ∧
      readers 40 D a={b} ∧ readers 40 D b={c} ∧ orN G D \ lam G D={c} ∧
      ∀ u v : V, s(u,v)∈Ustar G D → gateVal 40 D a (pairInput u v)=true ∧
        gateVal 40 D b (pairInput u v)=true := by
  classical
  have edges : G.edgeFinset.card=95 := by decide +kernel
  have non : G.edgeFinset.Nonempty := Finset.card_pos.mp (by omega)
  have up : (Ustar G D).Nonempty := Finset.card_pos.mp (by omega)
  obtain ⟨j,_,_,_⟩ := exceptional D least top small
  obtain ⟨count,charge⟩ := PEqualNP.Outside.L_meta_1491 40 G D noFour non least top
  obtain ⟨K,hK⟩ := minCoverExists (G.deleteEdges (↑(Ustar G D)))
  have k := charge K hK
  have r := robust K hK
  have extra := (PEqualNP.Outside.L_meta_8005 40 G D least top).1 up
  rw [edges,four] at count
  have je : (junk G D).card=2 := by omega
  apply (PEqualNP.Outside.L_meta_7895 40 G D non least top je).resolve_left
  omega

def index (m : Fin 8192) : Fin 686 := Fin.ofNat 686 ((source[m.val]?).getD 0)
def entry (j : Fin 686) : Nat × Nat × Nat := (data[j.val]?).getD (0,0,0)
def setOfMask (m : Nat) : Finset V := Finset.univ.filter (fun i => m.testBit i.val=true)
def witness (m : Fin 8192) (l : H) : H :=
  Fin.ofNat 13 (Nat.log2 (m.val &&& ((adj[13+l.val]?).getD 0)))
def rowOK (m : Fin 8192) (i : H) : Bool :=
  let S := (entry (index m)).1
  let w := witness m i
  (!m.val.testBit i.val || S.testBit i.val) &&
  (S.testBit (13+i.val) || (m.val.testBit w.val && decide (G (Fin.castAdd 13 w) (Fin.natAdd 13 i))))
def combine (b : Fin 32) (r : Fin 256) : Fin 8192 := ⟨256*b.val+r.val,by omega⟩

theorem given : ∀ u v : V,G u v ↔ (u.val,v.val)∈edges ∨ (v.val,u.val)∈edges := by decide +kernel
theorem original (x : V → Bool) : sem_Edge G x ↔ ∃u v : V,(u.val,v.val)∈edges ∧ x u=true ∧ x v=true := by
  constructor
  · rintro ⟨u,v,h,hu,hv⟩
    rcases (given u v).mp h with h|h
    · exact ⟨u,v,h,hu,hv⟩
    · exact ⟨v,u,h,hv,hu⟩
  · rintro ⟨u,v,h,hu,hv⟩
    exact ⟨u,v,(given u v).mpr (Or.inl h),hu,hv⟩

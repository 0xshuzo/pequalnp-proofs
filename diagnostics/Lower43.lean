theorem panels : ∀j : Fin 686,
    (setOfMask (entry j).2.2).card + 2*(setOfMask (entry j).2.1).card≤8 ∧
    (∀ i : V,(entry j).1.testBit i.val=true →
      (entry j).2.2.testBit i.val=true ∨
      ∃ a : V, (entry j).2.1.testBit a.val=true ∧ G i a) := by decide +kernel

theorem encoded (Q : Finset H) : ∃ m : Fin 8192,∀ i : H,m.val.testBit i.val=true ↔ i∈Q := by
  induction Q using Finset.induction_on with
  | empty => exact ⟨0,by simp⟩
  | @insert i Q hi ih =>
    obtain ⟨m,hm⟩ := ih
    have bound : ∀ i : H, 2^i.val<8192 := by decide +kernel
    have hlt : m.val ||| 2^i.val < 2^13 := Nat.or_lt_two_pow (by simpa using m.isLt) (by simpa using bound i)
    refine ⟨⟨_,hlt⟩,?_⟩
    intro j
    change (m.val ||| 2^i.val).testBit j.val=true ↔ _
    rw [Nat.testBit_or,Nat.testBit_two_pow,Bool.or_eq_true,hm,Finset.mem_insert]
    simp only [decide_eq_true_eq,Fin.ext_iff]
    tauto

theorem priced (I : Finset V) (indep : ∀ i∈I,∀ j∈I,¬G i j) :
    ∃ T U : Finset V,U.card+2*T.card≤8 ∧ (∀ i∈I,i∈U ∨ ∃a∈T,G i a) := by
  let Q : Finset H := Finset.univ.filter (fun i => Fin.castAdd 13 i ∈ I)
  obtain ⟨m,hm⟩ := encoded Q
  have raw (i : H) : m.val.testBit i.val=true ↔ Fin.castAdd 13 i ∈ I := by simpa [Q] using hm i
  let v := entry (index m)
  obtain ⟨cost,reach⟩ := panels (index m)
  refine ⟨setOfMask v.2.1,setOfMask v.2.2,cost,?_⟩
  intro i hi
  have hval : v.1.testBit i.val=true := by
    by_cases lo : i.val<13
    · let a : H := ⟨i.val,lo⟩
      have e : Fin.castAdd 13 a=i := Fin.ext rfl
      have h0 := (raw a).mpr (e.symm ▸ hi)
      have h := (Bool.and_eq_true_iff.mp (checks m a)).1
      change (!m.val.testBit a.val || v.1.testBit a.val)=true at h
      simpa [h0,a] using h
    · let a : H := ⟨i.val-13,by have := i.isLt; omega⟩
      have en : 13+a.val=i.val := by change 13+(i.val-13)=i.val; omega
      have ee : Fin.natAdd 13 a=i := Fin.ext en
      obtain h|h := Bool.or_eq_true_iff.mp (Bool.and_eq_true_iff.mp (checks m a)).2
      · change v.1.testBit (13+a.val)=true at h
        rwa [en] at h
      · obtain ⟨hw,hw2⟩ := Bool.and_eq_true_iff.mp h
        exact False.elim (indep _ ((raw _).mp hw) i hi (ee ▸ of_decide_eq_true hw2))
  obtain h|⟨a,ha,adjacent⟩ := reach i hval
  · exact Or.inl (Finset.mem_filter.mpr ⟨Finset.mem_univ _,h⟩)
  · exact Or.inr ⟨a,Finset.mem_filter.mpr ⟨Finset.mem_univ _,ha⟩,adjacent⟩


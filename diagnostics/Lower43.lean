  have eqn : combine b r=m := Fin.ext (by change 256*(m.val/256)+m.val%256=m.val; omega)
  rw [←eqn]
  have chk (k : Fin 32) : ∀ u : Fin 256,∀ j : H,rowOK (combine k u) j=true := by
    fin_cases k

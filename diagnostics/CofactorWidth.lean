theorem checked : (∀ g i, row g i &&& block g = row g i) ∧
    (∀ g i j, witness g i j &&& block g = 0) ∧
    ∀ g i j, i ≠ j → f (row g i ||| witness g i j) ≠ f (row g j ||| witness g i j) := by
  decide

theorem four_input_width (g : Fin 6) :
    ¬ ∃ (enc : Fin 9 → Fin 8) (dec : Fin 8 → ℕ → Bool),
      ∀ i t, t &&& block g = 0 → f (row g i ||| t) = dec (enc i) t := by
  rintro ⟨enc,dec,works⟩
  have inj : Function.Injective enc := by
    intro i j eq
    by_contra ne
    let t := witness g i j
    have ht : t &&& block g = 0 := checked.2.1 g i j
    exact checked.2.2 g i j ne ((works i t ht).trans ((congrArg (fun a => dec a t) eq).trans
      (works j t ht).symm))
  have impossible := Fintype.card_le_of_injective enc inj
  simp at impossible

end Width4727

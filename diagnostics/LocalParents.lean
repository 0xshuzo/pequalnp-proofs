def bits (k a b : Nat) := match k with
  | 0 => a &&& b
  | 1 => a ||| b
  | 2 => a ^^^ (a &&& b)
  | _ => b ^^^ (a &&& b)
def creates (t a b : Nat) : Bool := t != a && t != b && (List.range 4).any (fun k => bits k a b == t)
def comes (pool : List Nat) (p : Pair) (a b : Nat) : Bool :=
  !(pool.contains p.1) && !(pool.contains p.2) && (p.1==a || p.1==b) && (p.2==a || p.2==b)
def explains (pool : List Nat) (choices : List Pair) (t a b : Nat) : Bool :=
  !(creates t a b) || choices.any (fun p => comes pool p a b)
def phys (isAnd a b : Bool) := if isAnd then a && b else a || b
def shape (isAnd x y : Bool) : Nat :=
  if x=y then (if isAnd != x then 0 else 1) else
  if isAnd != x then 2 else 3
def op (k : Nat) (a b : Bool) := match k with
  | 0 => a && b
  | 1 => a || b
  | 2 => a && !b
  | _ => b && !a
theorem actual : ∀k x y a b : Bool,
    (phys k a b != phys k x y) = op (shape k x y) (a != x) (b != y) := by decide +kernel
theorem invert (a x : Bool) : ((!a) != (!x)) = (a != x) := by cases a <;> cases x <;> decide

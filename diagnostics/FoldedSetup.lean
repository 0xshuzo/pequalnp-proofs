    have no : ((keep b).map Prod.fst).contains goal=false := by
      simpa only [List.contains_eq_mem] using h.1.2
    rw [yes] at no
    contradiction
  · intro p hp
    obtain ⟨t,ht,ok⟩ := List.mem_filterMap.mp hp
    exact materialize_sound (prices t ht) ok
  · intro tag xs hx
    simp at hx

def Free : Set (Clause Board) := PHP 6 5 ∪ {c | IsRUP (PHP 6 5) c}
def Twice : Set (Clause Board) := Free ∪ {c | IsRUP Free c}
set_option maxRecDepth 20000
set_option maxHeartbeats 0
theorem cert0 : initial.all (fun p => replay input p.1 p.2) = true := by decide +kernel
theorem raw0 (d : List (Literal Board)) (hd : d∈input ++ initial.map Prod.fst) : d.toFinset∈Free := by
  rcases List.mem_append.mp hd with old|new
  · exact Or.inl (input_sound _ old)
  · obtain ⟨p,hp,eq⟩ := List.mem_map.mp new
    subst d
    apply Or.inr
    apply replay_sound input (PHP 6 5) _ input_sound p.2 p.1 _ ((List.all_eq_true.mp cert0) _ hp)
    intro l hl
    exact UPForces.hyp ⟨l,List.mem_toFinset.mpr hl,rfl⟩

theorem cert1 : second.all (fun p => replay (input ++ initial.map Prod.fst) p.1 p.2) = true := by decide +kernel
theorem raw1 (d : List (Literal Board)) (hd : d∈(input ++ initial.map Prod.fst) ++ second.map Prod.fst) :
    d.toFinset ∈ Twice := by
  rcases List.mem_append.mp hd with old|new
  · exact Or.inl (raw0 _ old)
  · obtain ⟨p,hp,eq⟩ := List.mem_map.mp new
    subst d
    apply Or.inr
    apply replay_sound (input ++ initial.map Prod.fst) Free _ raw0 p.2 p.1 _ ((List.all_eq_true.mp cert1) _ hp)
    intro l hl
    exact UPForces.hyp ⟨l,List.mem_toFinset.mpr hl,rfl⟩

theorem checks : verify ((input ++ initial.map Prod.fst) ++ second.map Prod.fst) steps = true := by decide +kernel
theorem five : ∃ cs, IsRUPRun Twice cs ∧ (∅ : Clause Board)∈cs ∧ cs.length=5 := by
  refine ⟨learned steps [],verify_sound _ _ _ _ IsRUPRun.nil (fun d hd => Or.inl (raw1 d hd)) checks,?_,?_⟩ <;> decide +kernel


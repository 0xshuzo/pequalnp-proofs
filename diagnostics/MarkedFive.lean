def entry (i : I) := states[i.val]?.getD (0,0,0,0)
def depth (i : I) : Nat := (entry i).1
def cell (i : I) (p : Fin 5) (h : Fin 4) : Option Bool :=
  let v := 4*p.val+h.val
  if (entry i).2.1.testBit v then none else some ((entry i).2.2.1.testBit v)
def response (i : I) (p : Fin 5) (h : Fin 4) : I × IP × IH :=
  let bits := (entry i).2.2.2 >>> (20*(4*p.val+h.val))
  (⟨bits % 1024 % 507,by omega⟩,⟨(bits / 1024) % 32 % 24,by omega⟩,⟨(bits / 32768) % 32 % 6,by omega⟩)

abbrev RowsGood (i : I) := ∀ p : Fin 5, (∃ h, cell i p h = some true) ∨
    ∃ h k, h ≠ k ∧ cell i p h = none ∧ cell i p k = none
abbrev PairsGood (i : I) := ∀ (p q : Fin 5) (h : Fin 4), p ≠ q →
    cell i p h = some false ∨ cell i q h = some false ∨ (cell i p h = none ∧ cell i q h = none)
abbrev MoveOK (i : I) (p : Fin 5) (h : Fin 4) :=
  let r := response i p h
  let j := r.1
  let a := permP r.2.1
  let b := permH r.2.2
  depth j + 1 = depth i ∧ cell j (a p) (b h) ≠ none ∧
    ∀ (q : Fin 5) (k : Fin 4), cell i q k = none ∨ cell j (a q) (b k) = cell i q k

set_option maxRecDepth 16000 in
set_option maxHeartbeats 0 in
theorem boards : ∀ i, RowsGood i ∧ PairsGood i := by decide +kernel

set_option maxRecDepth 16000 in
set_option maxHeartbeats 0 in
theorem strategy : ∀ (i : I), depth i ≠ 0 → ∀ p h, cell i p h = none → MoveOK i p h := by decide +kernel

def value (i : I) (a : Equiv.Perm (Fin 5)) (b : Equiv.Perm (Fin 4)) (v : V) := cell i (a v.1) (b v.2)

theorem base_good (i : I) (a : Equiv.Perm (Fin 5)) (b : Equiv.Perm (Fin 4)) : BaseSafe (value i a b) := by
  intro c hc
  rcases hc with ⟨p,rfl⟩ | ⟨p,q,h,pq,rfl⟩
  · have mem (h : Fin 4) : ((p,h),true) ∈ Finset.univ.image (fun j : Fin 4 => ((p,j),true)) :=
      Finset.mem_image.mpr ⟨h,Finset.mem_univ _,rfl⟩
    rcases (boards i).1 (a p) with ⟨h,on⟩ | ⟨h,k,ne,uh,uk⟩
    · exact Or.inl ⟨_,mem (b.symm h),by simpa [Holds,value] using on⟩
    · refine Or.inr ⟨_,mem (b.symm h),_,mem (b.symm k),?_,?_,?_⟩
      · intro eq
        exact ne (b.symm.injective (congrArg (fun l : L => l.1.2) eq))
      · simpa [value] using uh
      · simpa [value] using uk
  · have memp : ((p,h),false) ∈ ({((p,h),false),((q,h),false)} : C) := by simp
    have memq : ((q,h),false) ∈ ({((p,h),false),((q,h),false)} : C) := by simp
    rcases (boards i).2 (a p) (a q) (b h) (fun eq => pq (a.injective eq)) with hp | hq | ⟨up,uq⟩
    · exact Or.inl ⟨_,memp,hp⟩
    · exact Or.inl ⟨_,memq,hq⟩
    · exact Or.inr ⟨_,memp,_,memq,fun eq => pq (congrArg (fun l : L => l.1.1) eq),up,uq⟩


def testedClause : C := Finset.univ.filter (fun l => l.1.1=0 ∧ l.1.2.val<3 ∧ l.2=false)
abbrev Fixes (a : Equiv.Perm (Fin 5)) (b : Equiv.Perm (Fin 4)) :=
  a 0=0 ∧ ∀ h, (b h).val<3 ↔ h.val<3
theorem symmetry : ∀ (p : IP) (h : IH), Fixes (permP p) (permH h) := by decide +kernel
abbrev Marks (i : I) :=
  (∃ h : Fin 4, h.val<3 ∧ cell i 0 h=some false) ∨ ∃ h k : Fin 4, h.val<3 ∧ k.val<3 ∧ h≠k ∧ cell i 0 h=none ∧ cell i 0 k=none
set_option maxRecDepth 16000 in
set_option maxHeartbeats 0 in
theorem marked : ∀ i : I, Marks i := by decide +kernel
theorem board_mark (i : I) (a : Equiv.Perm (Fin 5)) (b : Equiv.Perm (Fin 4)) (fix : Fixes a b) :
    Safe (value i a b) testedClause := by
  have mem (h : Fin 4) (good : h.val<3) : ((0,b.symm h),false) ∈ testedClause := by
    have sm := (fix.2 (b.symm h)).mp (by simpa using good)
    simp [testedClause,sm]
  rcases marked i with ⟨h,hh,hon⟩ | ⟨h,k,hh,hk,ne,uh,uk⟩
  · exact Or.inl ⟨_,mem h hh,by simpa [Holds,value,fix.1] using hon⟩
  · refine Or.inr ⟨_,mem h hh,_,mem k hk,?_,?_,?_⟩
    · exact fun e => ne (b.symm.injective (congrArg (fun z : L => z.1.2) e))
    · simpa [value,fix.1] using uh
    · simpa [value,fix.1] using uk
theorem play (d : Nat) (i : I) (di : depth i = d) (a : Equiv.Perm (Fin 5)) (b : Equiv.Perm (Fin 4)) (fix : Fixes a b) :
    KeepGame (fun t => BaseSafe t ∧ Safe t testedClause) d (value i a b) := by
  induction d generalizing i a b with
  | zero => exact ⟨base_good i a b,board_mark i a b fix⟩
  | succ d ih =>
    refine ⟨⟨base_good i a b,board_mark i a b fix⟩,?_⟩
    rintro ⟨p,h⟩ unknown
    let r := response i (a p) (b h)
    obtain ⟨rank,fixed,ext⟩ := strategy i (by omega) (a p) (b h) unknown
    let ap := a.trans (permP r.2.1)
    let bp := b.trans (permH r.2.2)
    have localFix := symmetry r.2.1 r.2.2
    have nextFix : Fixes ap bp := by
      constructor
      · change permP r.2.1 (a 0)=0
        rw [fix.1,localFix.1]
      · intro h
        exact (localFix.2 (b h)).trans (fix.2 h)
    refine ⟨value r.1 ap bp,?_,fixed,ih r.1 (Nat.succ.inj (rank.trans di)) ap bp nextFix⟩
    rintro ⟨q,k⟩ bit was
    rcases ext (a q) (b k) with absent | same
    · change cell i (a q) (b k) = some bit at was
      simp_all
    · exact same.trans was

theorem checked_template : ∃s, KeepGame (fun t => BaseSafe t ∧ Safe t testedClause) 5 s :=
  ⟨_,play 5 0 (by decide +kernel) (Equiv.refl _) (Equiv.refl _) ⟨rfl,fun _ => Iff.rfl⟩⟩
theorem safe_expand {s : Val} {c d : C} (sub : c⊆d) (h : Safe s c) : Safe s d := by
  rcases h with ⟨l,ml,yes⟩ | ⟨a,ha,b,hb,ne,ua,ub⟩
  · exact Or.inl ⟨l,sub ml,yes⟩
  · exact Or.inr ⟨a,sub ha,b,sub hb,ne,ua,ub⟩
theorem marked_member_lower {cs : List C} (run : IsRUPRun (PHP 5 4) cs)
    (out : (∅ : C)∈cs) {d : C} (member : d∈cs) (sub : testedClause⊆d) : 8≤cs.length := by
  classical
  by_contra! len
  have tested_non : testedClause.Nonempty := by decide +kernel
  have dne : d≠∅ := (tested_non.mono sub).ne_empty
  have hm : (∅ : C)∈cs.toFinset := List.mem_toFinset.mpr out
  have cm : d∈cs.toFinset.erase ∅ := Finset.mem_erase.mpr ⟨dne,List.mem_toFinset.mpr member⟩
  let saved := (cs.toFinset.erase ∅).erase d
  have bound : saved.card≤5 := by
    simp only [saved,Finset.card_erase_of_mem cm,Finset.card_erase_of_mem hm]
    have hh := List.toFinset_card_le (l:=cs)
    omega
  obtain ⟨s,g⟩ := checked_template
  obtain ⟨t,_,⟨bt,ct⟩,rest⟩ := avoidKept 5 s g saved bound
  have none : ∀c∈cs, ¬Single t c := by
    intro c mc
    by_cases emp : c=∅
    · subst c
      simp [Single]
    · by_cases same : c=d
      · subst c
        exact safe_not_single (safe_expand sub ct)
      · exact rest c (Finset.mem_erase.mpr ⟨same,Finset.mem_erase.mpr ⟨emp,List.mem_toFinset.mpr mc⟩⟩)
  have bad := safe_run bt run none ∅ out
  simp [Safe] at bad
end PEqualNP.Outside.L_meta_9248.Locality

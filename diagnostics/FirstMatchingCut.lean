def input (i k : Fin 15) (b : Bool) := raw wit[2*(15*i.val+k.val)+b.toNat]!
theorem table : ∀ (i k : Fin 15),k≠i → ∀b : Bool,
    input i k b k=b ∧ pm (Function.update (input i k b) i (!(input i k b i))) ≠ pm (input i k b) := by decide +kernel
theorem single : ∀ i : Fin 15, pm (Function.update (input i (i+1) false) i (!(input i (i+1) false i))) ≠ pm (input i (i+1) false) := by decide +kernel

theorem shrink (s : Nat) (hc : HasCircuitSize 15 pm s) :
    ∃ (i : Fin 15) (b : Bool) (k : Nat), k+3≤s ∧
      HasCircuitSize 14 (fun x => pm (Fin.insertNth i b x)) k := by
  have nonc : ∃x y : Fin 15→Bool,pm x≠pm y := ⟨raw 0,raw 32767,by decide +kernel⟩
  obtain ⟨gs,o,hcl,len,hev⟩ := clean_of 15 pm s nonc hc
  have hok : ∀g∈gs, Ok g := fun g hg => (clean_nok _ gs hcl g hg).1
  have hinv (i : Fin 15) (b : Bool) (y : Fin 14→Bool) :=
    inv_elim 14 (List.ofFn y) (by simp) gs (List.ofFn (Fin.insertNth i b y : Fin 15→Bool))
       (statAt 14 i b, []) hok (inv_at 14 i b y)
  have hv (i : Fin 15) (b : Bool) (y : Fin 14→Bool) :
      (stF 14 gs i b o).val (wiresFrom (elim 14 gs (statAt 14 i b, [])).2
        (List.ofFn y)) = pm (Fin.insertNth i b y) := by
    exact ((hinv i b y).2 o).2.trans (hev _)
  have hout (i : Fin 15) (b c : Bool) : stF 14 gs i b o ≠ Stat.const c := by
    intro const
    have lo := hv i b (fun _ => false)
    have hi := hv i b (fun _ => true)
    rw [const] at lo hi
    have diff : ∀ (i : Fin 15) (b : Bool), pm (Fin.insertNth i b fun _ => false) ≠
      pm (Fin.insertNth i b fun _ => true) := by decide +kernel
    exact diff i b (lo.symm.trans hi)
  obtain ⟨i,b,k⟩ := three_saved 14 gs hcl o
    (fun i => ⟨_,by simpa only [hev] using single i⟩)
    (fun i k ne b => ⟨_,(table i k ne b).1,by simpa only [hev] using (table i k ne b).2⟩) hout
  cases hst : stF 14 gs i b o with
  | const c => exact False.elim (hout i b c hst)
  | wire j =>
    let D : Circuit := ⟨(elim 14 gs (statAt 14 i b, [])).2,j⟩
    refine ⟨i,b,D.size,by change (elim 14 gs (statAt 14 i b, [])).2.length+3≤s; omega,D,?_,le_refl _,?_⟩
    · have clean := clean_elim 14 (List.ofFn fun _ : Fin 14 => false) (by simp) gs _ _ hok
          (inv_at 14 i b _) (by intro p g hp; simp at hp)
      exact fun g hg => (clean_nok _ _ clean g hg).1
    · intro x
      have val := hv i b x
      rw [hst] at val
      exact val
end FirstMatch18855

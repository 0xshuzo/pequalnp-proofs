import PEqualNP.Defs
namespace PCX150.Pack
def digit (c : UInt8) : Nat :=
  let v := c.toNat
  if 65 ≤ v && v < 91 then v-65 else if 97 ≤ v && v < 123 then v-71 else
  if 48 ≤ v && v < 58 then v+4 else if v=45 then 62 else 63
def value (bytes : ByteArray) (fromAt width : Nat) : Nat :=
  (List.range width).foldr (fun i n => digit bytes[fromAt+i]! + 64*n) 0
def fixed (n w : Nat) (s : String) : Array Nat :=
  ((List.range n).map (fun i => value s.toUTF8 (i*w) w)).toArray
def mixed (n b lens : Nat) (s : String) : Array Nat :=
  let bytes := s.toUTF8
  ((List.range n).foldl (fun (st : Nat × Array Nat) i =>
    let w := (lens >>> (b*i)) % (2^b)
    (st.1+w,st.2.push (value bytes st.1 w))) (0,#[])).2
end PCX150.Pack


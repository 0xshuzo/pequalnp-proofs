import PEqualNP.Defs

namespace CellsData
def mask72 : Nat := 0xffffffffffffffffff
def page (xs : Array Nat) (i : Nat) : Nat := xs.getD (i%103) 0
def denseChunks (w b : Nat) (dict : Array Nat) : Nat → Nat → Nat
  | 0,_ => 0
  | n+1,v =>
    let coded := v%2=1
    let size := if coded then b else w
    let part := (v >>> 1)%2^size
    (if coded then dict.getD part 0 else part) ||| (denseChunks w b dict n (v >>> (size+1)) <<< w)
def densePage (w b lo hi : Nat) (dict xs : Array Nat) (i : Nat) : Nat :=
  let j := i%103
  let v := xs.getD j 0
  if (if j<80 then lo.testBit j else hi.testBit (j-80)) then denseChunks w b dict (80/w) v else v

set_option maxHeartbeats 0 in
theorem maskOK : ∀ (i : Idx) (q : Q), (goodMask q).testBit i.val = true → q ∉ misses i := by decide +kernel
def here (b : Nat) : Idx := ⟨min (Nat.log2 b) 145, by omega⟩
def checks : Nat → Nat → Bool
  | 0, b => b.testBit (here b).val
  | k+1, b => b.testBit (here b).val && (misses (here b)).all fun q => checks k (b &&& goodMask q)

theorem checksSound : ∀ k b, checks k b = true →
    ∀ T : Finset Q, T.card ≤ k → ∃ i : Idx, b.testBit i.val = true ∧ ∀ q ∈ T, q ∉ misses i := by
  intro k
  induction k with
  | zero =>
    intro b hb T hT
    have ht : T = ∅ := Finset.card_eq_zero.mp (by omega)
    exact ⟨here b, hb, by simp [ht]⟩
  | succ k ih =>
    intro b hb T hT
    change (_ && _) = true at hb
    have hh : b.testBit (here b).val = true ∧ ((misses (here b)).all fun q => checks k (b &&& goodMask q)) = true := by simpa only [Bool.and_eq_true] using hb
    by_cases clear : ∀ q ∈ T, q ∉ misses (here b)
    · exact ⟨here b,hh.1,clear⟩
    · push_neg at clear
      obtain ⟨q,hq,hm⟩ := clear
      have child := List.all_eq_true.mp hh.2 q hm
      have small : (T.erase q).card ≤ k := by rw [Finset.card_erase_of_mem hq]; omega
      obtain ⟨i,hi,agree⟩ := ih _ child _ small
      rw [Nat.testBit_and] at hi
      have hh2 : b.testBit i.val = true ∧ (goodMask q).testBit i.val = true := by simpa only [Bool.and_eq_true] using hi
      obtain ⟨hb',hg⟩ := hh2
      refine ⟨i,hb',?_⟩
      intro r hr
      by_cases eq : r = q
      · subst r
        exact maskOK i q hg
      · exact agree r (Finset.mem_erase.mpr ⟨eq,hr⟩)

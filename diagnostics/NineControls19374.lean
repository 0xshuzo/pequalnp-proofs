theorem everyNine (T : Finset Q) (ht : T.card ≤ 9) :
    ∃ C : Circuit, FanInTwo C ∧ C.size ≤ 7 ∧ ∀ q ∈ T, value C q = target q := by
  obtain ⟨i,_,hi⟩ := checksSound 9 _ part_0 T ht
  exact ⟨family i, sound _ (legalAll i).1, (legalAll i).2, fun q hq => replayAll i q (hi q hq)⟩
end PEqualNP.Outside.L_meta_19374.Controls


def pi1 : List ℕ := piBlocks.flatten
def permAt (i : Nat) : Nat := (piBlocks.getD (i / 32) []).getD (i % 32) 0
def matchAt (f : Nat → Nat) (xs : List Nat) : Nat → Bool :=
  List.rec (motive := fun _ => Nat → Bool) (fun _ => true)
    (fun x _ tail start => (x == f start) && tail (start+1)) xs
lemma matchAt_get (f : Nat → Nat) (xs : List Nat) (start j : Nat)
    (ok : matchAt f xs start = true) (hj : j < xs.length) : xs.getD j 0 = f (start+j) := by
  induction xs generalizing start j with
  | nil => simp at hj
  | cons x xs ih =>
    change ((x == f start) && matchAt f xs (start+1)) = true at ok
    simp only [Bool.and_eq_true] at ok
    cases j with
    | zero => simpa using Nat.eq_of_beq_eq_true ok.1
    | succ j =>
      have small : j < xs.length := by simpa using hj
      have h := ih (start+1) j ok.2 small
      have ar : start + (j + 1) = (start+1) + j := by omega
      simpa [List.getD,ar] using h

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem piExtent : pi1.length = 1428 := by decide +kernel
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem piAgreement : matchAt permAt pi1 0 = true := by decide +kernel
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem piFastInvolution : (List.range 1428).all (fun i =>
    decide (permAt i < 1428) && (permAt (permAt i) == i)) = true := by decide +kernel
theorem pi1InvolutionTable : (List.range pi1.length).all (fun i =>
    decide (pi1.getD i 0 < pi1.length) && (pi1.getD (pi1.getD i 0) 0 == i)) = true := by
  apply List.all_eq_true.mpr
  intro i hi
  have bound : i < pi1.length := List.mem_range.mp hi
  have atPi (j) (small : j < pi1.length) : pi1.getD j 0 = permAt j := by
    simpa using matchAt_get permAt pi1 0 j piAgreement small
  have inside : i < 1428 := piExtent ▸ bound
  have pair := List.all_eq_true.mp piFastInvolution i (List.mem_range.mpr inside)
  simp only [Bool.and_eq_true] at pair
  have low : permAt i < pi1.length := by rw [piExtent]; exact of_decide_eq_true pair.1
  rw [atPi i bound,atPi (permAt i) low]
  simp [low,pair.2]
#eval (show IO Unit from do IO.println ("end blocked " ++ toString (← IO.monoMsNow)))

import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_9762_Clean
variable {U V : Type}

def edge (g : U → U → Prop) (s : Set U) := ∃ u ∈ s, ∃ v ∈ s, g u v
def pull (q : U → Option V) (s : Set V) : Set U := {u | ∃ v ∈ s, q u=some v}
def image (q : U → Option V) (g : U → U → Prop) (a b : V) : Prop :=
  ∃ u v, g u v ∧ q u=some a ∧ q v=some b

theorem pull_edge (g : U → U → Prop) (q : U → Option V) (s : Set V) :
    edge g (pull q s) ↔ edge (image q g) s := by
  constructor
  · rintro ⟨u,⟨a,ha,qa⟩,v,⟨b,hb,qb⟩,e⟩
    exact ⟨a,ha,b,hb,u,v,e,qa,qb⟩
  · rintro ⟨a,ha,b,hb,u,v,e,qa,qb⟩
    exact ⟨u,⟨a,ha,qa⟩,v,⟨b,hb,qb⟩,e⟩

-- The signed donor is an arbitrary function on raw assignments.
theorem clean_projection (g r : U → U → Prop) (h : Set U → Prop) (q : U → Option V)
    (fit : ∀ s, (edge r s ∨ h s) ↔ edge g s)
    (clear : ∀ a b, ¬image q r a b) (s : Set V) :
    h (pull q s) ↔ edge (image q g) s := by
  have dead : ¬edge r (pull q s) := by
    intro e
    obtain ⟨a,_,b,_,ab⟩ := (pull_edge r q s).1 e
    exact clear a b ab
  rw [← pull_edge,← fit]
  tauto

-- Keep only endpoints required of the private donor. The residual may cover any
-- other edges of the target, including those between two retained pins.
theorem discard_unused (g r : U → U → Prop) (h : Set U → Prop) (keep : Set U)
    (fit : ∀ s, (edge r s ∨ h s) ↔ edge g s)
    (supported : ∀ a b, g a b → r a b ∨ a∈keep ∧ b∈keep) (s : Set U) :
    (edge r s ∨ h (s∩keep)) ↔ edge g s := by
  constructor
  · rintro (hr|hh)
    · exact (fit s).1 (Or.inl hr)
    · obtain ⟨i,hi,j,hj,ij⟩ := (fit (s∩keep)).1 (Or.inr hh)
      exact ⟨i,hi.1,j,hj.1,ij⟩
  · rintro ⟨i,hi,j,hj,ij⟩
    rcases supported i j ij with rij | ⟨ik,jk⟩
    · exact Or.inl ⟨i,hi,j,hj,rij⟩
    · rcases (fit (s∩keep)).2 ⟨i,⟨hi,ik⟩,j,⟨hj,jk⟩,ij⟩ with hr | hh
      · obtain ⟨a,ha,b,hb,ab⟩ := hr
        exact Or.inl ⟨a,ha.1,b,hb.1,ab⟩
      · exact Or.inr hh

abbrev E := Nat × Nat
structure Case where
  need : List E
  residual : List E
  q : List Nat
  growth : List (Nat × Nat)
  donor : Nat
  budget : Nat

def und (i j : Nat) := (min i j,max i j)
def ed (i : Nat) : List E :=
  if i=516 then [(0,2),(0,4),(0,6),(1,3),(1,5),(1,7),(2,3),(4,5),(6,7)]
  else if i=517 then [(0,2),(0,3),(0,5),(1,2),(1,4),(1,6),(3,4),(5,6)]
  else [(0,1),(0,3),(1,4),(2,4),(2,5),(3,5)]
def floor (i : Nat) := if i=516 then 12 else if i=517 then 11 else 8
def grow : List E → List E → List Nat → Bool
  | _,[],_ => true
  | d,(i,j)::rest,seen =>
    !(seen.contains i) && seen.contains j && d.contains (und i j) && grow d rest (i::seen)
def check (c : Case) : Bool :=
  let keep := (List.range c.q.length).filter fun i => c.q.getD i 0 != 0
  let im := c.need.filterMap fun (a,b) =>
    let x := c.q.getD a 0
    let y := c.q.getD b 0
    if x==0 || y==0 then none else some (und (x-1) (y-1))
  [516,517,4795].contains c.donor &&
  im.all ((ed c.donor).contains ·) && (ed c.donor).all (im.contains ·) &&
  c.residual.all (fun (a,b) => c.q.getD a 0 == 0 || c.q.getD b 0 == 0) &&
  grow c.need c.growth keep && keep.length+c.growth.length == c.q.length &&
  c.budget < floor c.donor + c.growth.length


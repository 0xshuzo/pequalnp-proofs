def positives : Set Input := {v | ∃ q ∈ edges, v = pairInput q}

theorem target_any (x : Input) :
    target x = edges.any (fun q => x q.1 && x q.2) := by
  dsimp only [target, edges, List.any]
  simp only [Bool.or_false, Bool.or_assoc]

theorem generated_target : Generated (fun x => target x = true) positives := by
  intro x
  change target x = true ↔ ∃ a ∈ positives, a ≤ x
  rw [target_any, List.any_eq_true]
  constructor
  · rintro ⟨q, hq, hv⟩
    exact ⟨pairInput q, ⟨q, hq, rfl⟩, (pair_le q x).2 (by simpa only [Bool.and_eq_true] using hv)⟩
  · rintro ⟨v, ⟨q, hq, rfl⟩, hv⟩
    exact ⟨q, hq, by simpa only [Bool.and_eq_true] using (pair_le q x).1 hv⟩

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

/-- A signed 123-gate witness can be submitted after checking the four
families against the displayed graph. The control may be any monotone DNF. -/
theorem certify (C : Circuit) (cb : FanInTwo C) (cs : C.size ≤ 123)
    {h : Input → Prop} {I T J : Set Input}
    (ni : NegativeCover (fun x => target x = true) I)
    (th : Generated h T) (nj : NegativeCover h J)
    (gm : FaceMono h (fun x => C.eval (List.ofFn x) = true))
    (p₀ : ∀ e ∈ positives, C.eval (List.ofFn e) = true)
    (p₁ : ∀ e ∈ positives, ∀ t ∈ T, C.eval (List.ofFn (e ⊔ t)) = true)
    (n₀ : ∀ i ∈ I, C.eval (List.ofFn i) ≠ true)
    (n₁ : ∀ i ∈ I, ∀ j ∈ J, C.eval (List.ofFn (i ⊓ j)) ≠ true) :
    HasCircuitSize 42 target 123 := by
  refine ⟨C, cb, cs, ?_⟩
  intro x
  rw [Bool.eq_iff_iff]
  exact (complete generated_target ni th nj gm p₀ p₁ n₀ n₁ x)


/-- Cutting the sole NOT gives two ordered monotone output functions. -/
structure Bracket {α : Type*} [PartialOrder α] (f h lo hi : α → Prop) : Prop where
  lowMono : ∀ ⦃x y⦄, x ≤ y → lo x → lo y
  highMono : ∀ ⦃x y⦄, x ≤ y → hi x → hi y
  ordered : ∀ x, lo x → hi x
  onFace : ∀ x, h x → (lo x ↔ f x)
  offFace : ∀ x, ¬ h x → (hi x ↔ f x)

theorem bracket_sandwich {α : Type*} [PartialOrder α] {f h lo hi : α → Prop}
    (b : Bracket f h lo hi) (x : α) : (lo x → f x) ∧ (f x → hi x) := by
  by_cases hx : h x
  · exact ⟨(b.onFace x hx).mp, fun fx => b.ordered x ((b.onFace x hx).mpr fx)⟩
  · exact ⟨fun lx => (b.offFace x hx).mp (b.ordered x lx), (b.offFace x hx).mpr⟩

/-- A low constant replacement needs to be tested only on the minimal
positive boundary. A high replacement needs only the maximal negative boundary. -/
theorem constant_test {α : Type*} [PartialOrder α] {f h lo hi : α → Prop} {E I : Set α}
    (b : Bracket f h lo hi) (ge : Generated f E) (ni : NegativeCover f I) :
    ((∀ x, lo x ↔ f x) ↔ ∀ e ∈ E, lo e) ∧
    ((∀ x, hi x ↔ f x) ↔ ∀ i ∈ I, ¬ hi i) := by
  constructor
  · constructor
    · exact fun eq e he => (eq e).mpr ((ge e).mpr ⟨e, he, le_rfl⟩)
    · intro all x
      refine ⟨(bracket_sandwich b x).1, ?_⟩
      intro fx
      obtain ⟨e, he, hex⟩ := (ge x).mp fx
      exact b.lowMono hex (all e he)
  · constructor
    · exact fun eq i hi' hx => ni.1 i hi' ((eq i).mp hx)
    · intro all x
      refine ⟨?_, (bracket_sandwich b x).2⟩
      intro hx
      by_contra nf
      obtain ⟨i, hi', hxi⟩ := ni.2 x nf
      exact all i hi' (b.highMono hxi hx)

/-- Every essential single NOT has an edge outside its control and an
independent upper witness within its control. Both can show the failure of a
physical constant replacement. -/
theorem critical_witnesses {α : Type*} [PartialOrder α] {f h lo hi : α → Prop} {E I : Set α}
    (b : Bracket f h lo hi) (ge : Generated f E) (ni : NegativeCover f I)
    (badLow : ¬ ∀ x, lo x ↔ f x) (badHigh : ¬ ∀ x, hi x ↔ f x) :
    (∃ e ∈ E, ¬ h e ∧ ¬ lo e) ∧ (∃ i ∈ I, h i ∧ hi i) := by
  classical
  obtain ⟨low, high⟩ := constant_test b ge ni
  have badE : ¬ ∀ e ∈ E, lo e := fun all => badLow (low.mpr all)
  have badI : ¬ ∀ i ∈ I, ¬ hi i := fun all => badHigh (high.mpr all)
  push_neg at badE badI
  obtain ⟨e, he, hle⟩ := badE
  obtain ⟨i, hi', hhi⟩ := badI
  refine ⟨⟨e, he, ?_, hle⟩, ⟨i, hi', ?_, hhi⟩⟩
  · exact fun ce => hle ((b.onFace e ce).mpr ((ge e).mpr ⟨e, he, le_rfl⟩))
  · by_contra hn
    exact ni.1 i hi' ((b.offFace i hn).mp hhi)

theorem comparable_control {α : Type*} [PartialOrder α] {f h lo hi : α → Prop}
    (b : Bracket f h lo hi) :
    ((∀ x, h x → f x) → ∀ x, hi x ↔ f x) ∧
    ((∀ x, f x → h x) → ∀ x, lo x ↔ f x) := by
  constructor
  · intro hf x
    by_cases hx : h x
    · exact ⟨fun _ => hf x hx, (bracket_sandwich b x).2⟩
    · exact b.offFace x hx
  · intro fh x
    exact ⟨(bracket_sandwich b x).1, fun fx => (b.onFace x (fh x fx)).mpr fx⟩


theorem oval_sides : ∀ h : H, (oval h).1.card = 6 ∧ (oval h).2.card = 6 := by decide +kernel

theorem large_extends (b : Box) (hb : legal b) (large : 28 < area b) :
    ∃ h : H, fits b (oval h) ∧ legal (oval h) ∧
      (oval h).1.card = 6 ∧ (oval h).2.card = 6 := by
  obtain ⟨o,s,sub⟩ := containingTile b.1 b.2 hb
  cases hs : ovalType o with
  | none =>
    have cap := (ordinaryShape (s := s) hs).1
    have mono : area b ≤ area (tile o s) :=
      Nat.mul_le_mul (Finset.card_le_card sub.1) (Finset.card_le_card sub.2)
    omega
  | some i =>
    rw [specialTile hs s] at sub
    exact ⟨label i s,sub,(fun p hp q hq => oval_law _ p q hp hq),oval_sides _⟩


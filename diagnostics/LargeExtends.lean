theorem maskSize : ∀ o : O, rm o < 2^21 ∧ cm o < 2^21 := by decide +kernel

theorem addRow (o : O) (s p : V) :
    ∃ o' s', (tile o s).1 ⊆ (tile o' s').1 ∧ p ∈ (tile o' s').1 ∧
      ∀ q ∈ (tile o s).2, bit p q = false → q ∈ (tile o' s').2 := by
  let c := nextCode o (p-s)
  let u := orb c
  let t := turn c
  obtain ⟨ra,atp,cb⟩ := extTable o (p-s)
  change rm o &&& roll (rm u) t = rm o at ra
  change (roll (rm u) t).testBit (p-s).val = true at atp
  change (cm o &&& (2097151-incidence.getD (p-s).val 0)) &&& roll (cm u) t = _ at cb
  refine ⟨u,s+t,?_,?_,?_⟩
  · intro i hi
    have h := bitSub _ _ ra ((memSide _ _ _).mp hi)
    rw [rollBit _ (maskSize u).1,sub_sub] at h
    exact (memSide _ _ _).mpr h
  · rw [rollBit _ (maskSize u).1,sub_sub] at atp
    exact (memSide _ _ _).mpr atp
  · intro q hq zero
    have hz : (2097151-incidence.getD (p-s).val 0).testBit (q-s).val = true := by
      rw [zerosBit,shiftBit,zero]; rfl
    have hb := bitSub _ _ cb (i := (q-s).val) (by simp only [Nat.testBit_and,(memSide _ _ _).mp hq,hz]; rfl)
    rw [rollBit _ (maskSize u).2,sub_sub] at hb
    exact (memSide _ _ _).mpr hb

theorem containingTile (A B : Finset V) (ok : legal (A,B)) : ∃ o s, fits (A,B) (tile o s) := by
  induction A using Finset.induction_on with
  | empty =>
    refine ⟨initial,0,empty_subset _,?_⟩
    have e : (tile initial 0).2 = univ := by decide
    simpa [e] using B.subset_univ
  | @insert p A _ ih =>
    obtain ⟨o,s,ha,hb⟩ := ih (fun i hi => ok i (mem_insert_of_mem hi))
    obtain ⟨u,t,sub,hp,cols⟩ := addRow o s p
    exact ⟨u,t,insert_subset hp (ha.trans sub),fun q hq =>
      cols q (hb hq) (ok p (mem_insert_self _ _) q hq)⟩

-- Each digit holds a cell weight for one case. The bounds below exclude carries.

def tally (b : Box) (w : V → V → Nat) := ∑ p ∈ b.1, ∑ q ∈ b.2, w p q

theorem tallyMono {b c : Box} (sub : fits b c) (w : V → V → Nat) : tally b w ≤ tally c w := by
  unfold tally
  exact (sum_le_sum (fun p _ => sum_le_sum_of_subset_of_nonneg sub.2 (by intros; omega))).trans
    (sum_le_sum_of_subset_of_nonneg sub.1 (by intros; omega))

def area (b : Box) := b.1.card * b.2.card

def sizeRule (b : Box) := area b ≤ 28 ∧
  (area b = 28 → (b.1.card=4 ∧ b.2.card=7) ∨ (b.1.card=7 ∧ b.2.card=4))


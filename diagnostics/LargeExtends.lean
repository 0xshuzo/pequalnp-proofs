theorem ordinaryShape {o : O} {s : V} (none : ovalType o = Option.none) : sizeRule (tile o s) := by
  have t := shapeRangeAll o.val (by omega) o.isLt
  simp only [shapeTest,Fin.ofNat_val_eq_self,none,Option.isSome_none,Bool.false_or,decide_eq_true_eq] at t
  have ct (m : Nat) : (side m s).card = (side m 0).card := by
    rw [←shiftSide,card_image_of_injective _ (fun _ _ e => add_right_cancel e)]
  simpa only [sizeRule,area,tile,ct] using t

theorem weightCovered (T : Finset Box) (w : V → V → Nat)
    (hc : ∀ p q, 0 < w p q → ∃ b ∈ T, hit b p q) :
    tally (univ,univ) w ≤ ∑ b ∈ T, tally b w := by
  let f := fun b : Box => fun p q => if p ∈ b.1 then (if q ∈ b.2 then w p q else 0) else 0
  have pt (p q : V) : w p q ≤ ∑ b ∈ T, f b p q := by
    by_cases hp : 0 < w p q
    · obtain ⟨b,hb,hr,hc'⟩ := hc p q hp
      have := single_le_sum (f := fun c => f c p q) (fun c _ => Nat.zero_le _) hb
      simpa only [f,hr,hc',ite_true] using this
    · omega
  calc
    _ ≤ ∑ p : V, ∑ q : V, ∑ b ∈ T, f b p q := sum_le_sum fun p _ => sum_le_sum fun q _ => pt p q
    _ = ∑ b ∈ T, ∑ p : V, ∑ q : V, f b p q := by
      simp_rw [sum_comm (s := (univ : Finset V)) (t := T)]
    _ = _ := by
      apply sum_congr rfl
      intro b _
      simp [f,sum_ite_irrel,sum_ite_mem,tally]



private def blocks : Array (Array Nat) := #[block0,block1,block2,block3,block4,block5,block6,block7,block8,block9,block10,block11,block12,block13,block14,block15,block16,block17,block18,block19,block20,block21,block22,block23,block24,block25,block26,block27,block28,block29,block30,block31,block32,block33,block34,block35,block36,block37,block38,block39,block40,block41,block42,block43,block44,block45,block46,block47,block48,block49,block50,block51]

abbrev KeyID := Fin 3306

def packed (i : KeyID) : Nat := (blocks[i.val / 64]!)[i.val % 64]!
def stateMask (i : KeyID) : Nat := packed i % 2^60
def rawCost (i : KeyID) : Nat := (packed i >>> 60) % 64
def child (i : KeyID) (v : V) (b : Bool) : KeyID :=
  Fin.ofNat 3306 ((packed i >>> (66 + 24 * port v + (if b then 12 else 0))) % 4096)

def secondCols : Array Nat := #[,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,]

def secondAll : Nat := 2^3306-1

def supersets (m : Nat) : Nat :=
  (List.range 60).foldl (fun acc b => if m.testBit b then acc &&& secondCols[b]! else acc) secondAll

structure Node where
  mask : Nat
  base : Nat
  super : Nat
  cuts : List (Nat × Nat)
  deriving Inhabited

def nodeAt (i : Nat) : Node :=
  let z := packed (Fin.ofNat 3306 i)
  let m := z % 2^60
  let w := (z >>> 60) % 64
  let pairs := if w ≤ 1 then [] else
    (List.range 12).foldl (fun acc v =>
      let f := z >>> (66+24*v)
      let a := f % 4096
      let b := (f >>> 12) % 4096
      let t := (min a b,max a b)
      if a < i && b < i && !(acc.contains t) then t::acc else acc) []
  ⟨m,w,supersets m,pairs⟩

def nodes : Array Node := ((List.range 3306).map nodeAt).toArray

def table1 (A : Nat) : Array Nat := nodes.foldl (fun d n =>
  let w := if n.base ≤ 1 then n.base else if n.mask &&& A == n.mask then 1
    else n.cuts.foldl (fun b p => min b (d[p.1]! + d[p.2]!)) n.base
  d.push w) #[]

def convolution (l r : Array Nat) (k : Nat) : Nat :=
  let a := k+1-r.size
  let b := min (k+1) l.size
  (List.range (b-a)).foldl (fun m x =>
    let q := a+x
    m ||| (l[q]! &&& r[k-q]!)) 0

def thresholdRow (n : Node) (cap : Nat) (prior : Array (Array Nat)) : Array Nat :=
  ((List.range (cap+1)).map (fun k =>
    if k ≤ 1 then secondAll else
      n.cuts.foldl (fun m p =>
        if m == 0 then 0 else m &&& convolution prior[p.1]! prior[p.2]! k) (secondAll ^^^ n.super))).toArray

def table2 (d : Array Nat) : Array (Array Nat) :=
  nodes.foldl (fun prior n => prior.push (thresholdRow n d[prior.size]! prior)) #[]

def oneOrbit (rep : Nat) : Bool :=
  let a := nodes[rep]!
  let d := table1 a.mask
  let r := (table2 d)[3305]!
  (List.range 3306).all (fun b =>
    let k := 41 - a.base - max 1 d[b]!
    (r.getD k 0).testBit b)

theorem pilot38 : oneOrbit 920 = true := by decide +kernel
end PCX150

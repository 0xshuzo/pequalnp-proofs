theorem storage (s t : Mask) : closed s t = true := by
  have round : ∀ q : Mask, BitVec.ofNat 5 q.toFin.val=q := by decide +kernel
  have h (i j : Fin 32) : closed (BitVec.ofNat 5 i.val) (BitVec.ofNat 5 j.val)=true := by
    fin_cases i
    · exact row0 j
    · exact row1 j
    · exact row2 j
    · exact row3 j
    · exact row4 j
    · exact row5 j
    · exact row6 j
    · exact row7 j
    · exact row8 j
    · exact row9 j
    · exact row10 j
    · exact row11 j
    · exact row12 j
    · exact row13 j
    · exact row14 j
    · exact row15 j
    · exact row16 j
    · exact row17 j
    · exact row18 j
    · exact row19 j
    · exact row20 j
    · exact row21 j
    · exact row22 j
    · exact row23 j
    · exact row24 j
    · exact row25 j
    · exact row26 j
    · exact row27 j
    · exact row28 j
    · exact row29 j
    · exact row30 j
    · exact row31 j
  have z:=h s.toFin t.toFin
  rw [round s,round t] at z
  exact z

inductive Formula where
  | var (i : Fin 5)
  | gate (isOr : Bool) (l r : Formula)
def used : Formula → Mask
  | .var i => scope i
  | .gate _ a b => used a ||| used b
def value : Formula → W
  | .var i => leaf i
  | .gate o a b => op o (value a) (value b)
def readOnce : Formula → Prop
  | .var _ => True
  | .gate _ a b => (used a &&& used b)=0 ∧ readOnce a ∧ readOnce b

theorem represented (f : Formula) (ok : readOnce f) : value f ∈ bank (used f) := by
  induction f with
  | var i =>
    have small : ∀ j : Fin 5, leaf j ∈ bank (scope j) := by decide +kernel
    exact small i
  | gate o a b la lb =>
    obtain ⟨sep,ra,rb⟩ := ok
    have cl := storage (used a) (used b)
    simp only [closed,sep,bne_self_eq_false,Bool.false_or,List.all_eq_true] at cl
    have v:=cl _ (la ra) _ (lb rb)
    have lhs := (Bool.and_eq_true_iff.mp v).1
    have rhs := (Bool.and_eq_true_iff.mp v).2
    cases o
    · exact List.contains_iff_mem.mp lhs
    · exact List.contains_iff_mem.mp rhs

def slice (w : W) (i : Nat) := (w.toNat >>> (4*i)) % 16
def hasFive (w : W) := [0,15,10,12,14].all (fun c =>
  (List.range 8).any (fun i => slice w i==c))
def twoForms : List W := [4209701056,4210092736,4243386528,4243647648,4272618496,4274846208,4277849088,4277861616,4277971456,4277992176,4288736416,4290833088,4293574848,4293590976,4293697696,4293722016,4294961856,4294962336]
theorem basisOK : (bank 31).all (fun w => !hasFive w || twoForms.contains w)=true := by decide +kernel

theorem classification (f : Formula) (ok : readOnce f) (full : used f=31)
    (required : hasFive (value f)=true) : value f ∈ twoForms := by
  have mem := represented f ok
  rw [full] at mem
  have hit:=List.all_eq_true.mp basisOK _ mem
  simpa [required,List.contains_iff_mem] using hit

abbrev Entry := W × BitVec 4
def constantAt (w : W) (c : Nat) : Bool :=
  let m : W := (286331153 : W) <<< c
  (w &&& m == 0) || (w &&& m == m)
def canFold (a b : W) (c : Nat) := constantAt a c || constantAt b c
def foldOptions (a b : W) : BitVec 4 :=
  (if canFold a b 0 then 1 else 0) |||
  (if canFold a b 1 then 2 else 0) |||
  (if canFold a b 2 then 4 else 0) |||
  (if canFold a b 3 then 8 else 0)
def clamps : Formula → BitVec 4
  | .var _ => 15
  | .gate _ a b => clamps a &&& clamps b &&& foldOptions (value a) (value b)
def entry (f : Formula) : Entry := (value f,clamps f)

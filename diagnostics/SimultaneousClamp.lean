theorem clampStorage (s t : Mask) : closedEntry s t = true := by
  have round : ∀ q : Mask, BitVec.ofNat 5 q.toFin.val=q := by decide +kernel
  have h (i j : Fin 32) : closedEntry (BitVec.ofNat 5 i.val) (BitVec.ofNat 5 j.val)=true := by
    fin_cases i
    · exact clampRow0 j
    · exact clampRow1 j
    · exact clampRow2 j
    · exact clampRow3 j
    · exact clampRow4 j
    · exact clampRow5 j
    · exact clampRow6 j
    · exact clampRow7 j
    · exact clampRow8 j
    · exact clampRow9 j
    · exact clampRow10 j
    · exact clampRow11 j
    · exact clampRow12 j
    · exact clampRow13 j
    · exact clampRow14 j
    · exact clampRow15 j
    · exact clampRow16 j
    · exact clampRow17 j
    · exact clampRow18 j
    · exact clampRow19 j
    · exact clampRow20 j
    · exact clampRow21 j
    · exact clampRow22 j
    · exact clampRow23 j
    · exact clampRow24 j
    · exact clampRow25 j
    · exact clampRow26 j
    · exact clampRow27 j
    · exact clampRow28 j
    · exact clampRow29 j
    · exact clampRow30 j
    · exact clampRow31 j
  have z:=h s.toFin t.toFin
  rw [round s,round t] at z
  exact z


theorem representedEntry (f : Formula) (ok : readOnce f) : entry f ∈ entries (used f) := by
  induction f with
  | var i =>
    have small : ∀j : Fin 5, entry (.var j) ∈ entries (scope j) := by decide +kernel
    exact small i
  | gate o a b la lb =>
    obtain ⟨sep,ra,rb⟩ := ok
    have cl := clampStorage (used a) (used b)
    simp only [closedEntry,sep,bne_self_eq_false,Bool.false_or,List.all_eq_true] at cl
    have v := cl _ (la ra) _ (lb rb)
    have lhs := (Bool.and_eq_true_iff.mp v).1
    have rhs := (Bool.and_eq_true_iff.mp v).2
    cases o
    · exact List.contains_iff_mem.mp lhs
    · exact List.contains_iff_mem.mp rhs

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2400000 in
theorem canClamp : (entries 31).all (fun z => !hasFive z.1 || z.2 != 0)=true := by decide +kernel

theorem commonClamp (f : Formula) (ok : readOnce f) (full : used f=31)
    (needed : hasFive (value f)=true) : clamps f ≠ 0 := by
  have h := representedEntry f ok
  rw [full] at h
  have pass := List.all_eq_true.mp canClamp _ h
  simpa [entry,needed] using pass

def C : Circuit := ⟨ops.map mk,141⟩

def numStep (w : List ℕ) (t : Op) : List ℕ :=
  let a := w.getD t.2.1 0
  let b := w.getD t.2.2 0
  w ++ [if t.1 then a &&& b else a ||| b]

def boolStep (w : List Bool) (g : Gate) := w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]
def sample (w : List ℕ) (k : ℕ) := w.map (fun a => a.testBit k)

lemma getSample (w : List ℕ) (i k : ℕ) :
    (sample w k).getD i false = (w.getD i 0).testBit k := by
  induction w generalizing i with
  | nil => simp [sample]
  | cons h t ih => cases i with
    | zero => rfl
    | succ i => exact ih i

lemma step (w : List ℕ) (k : ℕ) (t : Op) :
    boolStep (sample w k) (mk t) = sample (numStep w t) k := by
  rcases t with ⟨b,a,c⟩
  cases b <;> simp [boolStep,mk,numStep,GateOp.eval,sample,List.map_append,
    show ∀ i,(w.map (fun v => v.testBit k)).getD i false=(w.getD i 0).testBit k from fun i => getSample w i k,
    Nat.testBit_or,Nat.testBit_and]

lemma run (ts : List Op) (w : List ℕ) (k : ℕ) :
    (ts.map mk).foldl boolStep (sample w k) = sample (ts.foldl numStep w) k := by
  induction ts generalizing w with
  | nil => rfl
  | cons t ts ih => simp only [List.map_cons,List.foldl_cons,step,ih]


def digest (x : Fin 7 → Bool) : Nat :=
  (if x 0 then 1 else 0) + (if x 1 then 2 else 0) + (if x 2 then 4 else 0) +
  (if x 3 then 8 else 0) + (if x 4 then 16 else 0) + (if x 5 then 32 else 0) +
  (if x 6 then 64 else 0)
theorem capacity {k d : Nat} (S : Fin k → Nat) (z : Fin k → Nat) (cut : Nat)
    (value : Nat → Nat → Bool) (w : Fin d → Nat → Bool)
    (looks : ∀ i, z i = digest (fun j : Fin 7 => value (S i) (2 ^ j.val)))
    (clear : ∀ i, S i &&& cut = 0) (sep : ∀ i j, i ≠ j → z i ≠ z j)
    (sufficient : ∀ a b, a &&& cut = b &&& cut → (∀ j, w j a = w j b) →
       ∀ r, value a r = value b r) (size : 2^d < k) : False := by
  classical
  let codeAt (i : Fin k) (j : Fin d) := w j (S i)
  have inj : Function.Injective codeAt := by
    intro i j eq
    by_contra ne
    apply sep i j ne
    rw [looks i, looks j]
    apply congrArg digest
    funext c
    exact sufficient (S i) (S j) ((clear i).trans (clear j).symm) (fun l => congrFun eq l) _
  have bound := Fintype.card_le_of_injective codeAt inj
  simp at bound
  omega


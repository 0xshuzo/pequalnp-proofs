    (hr : ∀ i j : Fin 6, C.eval (pairInput i j) =
      (34630389437 : ℕ).testBit (6 * min i.val j.val + max i.val j.val)) :
    ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = reference x :=

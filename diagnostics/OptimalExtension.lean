def reference (x : Fin 6 → Bool) : Bool :=
  !((x 5 && (x 2 || x 3 || x 4)) || (x 1 && (x 0 || x 2)) || (x 3 && x 4))
def pairInput (i j : Fin 6) := List.ofFn fun k : Fin 6 => decide (k = i ∨ k = j)

theorem ruled11 : Every (fun s => ¬Accept tests 11 s) layer11 := advance ruled10 (by decide +kernel)

def required : Pool := [1392753, 1672064, 1973248]
def bank : Pool := [696338, 417920, 123904, 418048, 10784, 126976, 696384, 974994, 782354, 520320, 1044626, 517248, 975040, 779328, 1041600, 779282, 975122, 517376, 1041682, 520448, 975168, 782400, 1044800]

def roots (used : Pool) : Pool → List Pool
  | [] => if decide (used.length ≤ 12) && keyTests tests used then [norm used] else []
  | a::bank => if decide (used.length ≤ 12) && keyTests tests (used ++ (a::bank)) then
       roots used bank ++ roots (a::used) bank else []

theorem bank_closed : ∀ s ∈ roots required bank, ¬Accept tests 11 s := by
  have checked : (roots required bank).all (fun w => lookup w (code w) layer11) = true := by
    decide +kernel
  intro s hs
  exact lookup_sound ruled11 ((List.all_eq_true.mp checked) s hs)


def uncovered (i : Nat) (words : Pool) (seed : Nat) :=
  words.foldl (fun acc w => if (val w).testBit i then acc &&& val w else acc) seed

theorem uncovered_bit (i j : Nat) (s : Pool) (seed : Nat) :
    (uncovered i s seed).testBit j = true ↔ seed.testBit j = true ∧
    ∀ w ∈ s, (val w).testBit i = true → (val w).testBit j = true := by
  induction s generalizing seed with
  | nil => simp [uncovered]
  | cons a s ih =>
    change (uncovered i s (if (val a).testBit i then seed &&& val a else seed)).testBit j = true ↔ _
    rw [ih]
    cases e : (val a).testBit i <;> simp [e,Nat.testBit_and] <;> tauto

theorem keyTests_mono (T : Tests) {s t : Pool} (sub : ∀ w ∈ s, w ∈ t)
    (ok : keyTests T s = true) : keyTests T t = true := by
  apply List.all_eq_true.mpr
  intro i hi
  have src := List.all_eq_true.mp ok i hi
  change (uncovered i s T.neg == 0) = true at src
  change (uncovered i t T.neg == 0) = true
  apply beq_iff_eq.mpr
  have zero : uncovered i s T.neg = 0 := beq_iff_eq.mp src
  apply Nat.eq_of_testBit_eq
  intro j
  rw [Nat.zero_testBit]
  cases h : (uncovered i t T.neg).testBit j with
  | false => rfl
  | true =>
    obtain ⟨neg,all⟩ := (uncovered_bit _ _ _ _).mp h
    have bad := (uncovered_bit i j s T.neg).mpr ⟨neg,fun w a => all w (sub w a)⟩
    simp [zero] at bad

def select (used : Pool) : List (Bool × Signal) → Pool
  | [] => used
  | (take,w)::rest => select (if take then w::used else used) rest

theorem sel_len (used : Pool) (choices : List (Bool × Signal)) :
    used.length ≤ (select used choices).length := by
  induction choices generalizing used with
  | nil => rfl
  | cons a xs ih =>
    obtain ⟨b,w⟩ := a
    cases b <;> simp only [select,Bool.false_eq_true,ite_false,ite_true]
    · exact ih _
    · exact Nat.le_trans (by simp) (ih (w::used))

theorem sel_mem (used : Pool) (choices : List (Bool × Signal)) :
    ∀ w ∈ select used choices, w ∈ used ++ choices.map Prod.snd := by
  induction choices generalizing used with
  | nil => simp [select]
  | cons a xs ih =>
    obtain ⟨b,v⟩ := a
    intro w hw
    have mem := ih (if b then v::used else used) w hw
    cases b <;> simp_all <;> aesop

theorem all_selections (u : Pool) (cs : List (Bool × Signal))
    (len : (select u cs).length ≤ 12) (ok : keyTests tests (select u cs) = true) :
    norm (select u cs) ∈ roots u (cs.map Prod.snd) := by
  induction cs generalizing u with
  | nil =>
    change u.length ≤ 12 at len
    change keyTests tests u = true at ok
    simp [select,roots,len,ok]
  | cons h cs ih =>
    obtain ⟨b,w⟩ := h
    have current := (sel_len u ((b,w)::cs)).trans len
    have testsNow := keyTests_mono tests (sel_mem u ((b,w)::cs)) ok
    simp only [List.map_cons,Prod.snd] at testsNow ⊢
    rw [roots,if_pos (by simp [current,testsNow])]
    cases b with
    | false => exact List.mem_append_left _ (ih u len ok)
    | true => exact List.mem_append_right _ (ih (w::u) len ok)

theorem reject_any_selection (cs : List (Bool × Signal)) (channels : cs.map Prod.snd = bank)
    (len : (select required cs).length ≤ 12) (ok : keyTests tests (select required cs) = true) :
    ¬Accept tests 11 (norm (select required cs)) := by
  apply bank_closed
  rw [← channels]
  exact all_selections _ _ len ok


abbrev Assignment := Nat × Nat
def positive : List Assignment := [(1, 1), (1, 16), (1, 64), (2, 2), (2, 8), (2, 16), (4, 4), (4, 16), (4, 32)]
def negative : List Assignment := [(0, 127), (1, 46), (2, 101), (3, 36), (4, 75), (5, 10), (6, 65), (7, 0)]
def flags : List Nat := [0, 4, 5]
def selectedChannel : List (Bool × Nat) := [(true, 1), (true, 2), (true, 4), (false, 1), (false, 2), (false, 4), (false, 8), (false, 16), (false, 32), (false, 64), (false, 3), (false, 33), (false, 34), (false, 35), (false, 6), (false, 66), (false, 68), (false, 70), (false, 5), (false, 9), (false, 12), (false, 13), (false, 40), (false, 72), (false, 96), (false, 104)]
def sem (c : Bool × Nat) (a : Assignment) := ((if c.1 then a.1 else a.2) &&& c.2) != 0
def word (c : Bool × Nat) : Nat :=
  let values := (positive ++ negative).zipIdx.foldl
    (fun m z => if sem c z.1 then m ||| (1 <<< z.2) else m) 0
  (values <<< 4) ||| (if c.2.testBit 0 then if c.1 then 1 else 2 else 0)
theorem bank_values : selectedChannel.map word = required ++ bank := by decide +kernel

def inc (p l : Nat) : Bool := p == l || p == (l+1)%7 || p == (l+3)%7
def target (x y : Nat) : Bool := flags.zipIdx.any fun z =>
  x.testBit z.2 && (List.range 7).any (fun l => y.testBit l && inc z.1 l)
def below (x z : Assignment) : Bool := (x.1 &&& z.1 == x.1) && (x.2 &&& z.2 == x.2)
theorem extremes_complete : ∀ (xp : Fin 8) (yl : Fin 128),
  (if target xp.val yl.val then positive.any fun z => below z (xp.val,yl.val)
   else negative.any fun z => below (xp.val,yl.val) z) = true := by decide +kernel
theorem extremes_exact :
  (positive.all fun z => target z.1 z.2) && (negative.all fun z => !(target z.1 z.2)) = true := by decide +kernel


import PEqualNP.Defs

namespace MarkedFanoCut

abbrev Signal := Nat
abbrev Pool := List Signal

structure Tests where
  pos : Nat
  neg : Nat
  width : Nat

def val (w : Signal) := w >>> 4
def tag (w : Signal) := w &&& 15

def makeGate (isOr : Bool) (a b : Signal) : Signal :=
  let truth := if isOr then val a ||| val b else val a &&& val b
  let extra := if isOr then 0 else ((tag a &&& tag b &&& 3) <<< 2)
  (truth <<< 4) ||| tag a ||| tag b ||| extra

def ins (a : Nat) : Pool → Pool
  | [] => [a]
  | b::l => if a ≤ b then a::b::l else b::ins a l

def norm (s : Pool) := s.foldr ins []

def code (s : Pool) := s.foldl (fun z a => (z <<< 28) + a) 1

def keyTests (T : Tests) (s : Pool) : Bool := (List.range T.width).all fun i =>
  let uncovered := s.foldl (fun acc w => if (val w).testBit i then acc &&& val w else acc) T.neg
  uncovered == 0

def enough (r : Nat) (s : Pool) (unit : Nat) : Bool :=
  s.any (fun w => tag w &&& (4 * unit) != 0) ||
    decide ((if s.length = r + 1 then 2 else 1) ≤
      (s.filter (fun w => tag w &&& unit != 0)).length)

def clear (T : Tests) (r : Nat) (s : Pool) : Bool :=
  decide (s.length ≤ r + 1) && enough r s 1 && enough r s 2 && keyTests T s

def hit (T : Tests) (s : Pool) : Bool :=
  s.any (fun w => val w == T.pos && (tag w &&& 12 == 12))

def picks : Pool → List (Signal × Pool)
  | [] => []
  | a::s => (a,s)::(picks s).map (fun (b,l) => (b,a::l))

def pairs : Pool → List (Signal × Signal × Pool)
  | [] => []
  | a::s => (picks s).map (fun (b,l) => (a,b,l)) ++
      (pairs s).map (fun (b,c,l) => (b,c,a::l))

def privateRows (T : Tests) (orGate : Bool) (a b : Signal) : Bool :=
  let side := if orGate then T.pos else T.neg
  let whole := T.pos ||| T.neg
  (val a &&& (val b ^^^ whole) &&& side != 0) &&
  (val b &&& (val a ^^^ whole) &&& side != 0)

def next (T : Tests) (r : Nat) (s : Pool) : List Pool :=
  (pairs s).flatMap fun (a,b,l) => [false,true].flatMap fun isOr =>
    let w := makeGate isOr a b
    if !privateRows T isOr a b || (val w &&& T.pos == 0) ||
        (val w &&& T.neg == T.neg) || s.any (fun t => val t == val w) then []
    else [l,a::l,b::l,a::b::l].filterMap fun rest =>
      let q := w::rest
      if clear T r q then some (norm q) else none

def Accept (T : Tests) : Nat → Pool → Prop
  | 0,s => hit T s = true
  | r+1,s => hit T s = true ∨ ∃ q ∈ next T r s, Accept T r q

inductive Ledger where
  | empty
  | node (key : Nat) (s : Pool) (lo hi : Ledger)

def lookup (s : Pool) (k : Nat) : Ledger → Bool
  | .empty => false
  | .node j t lo hi =>
      if k < j then lookup s k lo else if j < k then lookup s k hi else s == t

def Every (Q : Pool → Prop) : Ledger → Prop
  | .empty => True
  | .node _ s lo hi => Q s ∧ Every Q lo ∧ Every Q hi

def allB (Q : Pool → Bool) : Ledger → Bool
  | .empty => true
  | .node _ s lo hi => Q s && allB Q lo && allB Q hi

theorem lookup_sound {Q : Pool → Prop} {t : Ledger} (ok : Every Q t)
    {s : Pool} {k : Nat} (found : lookup s k t = true) : Q s := by
  induction t with
  | empty => simp [lookup] at found
  | node j v l h il ih =>
    change Q v ∧ Every Q l ∧ Every Q h at ok
    by_cases a : k < j
    · exact il ok.2.1 (by simpa [lookup,a] using found)
    · by_cases b : j < k
      · exact ih ok.2.2 (by simpa [lookup,a,b] using found)
      · have eq : s = v := by simpa [lookup,a,b] using found
        simpa [eq] using ok.1

theorem from_allB {Q : Pool → Bool} {P : Pool → Prop}
    (rule : ∀ s, Q s = true → P s) {t : Ledger} (h : allB Q t = true) : Every P t := by
  induction t with
  | empty => trivial
  | node k s l r il ir =>
    simp only [allB, Bool.and_eq_true] at h
    exact ⟨rule s h.1.1,il h.1.2,ir h.2⟩

def completeStep (T : Tests) (r : Nat) (prev : Ledger) (s : Pool) : Bool :=
  !(hit T s) && (next T r s).all (fun q => lookup q (code q) prev)

theorem base {T : Tests} {t : Ledger} (ok : allB (fun s => !(hit T s)) t = true) :
    Every (fun s => ¬Accept T 0 s) t := by
  apply from_allB (Q := fun s => !(hit T s)) _ ok
  intro s h accepted
  change hit T s = true at accepted
  simp [accepted] at h

theorem advance {T : Tests} {r : Nat} {prev cur : Ledger}
    (prior : Every (fun s => ¬Accept T r s) prev)
    (ok : allB (completeStep T r prev) cur = true) :
    Every (fun s => ¬Accept T (r+1) s) cur := by
  apply from_allB (Q := completeStep T r prev) _ ok
  intro s h yes
  have eq : (!(hit T s)) = true ∧ (next T r s).all (fun q => lookup q (code q) prev) = true := by
    simpa only [completeStep,Bool.and_eq_true] using h
  rcases yes with yes | ⟨q,mem,acc⟩
  · simp [yes] at eq
  · exact lookup_sound prior (List.all_eq_true.mp eq.2 q mem) acc


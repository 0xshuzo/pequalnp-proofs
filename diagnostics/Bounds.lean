theorem taylor (v : E) (c : ℂ) : f (c • v) =
    65 + c * lin v + c^2 * quad v + c^3 * cub v + c^4 * top4 v := by
  simp [f, PEqualNP.Gct.Helpers.Sigma4Space.permanent_four, base, lin, quad, cub, top4]
  <;> ring

theorem firstTwo (L : Submodule ℂ E) (h : ∀ v ∈ L, f v = 65) (v : E) (hv : v ∈ L) :
    lin v = 0 ∧ quad v = 0 := by
  have eqn (c : ℂ) := (taylor v c).symm.trans (h (c • v) (L.smul_mem c hv))
  have h1 := eqn 1
  have hm := eqn (-1)
  have h2 := eqn 2
  have hn := eqn (-2)
  constructor
  · linear_combination (8 * h1 - 8 * hm - h2 + hn) / 12
  · linear_combination (16 * h1 + 16 * hm - h2 - hn) / 24


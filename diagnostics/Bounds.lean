def polar : E →ₗ[ℂ] Module.Dual ℂ E :=
  LinearMap.mk₂ ℂ (fun t u => ∑ p, (∑ q, kern p q * t q) * u p)
    (fun x y z => by simp [mul_add, sum_add_distrib, add_mul])
    (fun c x y => by simp [mul_left_comm _ c, ← mul_sum, mul_assoc])
    (fun x y z => by simp [mul_add, sum_add_distrib])
    (fun c x y => by simp [mul_left_comm _ c, ← mul_sum])

theorem pol (v w : E) : polar v w = quad (v+w) - quad v - quad w := by
  change (∑ p, (∑ q, kern p q * v q) * w p) = _
  simp [quad, Fintype.sum_prod_type, Fin.sum_univ_four, kern]
  <;> ring

theorem euler (v : E) : polar v base = 3 * lin v := by
  change (∑ p, (∑ q, kern p q * v q) * base p) = _
  simp [base, lin, Fintype.sum_prod_type, Fin.sum_univ_four, kern]
  <;> ring


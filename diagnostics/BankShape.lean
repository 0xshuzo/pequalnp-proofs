abbrev X := V → Bool
abbrev Signal := X → Bool
def single (q : V) : X := fun i => decide (i=q)
def outside (r : V) : X := fun i => !(decide (G i r))
def Up (s : Signal) := ∀ x y, (∀ i, x i=true → y i=true) → s x=true → s y=true
def RowHit (r : V) (x : X) := ∃ i,left i ∧ G i r ∧ x i=true
def Hit (s : Signal) (q : V) := left q ∧ s (single q)=true
def Reject (s : Signal) (r : V) := ¬left r ∧ s (outside r)=false

theorem orients : ∀ u v : V,G u v → (left u ∧ ¬left v) ∨ (left v ∧ ¬left u) := by decide +kernel
theorem reflects : ∀ u v : V,G u v → G v u := by decide +kernel
theorem square : ∀ r t : V,r≠t → ∀ p : V,G p r → G p t → ∀ q : V,G q r → G q t → p=q := by decide +kernel

theorem supported {s : Signal} (up : Up s) {q r : V} (hit : Hit s q) (reject : Reject s r) : G q r := by
  classical
  by_contra ne
  have on : s (outside r)=true := up _ _ (by
    intro i yes
    have e : i=q := by simpa [single] using yes
    subst i
    simp [outside,ne]) hit.2
  rw [reject.2] at on
  contradiction

theorem chooseCenter {s : Signal} (up : Up s) : ∃ v : V,∀ q r,Hit s q → Reject s r → v=q ∨ v=r := by
  classical
  by_cases a : ∃ q,Hit s q
  · obtain ⟨q,hit⟩ := a
    by_cases b : ∃ p,Hit s p ∧ p≠q
    · obtain ⟨p,hp,ne⟩ := b
      by_cases c : ∃ r,Reject s r
      · obtain ⟨r,hr⟩ := c
        refine ⟨r,?_⟩
        intro i t _ ht
        right
        by_contra diff
        exact ne (square r t diff p (supported up hp hr) (supported up hp ht) q
          (supported up hit hr) (supported up hit ht))
      · exact ⟨q,fun _ t _ ht => False.elim (c ⟨t,ht⟩)⟩
    · refine ⟨q,?_⟩
      intro p r hp _
      left
      by_contra ne
      exact b ⟨p,hp,Ne.symm ne⟩
  · exact ⟨0,fun q _ hp _ => False.elim (a ⟨q,hp⟩)⟩

theorem decoderSupply {k : Nat} (s : Fin k → Signal) (read : V → (Fin k→Bool) → Bool)
    (order : ∀ r x y,(∀ j,x j=true → y j=true) → read r x=true → read r y=true)
    (correct : ∀ r,¬left r → ∀ x,read r (fun j=>s j x)=true ↔ RowHit r x)
    {q r : V} (pt : left q) (ln : ¬left r) (e : G q r) : ∃ j,Hit (s j) q ∧ Reject (s j) r := by
  classical
  by_contra none
  have sub : ∀ j,s j (single q)=true → s j (outside r)=true := by
    intro j sj
    cases hj : s j (outside r) with
    | false => exact False.elim (none ⟨j,⟨pt,sj⟩,ln,hj⟩)
    | true => rfl
  have yes := (correct r ln (single q)).mpr ⟨q,pt,e,by simp [single]⟩
  obtain ⟨i,_,edge,live⟩ := (correct r ln (outside r)).mp (order r _ _ sub yes)
  simp [outside,edge] at live

theorem bankCenters {k : Nat} (s : Fin k → Signal) (up : ∀j,Up (s j))
    (read : V → (Fin k→Bool) → Bool)
    (order : ∀ r x y,(∀ j,x j=true → y j=true) → read r x=true → read r y=true)
    (correct : ∀ r,¬left r → ∀ x,read r (fun j=>s j x)=true ↔ RowHit r x) :
    ∃ f : Fin k → V, (∀ j q r,Hit (s j) q → Reject (s j) r → f j=q ∨ f j=r) ∧
      Covers (Finset.univ.image f) ∧ (Finset.univ.image f).card ≤ k := by
  classical
  choose f tagged using fun j=>chooseCenter (up j)
  refine ⟨f,tagged,?_,?_⟩
  · have oriented (q r : V) (pt : left q) (ln : ¬left r) (edge : G q r) :
        q ∈ Finset.univ.image f ∨ r ∈ Finset.univ.image f := by
      obtain ⟨j,a,b⟩ := decoderSupply s read order correct pt ln edge
      exact (tagged j q r a b).elim
        (fun e=>Or.inl (Finset.mem_image.mpr ⟨j,Finset.mem_univ _,e⟩))
        (fun e=>Or.inr (Finset.mem_image.mpr ⟨j,Finset.mem_univ _,e⟩))
    intro a b h
    rcases orients a b h with ⟨p,l⟩|⟨p,l⟩
    · exact oriented a b p l h
    · exact (oriented b a p l (reflects a b h)).symm
  · have h : (Finset.univ.image f).card ≤ (Finset.univ : Finset (Fin k)).card := Finset.card_image_le
    simpa using h

theorem narrow {k : Nat} (s : Fin k → Signal) (up : ∀j,Up (s j))
    (read : V → (Fin k→Bool) → Bool)
    (order : ∀ r x y,(∀ j,x j=true → y j=true) → read r x=true → read r y=true)
    (correct : ∀ r,¬left r → ∀ x,read r (fun j=>s j x)=true ↔ RowHit r x) :
    ∃ f : Fin k → V, (∀ j q r,Hit (s j) q → Reject (s j) r → f j=q ∨ f j=r) ∧
      21 ≤ k ∧
      (k ≤ 23 → (pts (missed (Finset.univ.image f))).card=0 ∨ (lns (missed (Finset.univ.image f))).card=0) ∧
      (k ≤ 26 → (pts (missed (Finset.univ.image f))).card≤1 ∨ (lns (missed (Finset.univ.image f))).card≤1) := by
  obtain ⟨f,tag,cover,size⟩ := bankCenters s up read order correct
  obtain ⟨a,b,c,_,_⟩ := prices cover
  refine ⟨f,tag,by omega,?_,?_⟩
  · intro h
    omega
  · intro h
    omega


theorem starts : ∀ v : V, left v → stored 0 v = true := by decide +kernel
def Envelope (I : Finset V) := ∃ r : R, ∃ e : V ≃ V, Valid e ∧ ∀ v∈I,e v∈zone r
theorem build (P Q : Finset V) (pts : ∀v∈P,left v) (ls : ∀v∈Q,¬left v)
    (none : ∀a∈P,∀b∈Q,¬G a b) : Envelope (P ∪ Q) := by
  classical
  induction Q using Finset.induction_on with
  | empty =>
    refine ⟨0,Equiv.refl V,validId,?_⟩
    intro v hv
    exact (memZone _ _).mpr (starts v (pts v (by simpa using hv)))
  | @insert w Q hw ih =>
    obtain ⟨r,e,good,env⟩ := ih (fun v hv => ls v (Finset.mem_insert_of_mem hv))
      (fun a ha b hb => none a ha b (Finset.mem_insert_of_mem hb))
    have right : ¬left (e w) := fun hl => ls w (Finset.mem_insert_self _ _) ((good.side _).mp hl)
    have low : 21≤(e w).val := by simpa [left] using right
    let l : L := ⟨(e w).val-21,by have := (e w).isLt; omega⟩
    have el : e w = line l := Fin.ext (by dsimp [line,l]; omega)
    let k := label r l
    refine ⟨nextR r l,e.trans (perm k), @validComp (fun x => e x) (action k) good (actionValid k),?_⟩
    intro v hv
    change action (label r l) (e v) ∈ zone (nextR r l)
    apply transitions
    rcases Finset.mem_union.mp hv with pv | qv
    · right
      refine ⟨env v (Finset.mem_union_left _ pv),?_⟩
      rintro ⟨_,a⟩
      exact none v pv w (Finset.mem_insert_self _ _) ((good.adj v w).mp (by simpa only [el] using a))
    · rcases Finset.mem_insert.mp qv with h | q
      · subst v
        exact Or.inl el
      · exact Or.inr ⟨env v (Finset.mem_union_right _ q),fun hh =>
          ls v (Finset.mem_insert_of_mem q) ((good.side v).mp hh.1)⟩

theorem envelope {I : Finset V} (ind : ∀i∈I,∀j∈I,¬G i j) : Envelope I := by
  classical
  let P := I.filter left
  let Q := I.filter fun v => ¬left v
  have union : P∪Q=I := by ext i; simp [P,Q]; tauto
  rw [←union]
  exact build P Q (fun _ h => (Finset.mem_filter.mp h).2)
    (fun _ h => (Finset.mem_filter.mp h).2)
    (fun _ h _ h' => ind _ (Finset.mem_filter.mp h).1 _ (Finset.mem_filter.mp h').1)


def pts (S : Finset V) := S.filter left
def lns (S : Finset V) := S.filter (fun v => ¬left v)
theorem bounds : ∀ r : R,
    (zone r).card ≤ 21 ∧
    (1 ≤ (pts (zone r)).card → 1 ≤ (lns (zone r)).card → (zone r).card ≤ 18) ∧
    (2 ≤ (pts (zone r)).card → 2 ≤ (lns (zone r)).card → (zone r).card ≤ 15) ∧
    (3 ≤ (pts (zone r)).card → 3 ≤ (lns (zone r)).card → (zone r).card ≤ 13) ∧
    (4 ≤ (pts (zone r)).card → 4 ≤ (lns (zone r)).card → (zone r).card ≤ 12) := by decide +kernel

theorem envelopeSizes {I : Finset V} (h : Envelope I) :
    ∃ r : R, I.card ≤ (zone r).card ∧ (pts I).card ≤ (pts (zone r)).card ∧
      (lns I).card ≤ (lns (zone r)).card := by
  classical
  obtain ⟨r,e,good,sub⟩ := h
  have all : I.image e ⊆ zone r := by
    rintro _ hv
    obtain ⟨i,hi,rfl⟩ := Finset.mem_image.mp hv
    exact sub i hi
  have p : (pts I).image e ⊆ pts (zone r) := by
    rintro _ hv
    obtain ⟨i,hi,rfl⟩ := Finset.mem_image.mp hv
    obtain ⟨a,b⟩ := Finset.mem_filter.mp hi
    exact Finset.mem_filter.mpr ⟨sub i a,(good.side i).mpr b⟩
  have q : (lns I).image e ⊆ lns (zone r) := by
    rintro _ hv
    obtain ⟨i,hi,rfl⟩ := Finset.mem_image.mp hv
    obtain ⟨a,b⟩ := Finset.mem_filter.mp hi
    exact Finset.mem_filter.mpr ⟨sub i a,fun z => b ((good.side i).mp z)⟩
  have ac := Finset.card_le_card all
  have pc := Finset.card_le_card p
  have qc := Finset.card_le_card q
  refine ⟨r,?_⟩
  simpa only [Finset.card_image_of_injective _ e.injective] using And.intro ac (And.intro pc qc)

def Covers (C : Finset V) := ∀ a b, G a b → a ∈ C ∨ b ∈ C
def missed (C : Finset V) : Finset V := Finset.univ \ C

theorem prices {C : Finset V} (cover : Covers C) :
    21 ≤ C.card ∧
    (1 ≤ (pts (missed C)).card → 1 ≤ (lns (missed C)).card → 24 ≤ C.card) ∧
    (2 ≤ (pts (missed C)).card → 2 ≤ (lns (missed C)).card → 27 ≤ C.card) ∧
    (3 ≤ (pts (missed C)).card → 3 ≤ (lns (missed C)).card → 29 ≤ C.card) ∧
    (4 ≤ (pts (missed C)).card → 4 ≤ (lns (missed C)).card → 30 ≤ C.card) := by
  classical
  have env : Envelope (missed C) := envelope (by
    intro i hi j hj edge
    exact (cover i j edge).elim (Finset.mem_sdiff.mp hi).2 (Finset.mem_sdiff.mp hj).2)
  obtain ⟨r,total,p,q⟩ := envelopeSizes env
  have split : (missed C).card+C.card=42 := by
    simpa [missed] using Finset.card_sdiff_add_card_eq_card (Finset.subset_univ C)
  obtain ⟨a,b,c,d,k⟩ := bounds r
  exact ⟨by omega,fun x y => by have := b (by omega) (by omega); omega,
    fun x y => by have := c (by omega) (by omega); omega,
    fun x y => by have := d (by omega) (by omega); omega,
    fun x y => by have := k (by omega) (by omega); omega⟩


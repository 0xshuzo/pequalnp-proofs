def pinned {n : Nat} (f : (Fin n → Bool) → Bool) (p : Fin n) (b : Bool) :=
  fun x => f (Function.update x p b)
def flips {n : Nat} (f : (Fin n → Bool) → Bool) (p : Fin n) :=
  ∃ x, f (Function.update x p (!(x p))) ≠ f x
def varies {n : Nat} (f : (Fin n → Bool) → Bool) := ∃ x y, f x ≠ f y

theorem one {n m k : Nat} (f : (Fin (n+1) → Bool) → Bool) (g : (Fin m → Bool) → Bool)
    (p : Fin (n+1)) (proj : Fin (n+1) → Fin m)
    (dep : flips f p) (surv : varies (pinned f p false))
    (eqn : ∀ x, pinned f p false (x ∘ proj) = g x)
    (core : ¬ HasCircuitSize m g k) : ¬ HasCircuitSize (n+1) f (k+1) := by
  intro h
  have next := Base.Forest.one_gate_at n f p false k dep surv h
  have mapped := Base.PermInputs.relabel_size proj (pinned f p false) k next
  have eq : (fun x => pinned f p false (x ∘ proj)) = g := funext eqn
  rw [eq] at mapped
  exact core mapped

theorem ear {n m k : Nat} (f : (Fin (n+1) → Bool) → Bool) (g : (Fin m → Bool) → Bool)
    (p u : Fin (n+1)) (proj : Fin (n+1) → Fin m)
    (pd : flips f p) (ps : ∀ b, varies (pinned f p b))
    (ud : ∀ b, flips (pinned f p b) u)
    (us : ∀ b, varies (pinned (pinned f p b) u false))
    (eqn : ∀ b x, pinned (pinned f p b) u false (x ∘ proj) = g x)
    (core : ¬ HasCircuitSize m g k) : ¬ HasCircuitSize (n+1) f (k+3) := by
  intro h
  obtain ⟨b,t,hcost,hfirst⟩ := Base.PermInputs.gate_elim_at n f p (k+3) pd ps h
  obtain ⟨C,fan,size,ev⟩ := hfirst
  have hsmall : HasCircuitSize (n+1) (pinned f p b) (k+1) :=
    ⟨C,fan,size.trans (by omega),ev⟩
  have next := Base.Forest.one_gate_at n (pinned f p b) u false k (ud b) (us b) hsmall
  have mapped := Base.PermInputs.relabel_size proj (pinned (pinned f p b) u false) k next
  have eq : (fun x => pinned (pinned f p b) u false (x ∘ proj)) = g := funext (eqn b)
  rw [eq] at mapped
  exact core mapped


private theorem good (i : Fin 16512) : goodB i.val=true := by
  have h := List.all_eq_true.mp blocks (i.val/128) (List.mem_range.mpr (by omega))
  have h' := List.all_eq_true.mp h (i.val%128) (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have eq : 128*(i.val/128)+i.val%128=i.val := by omega
  simpa only [eq] using h'

private theorem ordered : StrictMono (fun i : Fin 16512 => readMask i.val) := by
  apply Fin.strictMono_iff_lt_succ.mpr
  intro i
  have h := (Bool.and_eq_true_iff.mp (good i.succ)).2
  have p := of_decide_eq_true h
  change i.val+1=0 ∨ readMask (i.val+1-1)<readMask (i.val+1) at p
  simpa using p

private theorem close (i : Fin 16512) (v : Fin 40) :
    (readMask i.val).testBit v.val = (readMask i.val &&& nbr v == 0) := by
  have h := (Bool.and_eq_true_iff.mp (good i)).1
  have q := List.all_eq_true.mp h v (by simp)
  exact beq_iff_eq.mp q

private theorem hiZero (i : Nat) (w : Nat) (h : 40≤w) : (readMask i).testBit w=false := by
  simp [readMask,Nat.testBit_and,Nat.testBit_two_pow_sub_one,show ¬ w<40 by omega]

private theorem nbr_sym : ∀ u v : Fin 40, (nbr u).testBit v.val=true ↔
    (u.val,v.val)∈listed ∨ (v.val,u.val)∈listed := by decide +kernel

private theorem false_on (i : Fin 16512) (u v : Fin 40)
    (e : (u.val,v.val)∈listed) (hu : (readMask i.val).testBit u.val = true) :
    (readMask i.val).testBit v.val = false := by
  have h := (close i u).symm.trans hu
  have z : readMask i.val &&& nbr u = 0 := beq_iff_eq.mp h
  have p := congrArg (fun k : Nat => k.testBit v.val) z
  have ne := (nbr_sym u v).2 (Or.inl e)
  simpa [Nat.testBit_and,ne] using p

private theorem true_on {i j : Fin 16512} (neq : i≠j) :
    ∃ u v : Fin 40, (u.val,v.val)∈listed ∧
      ((readMask i.val).testBit u.val || (readMask j.val).testBit u.val)=true ∧
      ((readMask i.val).testBit v.val || (readMask j.val).testBit v.val)=true := by
  have differ : ∃ v : Fin 40, (readMask i.val).testBit v.val ≠ (readMask j.val).testBit v.val := by
    by_contra! no
    apply neq; apply ordered.injective; apply Nat.eq_of_testBit_eq; intro k
    by_cases hk : k<40
    · exact no ⟨k,hk⟩
    · rw [hiZero _ _ (by omega),hiZero _ _ (by omega)]
  obtain ⟨u,du⟩ := differ
  have make (a b : Fin 16512) (xa : (readMask a.val).testBit u.val=true)
      (xb : (readMask b.val).testBit u.val=false) : ∃ v : Fin 40,
      ((u.val,v.val)∈listed ∨ (v.val,u.val)∈listed) ∧ (readMask b.val).testBit v.val=true := by
    have nz : readMask b.val &&& nbr u ≠ 0 := by
      intro eq
      have on := close b u; simp [eq,xb] at on
    have wit : ∃ v : Fin 40, (readMask b.val &&& nbr u).testBit v.val=true := by
      by_contra! no
      apply nz; apply Nat.eq_of_testBit_eq; intro k
      by_cases hk : k<40
      · simpa using Bool.eq_false_of_not_eq_true (no ⟨k,hk⟩)
      · simp [Nat.testBit_and,hiZero _ _ (by omega : 40≤k)]
    obtain ⟨v,hv⟩ := wit
    rw [Nat.testBit_and,Bool.and_eq_true] at hv
    exact ⟨v,(nbr_sym u v).1 hv.2,hv.1⟩
  cases a : (readMask i.val).testBit u.val <;> cases b : (readMask j.val).testBit u.val <;> try simp_all
  · obtain ⟨v,h|h,vv⟩ := make j i b a
    · exact ⟨u,v,h,by simp [b],by simp [vv]⟩
    · exact ⟨v,u,h,by simp [vv],by simp [b]⟩
  · obtain ⟨v,h|h,vv⟩ := make i j a b
    · exact ⟨u,v,h,by simp [a],by simp [vv]⟩
    · exact ⟨v,u,h,by simp [vv],by simp [a]⟩

theorem fifteen_ands (C : Circuit) (fan : Monotone2 C)
    (rep : ∀ x : Fin 40 → Bool, C.eval (List.ofFn x)=true ↔
      ∃ u v : Fin 40, (u.val,v.val)∈listed ∧ x u=true ∧ x v=true) : 15 ≤ C.gates.countP andB := by
  let rows (i : Fin 16512) : Fin 40 → Bool := fun v => (readMask i.val).testBit v.val
  have lo := count_ands C fan rows (by
    intro i; apply Bool.eq_false_iff.mpr; intro bad
    obtain ⟨u,v,uv,hu,hv⟩ := (rep _).1 bad
    exact Bool.noConfusion (hv.symm.trans (false_on i u v uv hu))) (by
    intro i j ne; exact (rep _).2 (true_on ne))
  by_contra! small
  have top : 2^(C.gates.countP andB) ≤ 2^14 := Nat.pow_le_pow_right (by decide) (by omega)
  omega
end PEqualNP.Outside.L_meta_9804.FalseCodes

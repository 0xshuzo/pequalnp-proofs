def readMask (i : Nat) : Nat := ((slab (i/32)) >>> (40*(i%32))) &&& (2^40-1)
def nbr (i : Fin 40) : Nat := (lookupMasks.getD i.val 0)
def closedB (m : Nat) : Bool := (List.finRange 40).all fun v =>
  m.testBit v.val == (m &&& nbr v == 0)
def orderedB (i : Nat) : Bool := decide (i=0 ∨ readMask (i-1) < readMask i)
def goodB (i : Nat) := closedB (readMask i) && orderedB i
def blockB (b : Nat) := (List.range 128).all fun i => goodB (128*b+i)


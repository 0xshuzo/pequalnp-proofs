import PEqualNP.Defs

namespace SignedBoundary9768

set_option maxRecDepth 10000
set_option maxHeartbeats 0

/-- A monotone predicate is generated by a family of lower witnesses. -/
def Generated {α : Type*} [PartialOrder α] (p : α → Prop) (P : Set α) :=
  ∀ x, p x ↔ ∃ a ∈ P, a ≤ x

/-- Upper witnesses extend every negative input and are themselves negative. -/
def NegativeCover {α : Type*} [PartialOrder α] (p : α → Prop) (N : Set α) :=
  (∀ y ∈ N, ¬ p y) ∧ ∀ x, ¬ p x → ∃ y ∈ N, x ≤ y

/-- Cutting a monotone control wire before its NOT leaves a function monotone
on each of the two faces. This formulation permits arbitrary fanout. -/
def FaceMono {α : Type*} [PartialOrder α] (h g : α → Prop) :=
  ∀ ⦃x y⦄, x ≤ y → (h x ↔ h y) → g x → g y

theorem generated_mono {α : Type*} [PartialOrder α] {p : α → Prop} {P : Set α}
    (hp : Generated p P) {x y : α} (hxy : x ≤ y) (hx : p x) : p y := by
  obtain ⟨a, ha, hax⟩ := (hp x).mp hx
  exact (hp y).mpr ⟨a, ha, hax.trans hxy⟩

/-- Four finite families suffice even when the complemented control is an
internally computed monotone function. Joins repair positive witnesses that
lie on the wrong face, and meets repair negative witnesses. -/
theorem complete {α : Type*} [Lattice α] {f h g : α → Prop} {E I T J : Set α}
    (ef : Generated f E) (ni : NegativeCover f I)
    (th : Generated h T) (nj : NegativeCover h J) (gm : FaceMono h g)
    (p₀ : ∀ e ∈ E, g e) (p₁ : ∀ e ∈ E, ∀ t ∈ T, g (e ⊔ t))
    (n₀ : ∀ i ∈ I, ¬ g i) (n₁ : ∀ i ∈ I, ∀ j ∈ J, ¬ g (i ⊓ j)) :
    ∀ x, g x ↔ f x := by
  intro x
  constructor
  · intro gx
    by_contra nfx
    obtain ⟨i, hi, hxi⟩ := ni.2 x nfx
    by_cases hix : h x
    · exact n₀ i hi (gm hxi ⟨generated_mono th hxi, fun _ => hix⟩ gx)
    · obtain ⟨j, hj, hxj⟩ := nj.2 x hix
      have nhij : ¬ h (i ⊓ j) := fun hh => nj.1 j hj (generated_mono th inf_le_right hh)
      exact n₁ i hi j hj (gm (le_inf hxi hxj) ⟨fun hx => (hix hx).elim,
        fun hh => (nhij hh).elim⟩ gx)
  · intro fx
    obtain ⟨e, he, hex⟩ := (ef x).mp fx
    by_cases hhx : h x
    · obtain ⟨t, ht, htx⟩ := (th x).mp hhx
      have ht' : h (e ⊔ t) := (th _).mpr ⟨t, ht, le_sup_right⟩
      exact gm (sup_le hex htx) ⟨fun _ => hhx, fun _ => ht'⟩ (p₁ e he t ht)
    · have nhe : ¬ h e := fun hh => hhx (generated_mono th hex hh)
      exact gm hex ⟨fun hh => (nhe hh).elim, fun hh => (hhx hh).elim⟩ (p₀ e he)

abbrev Input := Fin 42 → Bool

def pairInput (q : Fin 42 × Fin 42) : Input :=
  fun i => decide (i = q.1 ∨ i = q.2)

theorem pair_le (q : Fin 42 × Fin 42) (x : Input) :
    pairInput q ≤ x ↔ x q.1 = true ∧ x q.2 = true := by
  constructor
  · intro h
    have h₁ := h q.1
    have h₂ := h q.2
    simpa [pairInput] using And.intro h₁ h₂
  · rintro ⟨h₁, h₂⟩ i
    by_cases hi : i = q.1
    · subst i
      simp [pairInput, h₁]
    · by_cases hj : i = q.2
      · subst i
        simp [pairInput, h₂]
      · simp [pairInput, hi, hj]

def edges : List (Fin 42 × Fin 42) := [(0,26),(0,28),(0,38),(0,41),(1,21),(1,22),(1,27),(1,29),(1,39),(2,22),(2,23),(2,28),(2,30),(2,40),(3,23),(3,24),(3,29),(3,31),(3,41),(4,21),(4,24),(4,25),(4,30),(4,32),(5,22),(5,25),(5,26),(5,31),(5,33),(6,23),(6,26),(6,27),(6,32),(6,34),(7,24),(7,27),(7,28),(7,33),(7,35),(8,25),(8,28),(8,29),(8,34),(8,36),(9,26),(9,29),(9,30),(9,35),(9,37),(10,27),(10,30),(10,31),(10,36),(10,38),(11,28),(11,31),(11,32),(11,37),(11,39),(12,29),(12,32),(12,33),(12,38),(12,40),(13,30),(13,33),(13,34),(13,39),(13,41),(14,21),(14,31),(14,34),(14,35),(14,40),(15,22),(15,32),(15,35),(15,36),(15,41),(16,21),(16,23),(16,33),(16,36),(16,37),(17,22),(17,24),(17,34),(17,37),(17,38),(18,23),(18,25),(18,35),(18,38),(18,39),(19,24),(19,26),(19,36),(19,39),(19,40),(20,25),(20,27),(20,37),(20,40),(20,41)]


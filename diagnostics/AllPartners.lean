def image (i : Move) (r : Nat) : Nat :=
  let e := pairs[i.val]?.getD (0,0)
  if e.1 == e.2 then r ||| 2^e.1 else
  if r.testBit e.1 == r.testBit e.2 then r else r ^^^ (2^e.1 ||| 2^e.2)
def probe (k : Probe) : Nat := probes[k.val]?.getD 0
def leaks (i : Move) (k : Probe) : Bool := (spectra[i.val]?.getD 0).testBit k.val

set_option maxHeartbeats 0 in
theorem negatives : ∀ k : Probe, grid (probe k) = false := by decide +kernel
set_option maxHeartbeats 0 in
theorem positives : ∀ (i : Move) (k : Probe), leaks i k = true →
    grid (image i (probe k)) = true := by decide +kernel
def spec (i : Move) : Nat := spectra[i.val]?.getD 0
set_option maxHeartbeats 0 in
theorem bounded : ∀ i : Move, spec i < 2^31 := by decide +kernel
set_option maxHeartbeats 0 in
theorem pairHit : ∀ i j : Move, spec i &&& spec j ≠ 0 := by decide +kernel

theorem common (i j : Move) : ∃ k : Probe, leaks i k = true ∧ leaks j k = true := by
  classical
  by_contra miss
  apply pairHit i j
  apply Nat.eq_of_testBit_eq
  intro k
  rw [Nat.testBit_and]
  by_cases hk : k < 31
  · have no := fun (a : (spec i).testBit k = true) (b : (spec j).testBit k = true) =>
      miss ⟨⟨k,hk⟩,a,b⟩
    cases e : (spec i).testBit k <;> cases f : (spec j).testBit k <;> simp_all
  · have le : 31 ≤ k := by omega
    rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le (bounded i) (Nat.pow_le_pow_right (by norm_num) le))]
    simp

def invariant (f : Nat → Bool) (i : Move) : Prop := ∀ r, f (image i r) = f r

theorem forbid (f g : Nat → Bool) (rep : ∀ r, (f r && g r) = grid r)
    (i j : Move) (h : invariant f i) (k : invariant g j) : False := by
  obtain ⟨r, hi, hj⟩ := common i j
  have a := (rep (image i (probe r))).trans (positives i r hi)
  have b := (rep (image j (probe r))).trans (positives j r hj)
  simp only [Bool.and_eq_true] at a b
  have a' : f (probe r) = true := (h (probe r)).symm.trans a.1
  have b' : g (probe r) = true := (k (probe r)).symm.trans b.2
  have eq := rep (probe r)
  rw [a', b', negatives] at eq
  cases eq

theorem oneAsymmetric (f g : Nat → Bool) (rep : ∀ r, (f r && g r) = grid r) :
    (∀ i : Move, ¬ invariant f i) ∨ (∀ j : Move, ¬ invariant g j) := by
  classical
  by_cases h : ∃ i : Move, invariant f i
  · obtain ⟨i,hi⟩ := h
    exact Or.inr (fun j hj => forbid f g rep i j hi hj)
  · exact Or.inl (fun i hi => h ⟨i,hi⟩)

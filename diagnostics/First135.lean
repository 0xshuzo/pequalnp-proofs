def score (i : I) (t : T) : Int := Int.ofNat (((margins[i.val]!) >>> (3*t.val)) % 8) - 4
def own (i : I) (t : T) := (masks[i.val]!).testBit (owners[t.val]!)
def first (k : Key) : I := ⟨k.val,by have := k.isLt; omega⟩
def atT (n : Nat) : T := ⟨n%60,Nat.mod_lt _ (by decide)⟩
def atI (n : Nat) : I := ⟨n%135,Nat.mod_lt _ (by decide)⟩
def lft (i : I) := atT (lhsTab[i.val]!)
def rgt (i : I) := atT (rhsTab[i.val]!)
def half (i : I) := atI (halfTab[i.val]!)
def ceilD (x : Int) (d : Nat) := -((-x)/(d:Int))
def mark (k : Key) : B := fun t=>decide (owners[t.val]!=k.val) == false
def rawGap (k : Key) (t : T) := gap (positions[t.val]!) (raw k)
def united (a b : B) : B := fun t=>a t || b t
def sep (a b : B) := ∀ t,a t=true → b t=false
def plus (a b : Scores) : Scores := fun t=>a t+b t
def cut (a : Scores) (d : Nat) : Scores := fun t=>ceilD (a t) d
def keeps (b : B) (a : Scores) := ∀ t,b t=true → 0<a t

theorem inputs : ∀ k : Key, ∀ t : T, own (first k) t=mark k t ∧ score (first k) t=rawGap k t ∧
    (mark k t=false → rawGap k t≤0) := by decide +kernel

theorem halves : ∀ i : I, let z := score i (lft i)-score i (rgt i)
  (z=1 ∨ z=2) ∧ (z=2 → ∀ t,own (half i) t=own i t ∧ score (half i) t=ceilD (score i t) 2) := by
  decide +kernel

def checkPair (i j : I) : Prop :=
  let c := (((codes[i.val]!) >>> (8*j.val)) % 256)
  if c<60 then own i (atT c)=true ∧ own j (atT c)=true
  else if c<120 then let t := atT (c-60)
                     united (own i) (own j) t=true ∧ plus (score i) (score j) t≤0
  else let z := atI (c-120)
       ∀ t, own z t=united (own i) (own j) t ∧ score z t=plus (score i) (score j) t
instance (i j) : Decidable (checkPair i j) := by unfold checkPair; dsimp only; infer_instance

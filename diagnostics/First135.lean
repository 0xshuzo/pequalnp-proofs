      have hi := i.isLt
      omega
    simpa only [idx] using part88 k j
  by_cases h96 : i.val < 104
  · let k : Fin 8 := ⟨i.val-96,by omega⟩
    have idx : atI (96+k.val)=i := by
      apply Fin.ext
      change (96+(i.val-96))%135=i.val
      have hi := i.isLt
      omega
    simpa only [idx] using part96 k j
  by_cases h104 : i.val < 112
  · let k : Fin 8 := ⟨i.val-104,by omega⟩
    have idx : atI (104+k.val)=i := by
      apply Fin.ext
      change (104+(i.val-104))%135=i.val
      have hi := i.isLt
      omega
    simpa only [idx] using part104 k j
  by_cases h112 : i.val < 120
  · let k : Fin 8 := ⟨i.val-112,by omega⟩
    have idx : atI (112+k.val)=i := by
      apply Fin.ext
      change (112+(i.val-112))%135=i.val
      have hi := i.isLt
      omega
    simpa only [idx] using part112 k j
  by_cases h120 : i.val < 128
  · let k : Fin 8 := ⟨i.val-120,by omega⟩
    have idx : atI (120+k.val)=i := by
      apply Fin.ext
      change (120+(i.val-120))%135=i.val
      have hi := i.isLt
      omega
    simpa only [idx] using part120 k j
  by_cases h128 : i.val < 135
  · let k : Fin 7 := ⟨i.val-128,by omega⟩
    have idx : atI (128+k.val)=i := by
      apply Fin.ext
      change (128+(i.val-128))%135=i.val
      have hi := i.isLt
      omega
    simpa only [idx] using part128 k j
  have := i.isLt
  omega

theorem addClosed {i j : I} (dis : sep (own i) (own j))
    (yes : keeps (united (own i) (own j)) (plus (score i) (score j))) :
    ∃ z, own z=united (own i) (own j) ∧ score z=plus (score i) (score j) := by
  have h := pairs i j
  unfold checkPair at h
  dsimp only at h
  split at h
  · have z := dis _ h.1
    rw [h.2] at z
    contradiction
  · split at h
    · have z := yes _ h.1
      omega
    · exact ⟨_,funext fun t=>(h t).1,funext fun t=>(h t).2⟩

theorem ceilNonpos {v : Int} {d : Nat} (b : v≤0) : ceilD v d≤0 := by
  unfold ceilD
  have h := Int.ediv_nonneg (show 0≤ -v by omega) (show 0≤(d:Int) by positivity)
  omega

theorem divClosed {i : I} {d : Nat} (pos : 0<d) (cons : ∀ s t,(d:Int) ∣ score i s-score i t) :
    ∃ z, own z=own i ∧ score z=cut (score i) d := by
  obtain ⟨small,halfGood⟩ := halves i
  have div := cons (lft i) (rgt i)
  have positive : 0 < score i (lft i)-score i (rgt i) := by omega
  have le := Int.le_of_dvd positive div
  have bounds : d=1 ∨ d=2 := by omega
  rcases bounds with rfl|rfl
  · exact ⟨i,rfl,funext fun t=>by simp [cut,ceilD]⟩
  · have h : score i (lft i)-score i (rgt i)=2 := by omega
    exact ⟨half i,funext fun t=>(halfGood h t).1,funext fun t=>(halfGood h t).2⟩

inductive Tree : B → Scores → Prop
  | ax (k : Key) : Tree (mark k) (rawGap k)
  | add {a b p q} (l : Tree a p) (r : Tree b q) (dis : sep a b) : Tree (united a b) (plus p q)
  | div {a p} (s : Tree a p) (d : Nat) (pos : 0<d) (congruent : ∀ x y,(d:Int) ∣ p x-p y) :
      Tree a (cut p d)

theorem classify {b p} (tree : Tree b p) :
    (∀ t,b t=false → p t≤0) ∧ (keeps b p → ∃ i, own i=b ∧ score i=p) := by
  induction tree with
  | ax k =>
    exact ⟨fun t=>(inputs k t).2.2, fun _=>⟨first k,funext fun t=>(inputs k t).1,
      funext fun t=>(inputs k t).2.1⟩⟩
  | @add a b p q l r dis il ir =>
    constructor
    · intro t off
      have f : a t=false ∧ b t=false := by simpa [united] using off
      exact add_nonpos (il.1 t f.1) (ir.1 t f.2)
    · intro yes
      have ll : keeps a p := by
        intro t h
        have off := ir.1 t (dis t h)
        have both := yes t (by simp [united,h])
        change 0<p t+q t at both
        omega
      have rr : keeps b q := by
        intro t h
        have aoff : a t=false := by
          cases ha : a t with
          | false => rfl
          | true => have z := dis t ha; rw [h] at z; contradiction
        have off := il.1 t aoff
        have both := yes t (by simp [united,h])
        change 0<p t+q t at both
        omega
      obtain ⟨i,rfl,rfl⟩ := il.2 ll
      obtain ⟨j,rfl,rfl⟩ := ir.2 rr
      exact addClosed dis yes
  | @div a p tree d hd dvd ih =>
    constructor
    · intro t off
      exact ceilNonpos (ih.1 _ off)
    · intro good
      have orig : keeps a p := by
        intro t h
        by_contra ne
        have no := ceilNonpos (d:=d) (show p t≤0 by omega)
        have yes := good t h
        change 0<ceilD (p t) d at yes
        omega
      obtain ⟨i,rfl,rfl⟩ := ih.2 orig
      exact divClosed hd dvd

theorem someSafe : ∀ i : I, ∃ t,score i t≤0 := by decide +kernel
theorem treeNoContradiction {b : B} {p : Scores} (h : Tree b p) : ¬ (∀ t,0<p t) := by
  intro allBad
  obtain ⟨i,_,rfl⟩ := (classify h).2 (fun t _=>allBad t)
  obtain ⟨t,f⟩ := someSafe i
  exact (not_lt_of_ge f) (allBad t)


def vec (w : Nat) (e : CPLine V) : Int :=
  ∑ v : V, if w.testBit (3*v.1.val+v.2.val) then e.1 v else 0
def castScores (e : CPLine V) : Scores := fun t=>gap (positions[t.val]!) e
def addLine (a b : CPLine V) : CPLine V := (a.1+b.1,a.2+b.2)
def divLine (e : CPLine V) (d : Nat) : CPLine V := (fun v=>e.1 v / (d:Int),ceilD e.2 d)

theorem scoreAdd (a b : CPLine V) : castScores (addLine a b)=plus (castScores a) (castScores b) := by
  funext t
  let w := positions[t.val]!
  change a.2+b.2-vec w (addLine a b)=(a.2-vec w a)+(b.2-vec w b)
  have vecadd : vec w (addLine a b)=vec w a+vec w b := by
    unfold vec
    rw [←Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro v _
    by_cases h : w.testBit (3*v.1.val+v.2.val)=true <;> simp [h,addLine]
  rw [vecadd]
  ring

theorem multiple (e : CPLine V) (d : Nat) (dv : ∀ v, (d:Int) ∣ e.1 v) (w : Nat) :
    (d:Int)*vec w (divLine e d)=vec w e := by
  unfold vec
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro v _
  by_cases h : (w.testBit (3*v.1.val+v.2.val))=true
  · simp only [h,if_true,divLine,Int.mul_ediv_cancel' (dv v)]
  · simp [h]

theorem consistent (e : CPLine V) (d : Nat) (dv : ∀ v, (d:Int) ∣ e.1 v) :
    ∀ x y,(d:Int) ∣ castScores e x-castScores e y := by
  intro x y
  let u := positions[x.val]!
  let v := positions[y.val]!
  refine ⟨vec v (divLine e d) - vec u (divLine e d),?_⟩
  change e.2-vec u e-(e.2-vec v e)=_
  rw [←multiple e d dv u,←multiple e d dv v]
  ring

theorem scoreDiv (e : CPLine V) (d : Nat) (pos : 0<d) (dv : ∀ v, (d:Int) ∣ e.1 v) :
    castScores (divLine e d)=cut (castScores e) d := by
  funext t
  let p := positions[t.val]!
  change ceilD e.2 d-vec p (divLine e d) = ceilD (e.2-vec p e) d
  rw [←multiple e d dv p]
  unfold ceilD
  have nz : (d:Int)≠0 := by exact_mod_cast (Nat.ne_of_gt pos)
  rw [show -(e.2-(d:Int)*vec p (divLine e d)) = -e.2+vec p (divLine e d)*(d:Int) by ring,
      Int.add_mul_ediv_right _ _ nz]
  ring

inductive Physical : B → CPLine V → Prop
  | ax (k : Key) : Physical (mark k) (raw k)
  | add {a b e f} (l : Physical a e) (r : Physical b f) (dis : sep a b) :
        Physical (united a b) (addLine e f)
  | div {a e} (p : Physical a e) (d : Nat) (pos : 0<d) (dv : ∀ v, (d:Int) ∣ e.1 v) :
        Physical a (divLine e d)

theorem scoresOf {a e} (ph : Physical a e) : Tree a (castScores e) := by
  induction ph with
  | ax k => exact .ax k
  | add l r dis il ir => rw [scoreAdd]; exact .add il ir dis
  | @div a e p d pos dv ih => rw [scoreDiv e d pos dv]; exact .div ih d pos (consistent e d dv)

theorem noPhysicalTree (a : B) : ¬ Physical a ((0 : V→Int),1) := by
  intro h
  apply treeNoContradiction (scoresOf h)
  intro t
  simp [castScores,gap]


def scaleLine (e : CPLine V) (k : Nat) : CPLine V := ((k:Int) • e.1, (k:Int)*e.2)
theorem scoreScale (e : CPLine V) (k : Nat) (t : T) :
    castScores (scaleLine e k) t=(k:Int)*castScores e t := by
  let w := positions[t.val]!
  change (k:Int)*e.2-vec w (scaleLine e k)=(k:Int)*(e.2-vec w e)
  have scaled : vec w (scaleLine e k)=(k:Int)*vec w e := by
    unfold vec
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro v _
    by_cases h : w.testBit (3*v.1.val+v.2.val)=true <;> simp [h,scaleLine,zsmul_eq_mul]
  rw [scaled]
  ring

/-- The rest of the proof may use the interface line repeatedly. Its other
    leaves are required to hold on the owned critical assignments. -/
inductive Context (b : B) (e : CPLine V) : CPLine V → Prop
  | interface : Context b e e
  | outside (f : CPLine V) (ok : ∀ t,b t=true → castScores f t≤0) : Context b e f
  | add {f g} (l : Context b e f) (r : Context b e g) : Context b e (addLine f g)
  | mul {f} (p : Context b e f) (k : Nat) : Context b e (scaleLine f k)
  | div {f} (p : Context b e f) (d : Nat) (pos : 0<d) (dvd : ∀ v,(d:Int) ∣ f.1 v) :
      Context b e (divLine f d)

theorem contextSound {b e f} (c : Context b e f) {t : T} (ht : b t=true)
    (base : castScores e t≤0) : castScores f t≤0 := by
  induction c with
  | interface => exact base
  | outside f ok => exact ok t ht
  | add l r li ri => rw [scoreAdd]; exact add_nonpos li ri
  | mul p k ih => rw [scoreScale]; exact mul_nonpos_of_nonneg_of_nonpos (by positivity) ih
  | div p d pos dvd ih => rw [scoreDiv _ d pos dvd]; exact ceilNonpos ih

theorem interfaceFromRefutation {b e} (build : Physical b e)
    (rest : Context b e ((0 : V→Int),1)) : ∃ i : I, own i=b ∧ score i=castScores e := by
  apply (classify (scoresOf build)).2
  intro t ht
  by_contra no
  have safe := contextSound rest ht (show castScores e t≤0 by omega)
  simp [castScores,gap] at safe

def keys (b : B) : Finset Key :=
  Finset.univ.filter fun k => decide (∃ t : T,mark k t=true ∧ b t=true)
theorem bankWidth : ∀ i : I,(keys (own i)).card≤4 := by decide +kernel
theorem privateAtMostFour {b e} (build : Physical b e)
    (rest : Context b e ((0 : V→Int),1)) : (keys b).card≤4 := by
  obtain ⟨i,eq,_⟩ := interfaceFromRefutation build rest
  simpa only [←eq] using bankWidth i

end Trees9682

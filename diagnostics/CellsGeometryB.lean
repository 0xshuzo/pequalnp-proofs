def transportMasks (m : Nat) (p : List Nat) :=
  let dest := fun i => p.foldl (fun j v => if j=v%16 then v/16 else if j=v/16 then v%16 else j) i
  let lo := (List.range 9).foldl (fun l j => if m.testBit j then l ||| (1 <<< dest j) else l) 0
  let t := m/512-1
  let a := dest (t/9%9)
  let b := dest (t%9)
  if m<512 then lo else lo+512*(1+t/81*81+min a b*9+max a b)
def transportPerms : Array (List Nat) := #[[],perm0,perm1,perm2,perm3,perm4,perm5,perm6,perm7,perm8,perm9,perm10]
def transportEntry (v : Nat) : TransportEntry :=
  let p := transportPerms.getD (v%16) []
  (v/256,v/16%16,transportMasks (v/256) p.reverse,p)

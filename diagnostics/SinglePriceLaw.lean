private def tally (k : Nat) (q : Fin 12) (b : Bool) := (tallyWord[k]! >>> (5*(2*q.val+b.toNat))) % 32
private def signal (m : Nat) := 
  let d := m ||| (m >>> 1)
  let f := d ||| (d >>> 2)
  (d &&& 384307168196689920) ||| ((f ||| (f >>> 2)) &&& 266305)
private def unitScore (s x y k raw : Nat) : Nat :=
  if homogeneous (s &&& x) && homogeneous (s &&& y) then raw else
    let u := apart s x
    let v := apart s y
    let rest := apart u y
    let signalRest := signal rest
    let onBoth := signal u != signalRest && signal v != signalRest
    min k (1 + present rest + onBoth.toNat)
private def singleScore (i k m x y : Nat) (q : Fin 12) (b : Bool) (ref : Option Nat) : Nat :=
  let s := m &&& dirMask q b
  match ref with
  | none => max 1 (unitScore s x y (tally k q b) (sw i q b))
  | some h =>
    let j := h % 4096
    let o := h/4096
    if j < 2618 && o < 144 && permute o s == mask j &&
       fits (permute o (s &&& x)) (one j) (two j) &&
       fits (permute o (s &&& y)) (one j) (two j)
    then wt j else 0
private def singleValues (i k m x y cost layout payload : Nat) : Bool :=
  !homogeneous m && m &&& x != m && m &&& y != m &&
    (List.range 12).all (fun v =>
      let q := Fin.ofNat 12 v
      decide (cost ≤ singleScore i k m x y q false (rowRef i (2*q.val+false.toNat) layout payload) +
        singleScore i k m x y q true (rowRef i (2*q.val+true.toNat) layout payload)))

private def singleRun (i : Nat) := singleValues i (nodesClass i) (mask i) (one i) (two i) (wt i) (refLayout i) (((payloadTable (i/32)))[i % 32]!)
private def windowWidth (h l : Bool) : Nat := if l then 63 else if h then 3 else 0

private def windowBit (h l : Bool) (f : Nat → Bool) : Bool :=
  ((f 0 || f 1) && h) ||
  ((((f 0 || f 1) || (f 2 || f 3)) || ((f 2 || f 3) || (f 4 || f 5))) && l)

private theorem windowLaw : ∀ (r : Fin 64) (h l : Bool),
    windowBit h l r.val.testBit = (r.val &&& windowWidth h l != 0) := by decide +kernel

private def localWidth (n : Nat) :=
  windowWidth ((384307168196689920 : Nat).testBit n) ((266305 : Nat).testBit n)

private theorem signalBit (n m : Nat) :
    (signal m).testBit n = (m &&& (localWidth n <<< n) != 0) := by
  let r : Fin 64 := ⟨(m >>> n) % 64, Nat.mod_lt _ (by decide)⟩
  have low (j : Nat) (hj : j < 6) : r.val.testBit j = m.testBit (n+j) := by
    change (((m >>> n) % 2^6).testBit j) = _
    simp [Nat.testBit_mod_two_pow,Nat.testBit_shiftRight,hj,Nat.add_comm]
  have w := windowLaw r ((384307168196689920 : Nat).testBit n) ((266305 : Nat).testBit n)
  change windowBit _ _ r.val.testBit = (r.val &&& localWidth n != 0) at w
  unfold windowBit at w
  rw [low 0 (by decide),low 1 (by decide),low 2 (by decide),
    low 3 (by decide),low 4 (by decide),low 5 (by decide)] at w
  have reindex : (signal m).testBit n = (r.val &&& localWidth n != 0) := by
    simpa [signal,Nat.testBit_and,Nat.testBit_or,Nat.testBit_shiftRight,
      Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using w
  rw [reindex]
  have sz : localWidth n < 64 := by
    unfold localWidth windowWidth
    split <;> first | decide | (split <;> decide)
  have trunc := PCX150.FastPresent.truncated 6 (m >>> n) (localWidth n) sz
  change r.val &&& localWidth n = (m >>> n) &&& localWidth n at trunc
  rw [trunc,←PCX150.FastPresent.shifted n m (localWidth n)]
  by_cases z : (m >>> n) &&& localWidth n = 0
  · simp [z]
  · simp [z,Nat.shiftLeft_eq]

private def activeLabels (m : Nat) : Finset Nat :=
  (Finset.range 22).filter (fun k => m &&& tagMask k ≠ 0)

private theorem priceCard (m : Nat) : present m = (activeLabels m).card := by
  rw [foldPresent]
  unfold slowTagCount activeLabels
  generalize 22 = n
  induction n with
  | zero => simp
  | succ n ih =>
    rw [List.range_succ,List.foldl_append]
    simp only [List.foldl_cons,List.foldl_nil,ih]
    simp only [Finset.card_filter,Finset.sum_range_succ]
    by_cases yes : m &&& tagMask n = 0 <;> simp [yes]

private theorem allWidths : ∀ n : Fin 60, localWidth n.val ≠ 0 →
    lab[n.val]! < 22 ∧ localWidth n.val <<< n.val = tagMask lab[n.val]! := by
  decide +kernel

private theorem signalCongr {u v : Nat} (same : activeLabels u = activeLabels v) :
    signal u = signal v := by
  apply Nat.eq_of_testBit_eq
  intro n
  rw [signalBit,signalBit]
  by_cases h : n<60
  · by_cases w : localWidth n=0
    · simp [w]
    · obtain ⟨hk,eq⟩ := allWidths ⟨n,h⟩ w
      rw [eq]
      have hm : (lab[n]! ∈ activeLabels u) ↔ (lab[n]! ∈ activeLabels v) := by rw [same]
      simpa [activeLabels,hk] using Bool.eq_iff_iff.mpr (show
        (u &&& tagMask lab[n]! != 0) = true ↔ (v &&& tagMask lab[n]! != 0) = true from by
          simpa [activeLabels,hk] using hm)
  · have off (m : Nat) (bound : m<2^60) : m.testBit n = false :=
      Nat.testBit_lt_two_pow (lt_of_lt_of_le bound (Nat.pow_le_pow_right (by decide : 0<2) (by omega)))
    have z : localWidth n=0 := by
      simp [localWidth,windowWidth,off (384307168196689920 : Nat) (by decide),off (266305 : Nat) (by decide)]
    simp [z]

private theorem labelsMono {u v : Nat}
    (sub : ∀ j, u.testBit j = true → v.testBit j = true) :
    activeLabels u ⊆ activeLabels v := by
  intro k h
  obtain ⟨hk,nonzero⟩ := Finset.mem_filter.mp h
  apply Finset.mem_filter.mpr
  refine ⟨hk,?_⟩
  intro vanish
  apply nonzero
  apply Nat.eq_of_testBit_eq
  intro j
  have both := congrArg (fun t : Nat => t.testBit j) vanish
  simp only [Nat.testBit_and,Nat.zero_testBit] at both ⊢
  cases h' : u.testBit j with
  | false => simp
  | true => simpa [sub j h'] using both

private theorem singleCost (s x y raw A : Nat) (fixed : A = present s) :
    unitScore s x y A raw ≤ baseScore s x y raw := by
  unfold unitScore baseScore
  split
  · exact Nat.le_refl _
  · dsimp only
    let u := apart s x
    let v := apart s y
    let d := apart u y
    have subsets : activeLabels d ⊆ activeLabels u ∧ activeLabels d ⊆ activeLabels v := by
      constructor <;> apply labelsMono <;> intro j <;>
        simp only [u,v,d,apart,Nat.testBit_xor,Nat.testBit_and] <;>
        cases s.testBit j <;> cases x.testBit j <;> cases y.testBit j <;> decide
    have bo (p : Nat) (sub : activeLabels d ⊆ activeLabels p) :
        present d + (signal p != signal d).toNat ≤ present p := by
      rw [priceCard,priceCard]
      by_cases e : signal p = signal d
      · simpa [e] using Finset.card_le_card sub
      · have different : activeLabels d ≠ activeLabels p := fun eq => e (signalCongr eq.symm)
        have less := Finset.card_lt_card (ssubset_of_subset_of_ne sub different)
        simp [e]
        omega
    have fu := bo u subsets.1
    have fv := bo v subsets.2
    change min A (1 + present d + ((signal u != signal d) && (signal v != signal d)).toNat) ≤
      min (present s) (min (1+present u) (min (1+present v) (2+present d)))
    rw [fixed]
    cases eu : (signal u != signal d) <;> cases ev : (signal v != signal d) <;>
      simp only [eu,ev,Bool.false_and,Bool.true_and,Bool.toNat] at * <;> omega

private theorem tallyData : ∀ (k : Fin 48) (q : Fin 12) (b : Bool),
    tally k.val q b = present (rm[k.val]! &&& dirMask q b) := by decide +kernel

private theorem singleSide (i : Nat) (hk : nodesClass i < 48) (x y : Nat)
    (q : Fin 12) (b : Bool) (r : Option Nat) :
    singleScore i (nodesClass i) (mask i) x y q b r ≤ rowScore i (mask i) x y q b r := by
  cases r with
  | some h => exact Nat.le_refl _
  | none =>
    exact max_le_max_left 1 (singleCost _ _ _ _ _ (tallyData ⟨_,hk⟩ q b))

private theorem singleSound (i : Nat) (hk : nodesClass i < 48) (ok : singleRun i=true) :
    nodeOK i=true := by
  have head := Bool.and_eq_true_iff.mp ok
  apply Bool.and_eq_true_iff.mpr
  refine ⟨head.1,List.all_eq_true.mpr ?_⟩
  intro v hv
  let q := Fin.ofNat 12 v
  have pay := of_decide_eq_true (List.all_eq_true.mp head.2 v hv)
  apply decide_eq_true
  exact pay.trans (Nat.add_le_add (singleSide i hk (one i) (two i) q false
    (pickRef i (2*q.val+false.toNat))) (singleSide i hk (one i) (two i) q true
    (pickRef i (2*q.val+true.toNat))))
def panel (beginAt count : Nat) : Bool :=
  (List.range count).all (fun j => singleRun (beginAt+j))
theorem joinPanel (lo n m : Nat) (a : panel lo n = true) (b : panel (lo+n) m = true) :
    panel lo (n+m) = true := by
  apply List.all_eq_true.mpr
  intro i hi
  have h := List.mem_range.mp hi
  by_cases small : i<n
  · exact List.all_eq_true.mp a i (List.mem_range.mpr small)
  · have ok := List.all_eq_true.mp b (i-n) (List.mem_range.mpr (by omega))
    have eq : lo+n+(i-n) = lo+i := by omega
    simpa only [eq] using ok
end PCX150.Scalar

  match g with
  | 0 => ((m <<< 6) &&& 4032) ||| ((m <<< 2) &&& 0x330330330000000) ||| ((m <<< 1) &&& 0x800800800aaa000) ||| (m &&& 844631138893824) ||| ((m >>> 1) &&& 0x400400400555000) ||| ((m >>> 2) &&& 0xcc0cc0cc000000) ||| ((m >>> 6) &&& 63)

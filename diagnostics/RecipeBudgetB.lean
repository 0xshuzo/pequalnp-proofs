def coefs : Array Nat := #[261,284,269,233,199,169]
def nbors : Array Nat := #[18512,4259,8518,17036,3872,13336]
def target := 143
def ca (r : Rec) := readCode r.val % 512
def cb (r : Rec) := (readCode r.val / 512) % 512
def ck (r : Rec) := (readCode r.val / 262144) % 512
def tag (r : Rec) := if 134217728 ≤ readCode r.val then
    (if rowMasks[ck r]! = 0 then sectors[ck r]! else 6) else
    (if rowMasks[ck r]! = 0 then 8 else 7)
def owner (k : Nat) : P := ⟨hubs[k]! % 6, Nat.mod_lt _ (by decide)⟩
def lm (p : P) (k : Nat) :=
  let l := lineMasks[k]!
  if l &&& nbors[p.val]! = l then l else 0
def cm (k : Nat) := rowMasks[k]!
def subm (a b : Nat) := a &&& b = a
instance (a b : Nat) : Decidable (subm a b) := inferInstanceAs (Decidable (_ = _))
def bm (n : Nat) (a : Nat) : Finset (Fin n) := Finset.univ.filter (fun p => a.testBit p.val)

def localCheck (r : Rec) : Prop :=
  (∀ p : P, sectors[ck r]! = p.val →
    subm (lm p (ck r)) (lm p (ca r)) ∨ subm (lm p (ck r)) (lm p (cb r)) ∨
    (tag r = p.val ∧ subm (lm p (ck r)) (lm p (ca r) ||| lm p (cb r)))) ∧
  (cm (ck r) ≠ 0 → cm (ck r) &&& (cm (ck r)-1) ≠ 0 →
    subm (cm (ck r)) (cm (ca r)) ∨ subm (cm (ck r)) (cm (cb r)) ∨
    (tag r = 6 ∧ subm (cm (ck r)) (cm (ca r) ||| cm (cb r)))) ∧
  (∀ p : P, (cm (ck r)).testBit p.val = true →
    (cm (ca r)).testBit p.val = true ∨ (cm (cb r)).testBit p.val = true ∨
      (tag r = 7 ∧ owner (ck r) = p ∧ (ca r = coefs[p.val]! ∨ cb r = coefs[p.val]!)))
instance (r : Rec) : Decidable (localCheck r) := by unfold localCheck; infer_instance

def block (i : Nat) : Bool := (List.range 150).all fun j =>
  if h : 150*i+j < 4105 then decide (localCheck ⟨150*i+j,h⟩) else true
theorem block0 : block 0 = true := by decide +kernel
theorem block1 : block 1 = true := by decide +kernel
theorem block2 : block 2 = true := by decide +kernel

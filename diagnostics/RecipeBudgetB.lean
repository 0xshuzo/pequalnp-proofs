theorem completed (i : Fin 28) : block i.val = true := by
  fin_cases i <;> first | exact block0 | exact block1 | exact block2 | exact block3 | exact block4 | exact block5 | exact block6 | exact block7 | exact block8 | exact block9 | exact block10 | exact block11 | exact block12 | exact block13 | exact block14 | exact block15 | exact block16 | exact block17 | exact block18 | exact block19 | exact block20 | exact block21 | exact block22 | exact block23 | exact block24 | exact block25 | exact block26 | exact block27

theorem localRules (r : Rec) : localCheck r := by
  let i : Fin 28 := ⟨r.val/150,by have h := r.isLt;omega⟩
  have h := completed i
  unfold block at h
  have e : 150 * i.val + r.val%150 = r.val := by dsimp [i]; omega
  have u := List.all_eq_true.mp h (r.val%150) (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  simpa [e,r.isLt] using u

theorem baseCards : ∀ (w : Wd) (p : P),
    (1 < (bm 15 (lm p w.val)).card → sectors[w.val]! = p.val) ∧
    (w.val < 81 → (bm 15 (lm p w.val)).card ≤ 1 ∧ cm w.val = 0) ∧
    (1 < (bm 6 (cm w.val)).card → cm w.val ≠ 0 ∧ cm w.val &&& (cm w.val - 1) ≠ 0) ∧
    (w.val = coefs[p.val]! → (if p.val=0 then 4 else 5) ≤ (bm 15 (lm p w.val)).card) := by decide +kernel
theorem terminal : bm 6 (cm target) = Finset.univ := by decide +kernel

theorem liftSubset {a b : Nat} (n : Nat) (h : subm a b) : bm n a ⊆ bm n b := by
  intro p hp
  have hit := (Finset.mem_filter.mp hp).2
  apply Finset.mem_filter.mpr
  refine ⟨Finset.mem_univ _,?_⟩
  have z : (a &&& b).testBit p.val = true := by rw [show a &&& b = a from h]; exact hit
  simpa [Nat.testBit_and,hit] using z

theorem liftUnion (n : Nat) (a b : Nat) : bm n (a ||| b) = bm n a ∪ bm n b := by
  ext p
  simp [bm,Nat.testBit_or]

structure Trace where
  sites : Finset Nat
  word : Nat → Wd
  code : Nat → Rec
  raw : ∀ w, w ∉ sites → (word w).val < 81
  step : ∀ w ∈ sites, ∃ a < w, ∃ b < w,
    ca (code w) = (word a).val ∧ cb (code w) = (word b).val ∧ ck (code w) = (word w).val
  root : Nat
  result : (word root).val = target

theorem lower34 (g : Trace) : 34 ≤ g.sites.card := by
  let colors := fun i => bm 6 (cm (g.word i).val)
  let line := fun (p : P) i => bm 15 (lm p (g.word i).val)
  let cg := fun w => tag (g.code w)
  apply budget g.sites cg (fun w => owner (g.word w).val) colors line
    (fun p w => (g.word w).val = coefs[p.val]!) g.root
  · simpa only [colors,g.result] using terminal
  · intro w hw
    have h := (baseCards (g.word w) 0).2.2.1 hw
    have paid : w ∈ g.sites := by
      by_contra no
      exact h.1 (((baseCards (g.word w) 0).2.1 (g.raw w no)).2)
    obtain ⟨a,aw,b,bw,ea,eb,ek⟩ := g.step w paid
    have d := (localRules (g.code w)).2.1
    rw [ea,eb,ek] at d
    rcases d h.1 h.2 with ha|hb|⟨tagged,hc⟩
    · exact Or.inl ⟨a,aw,liftSubset 6 ha⟩
    · exact Or.inl ⟨b,bw,liftSubset 6 hb⟩
    · refine Or.inr ⟨Finset.mem_filter.mpr ⟨paid,tagged⟩,a,aw,b,bw,?_⟩
      simpa only [colors,← liftUnion] using liftSubset 6 hc
  · intro p w hw
    have h := (baseCards (g.word w) p).1 hw
    have paid : w ∈ g.sites := by
      by_contra no
      exact (Nat.not_lt_of_ge (((baseCards (g.word w) p).2.1 (g.raw w no)).1)) hw
    obtain ⟨a,aw,b,bw,ea,eb,ek⟩ := g.step w paid
    have d := (localRules (g.code w)).1 p
    rw [ea,eb,ek] at d
    rcases d h with ha|hb|⟨tagged,hc⟩
    · exact Or.inl ⟨a,aw,liftSubset 15 ha⟩
    · exact Or.inl ⟨b,bw,liftSubset 15 hb⟩
    · refine Or.inr ⟨Finset.mem_filter.mpr ⟨paid,tagged⟩,a,aw,b,bw,?_⟩
      simpa only [line,← liftUnion] using liftSubset 15 hc
  · intro w p hp
    have h : (cm (g.word w).val).testBit p.val = true := (Finset.mem_filter.mp hp).2
    have paid : w ∈ g.sites := by
      by_contra no
      rw [((baseCards (g.word w) p).2.1 (g.raw w no)).2] at h
      simp at h
    obtain ⟨a,aw,b,bw,ea,eb,ek⟩ := g.step w paid
    have d := (localRules (g.code w)).2.2 p
    rw [ea,eb,ek] at d
    rcases d h with ha|hb|⟨tagged,same,ha|hb⟩
    · exact Or.inl ⟨a,aw,Finset.mem_filter.mpr ⟨Finset.mem_univ _,ha⟩⟩
    · exact Or.inl ⟨b,bw,Finset.mem_filter.mpr ⟨Finset.mem_univ _,hb⟩⟩
    · exact Or.inr ⟨Finset.mem_filter.mpr ⟨paid,tagged⟩,same,a,aw,ha⟩
    · exact Or.inr ⟨Finset.mem_filter.mpr ⟨paid,tagged⟩,same,b,bw,hb⟩
  · intro p w hm
    exact (baseCards (g.word w) p).2.2.2 hm

def axis : List (Nat × Bool) := [(7,false), (56,false), (448,false), (3584,false), (9,true), (65,true), (72,true), (513,true), (520,true), (576,true), (18,true), (130,true), (144,true), (1026,true), (1040,true), (1152,true), (36,true), (260,true), (288,true), (2052,true), (2080,true), (2304,true)]
def violates (x : Nat) (s : Nat × Bool) : Bool := (x &&& s.1) == (if s.2 then s.1 else 0)
def badMask (x : Nat) : Nat :=
  ((List.range 22).filter (fun i => violates x (axis.getD i (0,false)))).foldl
    (fun a i => a ||| (1 <<< i)) 0
def hit (mask x : Nat) : Bool := (badMask x &&& mask) != 0
def inside (mask x : Nat) : Bool := (badMask x &&& mask) == badMask x

def sumDirs (a : Nat) : List Nat → Nat
  | [] => 0
  | b::bs => (a ^^^ b) ^^^ sumDirs a bs

theorem zeroDirs (v : Nat → Bool) (lin : ∀ a b, v (a ^^^ b) = Bool.xor (v a) (v b))
    (z : v 0 = false) (a : Nat) (bs : List Nat) (h : ∀ b ∈ bs, v a = v b) :
    v (sumDirs a bs) = false := by
  induction bs with
  | nil => exact z
  | cons b rest ih =>
    have e := h b (by simp)
    have t := ih (fun y hy => h y (by simp [hy]))
    simp only [sumDirs,lin,t,e]
    cases v b <;> rfl

structure Span where
  m : Nat
  a : Nat
  dirs : List (List Nat)
  deriving DecidableEq, Repr

def valid (w : Span) : Bool :=
  inside w.m w.a && w.dirs.length == 12 && (List.range 12).all (fun i =>
    let ds := w.dirs.getD i []
    ds.all (inside w.m) && sumDirs w.a ds == (1 <<< i))

theorem exclude (w : Span) (cert : valid w = true)
    (v : Nat → Bool) (lin : ∀ a b, v (a ^^^ b) = Bool.xor (v a) (v b))
    (zero : v 0 = false) (nz : ∃ i < 12, v (1 <<< i) = true)
    (constant : ∀ a b, inside w.m a = true → inside w.m b = true → v a = v b) : False := by
  obtain ⟨i,hi,ne⟩ := nz
  simp only [valid, Bool.and_eq_true, List.all_eq_true] at cert
  obtain ⟨base,_⟩ := cert.1
  obtain ⟨ds,num⟩ := cert.2 i (List.mem_range.mpr hi)
  have z := zeroDirs v lin zero w.a (w.dirs.getD i []) (fun b hb => constant _ _ base (ds b hb))
  rw [beq_iff_eq.mp num,ne] at z
  contradiction


private def restricted (ex:I) (u v : Lower.V) : Bool :=
  if u.val < 13 then decide (13 ≤ v.val ∧ (Lower.name u-Lower.name v)∈Lower.D ∧ (Lower.name u≠0 ∨ Lower.name v≠ex))
  else decide (v.val < 13 ∧ (Lower.name v-Lower.name u)∈Lower.D ∧ (Lower.name v≠0 ∨ Lower.name u≠ex))
private theorem thinPrice (ex:I) (C : Circuit) (hm : Monotone2 C) (hn : Lower.Neg C)
    (hy : ∀p l : I, (p-l∈Lower.D ∧ (p≠0 ∨ l≠ex)) → C.eval (Lower.positive p l)=true) : 38 ≤ C.size := by
  let adj (u v : Lower.V) := C.eval (List.ofFn (point {u,v}))=true
  have between (u v : Lower.V) (ha : adj u v) : Lower.G.Adj u v := by
    cases h : Lower.edge u v with
    | true => exact h
    | false =>
      let Q := Lower.box u v
      obtain ⟨hq,hu,hv⟩ := Lower.coverage u v h
      have le : point {u,v} ≤ Lower.bits Q := by
        intro k
        apply Bool.le_iff_imp.mpr
        intro hk
        rcases (show k=u ∨ k=v by simpa [point] using hk) with rfl|rfl
        · exact hu
        · exact hv
      have z := Mono.cmono C hm 26 _ _ le ha
      change C.eval (List.ofFn (Lower.bits Q))=true at z
      rw [Lower.packQ,hn Q hq] at z; contradiction
  let G : SimpleGraph Lower.V := {
    Adj := adj
    symm := ⟨fun a b h => by simpa [adj,Finset.pair_comm] using h⟩
    loopless := ⟨fun a h => Lower.G.loopless.irrefl a (between a a h)⟩ }
  have small (u v : Lower.V) (e : restricted ex u v=true) : G.Adj u v := by
    have data : ∀(ex:I) (u v : Lower.V), restricted ex u v=true → ∃p l : I, (p-l∈Lower.D ∧ (p≠0 ∨ l≠ex)) ∧
        ((u=p.castAdd 13 ∧ v=Fin.natAdd 13 l) ∨ (v=p.castAdd 13 ∧ u=Fin.natAdd 13 l)) := by decide +kernel
    obtain ⟨p,l,h,loc⟩ := data ex u v e
    have eq : point {u,v}=Lower.pair p l := by
      funext k
      rcases loc with ⟨rfl,rfl⟩|⟨rfl,rfl⟩ <;> simp [point,Lower.pair,or_comm]
    change C.eval (List.ofFn (point {u,v}))=true
    rw [eq,Lower.packP]; exact hy p l h
  have ns : NoSq G := by
    have common : ∀ u v : Lower.V, u≠v → (Finset.univ.filter (fun t : Lower.V => Lower.edge u t=true ∧ Lower.edge v t=true)).card ≤ 1 := by decide +kernel
    rintro a b c d ac bd ⟨ab,bc,cd,da⟩
    exact bd (Finset.card_le_one.mp (common a c ac) b (Finset.mem_filter.mpr ⟨Finset.mem_univ _,between _ _ ab,Lower.G.adj_symm (between _ _ bc)⟩)
      d (Finset.mem_filter.mpr ⟨Finset.mem_univ _,Lower.G.adj_symm (between _ _ da),between _ _ cd⟩))
  have deg (u : Lower.V) : 2 ≤ (G.neighborSet u).ncard := by
    have data : ∀(ex:I) (u:Lower.V),∃ v w,restricted ex u v=true ∧ restricted ex u w=true ∧ v≠w := by decide +kernel
    obtain ⟨v,w,a,b,h⟩ := data ex u
    exact (Set.one_lt_ncard_iff (s:=G.neighborSet u)).mpr ⟨v,w,small _ _ a,small _ _ b,h⟩
  have cover (S : Finset Lower.V) (hs : CoverPromise.IsVertexCover G S) : 13 ≤ S.card := by
    let shift := fun t:I=>if t=0 then (1:I) else 0
    let P (i : I) := (i+shift ex).castAdd 13
    let L (i : I) := Fin.natAdd 13 i
    have data : ∀t i:I,restricted t ((i+shift t).castAdd 13) (Fin.natAdd 13 i)=true := by decide +kernel
    have edge (i:I) := data ex i
    let pick (i : I) := if P i∈S then P i else L i
    have side (i : I) : pick i∈S := by
      by_cases h : P i∈S
      · simpa [pick,h] using h
      · simpa [pick,h] using (hs _ _ (small _ _ (edge i))).resolve_left h
    let back (x : Lower.V) : I := if x.val < 13 then Fin.ofNat 13 x.val-shift ex else Fin.ofNat 13 x.val
    have inv : ∀i : I,back (P i)=i ∧ back (L i)=i := by
      fin_cases ex <;> decide +kernel
    have ret (i : I) : back (pick i)=i := by dsimp only [pick];split <;> first | exact (inv i).1 | exact (inv i).2
    have inj : Function.Injective pick := fun a b eq => (ret a).symm.trans ((congrArg back eq).trans (ret b))
    have z := Finset.card_le_card_of_injOn (s:=Finset.univ) (t:=S) pick (fun i _ => side i) inj.injOn
    simpa only [Finset.card_univ,Fintype.card_fin] using z
  have h := min_two_bound ns deg cover hm (show GraphEval C G from fun _ _ => Iff.rfl)
  omega


theorem priced (C:Circuit) (ex:I) (b:Bool) (mc:Monotone2 C)
    (pos:∀p l:I,p-l∈Lower.D → p≠0 ∨ l≠ex → C.eval (Lower.positive p l ++ [b])=true)

    38+Price17147.nread 26 C.gates≤C.size := by
  rcases Price17147.fixRail 26 C mc b with ⟨d,hd⟩|⟨K,km,ks,eq⟩
  · have y:=hd (Lower.pair 1 1)
    rw [Lower.packP,pos 1 1 (by decide) (Or.inl (by decide))] at y
    let Q:Finset I:={0,1,2,5}
    have f:=hd (Lower.bits Q)
    have quadQ : Lower.quad Q := by unfold Lower.quad;decide +kernel
    rw [Lower.packQ,neg Q quadQ] at f
    exact (Bool.true_ne_false (y.trans f.symm)).elim
  · have nn:Lower.Neg K := by
      intro Q h
      have z:=eq (Lower.bits Q)
      rw [Lower.packQ] at z
      exact z.trans (neg Q h)
    have pp (p l:I) (h:p-l∈Lower.D ∧ (p≠0 ∨ l≠ex)):K.eval (Lower.positive p l)=true := by
      have z:=eq (Lower.pair p l)
      rw [Lower.packP] at z
      exact z.trans (pos p l h.1 h.2)
    have := thinPrice ex K km nn pp
    omega

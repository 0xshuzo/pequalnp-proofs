  have hl (l) : (Finset.univ.filter (fun p => I p l)).card = q+1 := by
    simpa [I] using lines l
  have hp := lines_through q N I hq hN hl uniqueLine
  apply min_two_bound (G := plane S) (squareFree S uniqueLine)
    (two_neighbors S hq lines hp) _ _ (pair_test S C right reject)
  · intro T cv
    rw [← split_card T]
    apply cover q I hl hp
    intro p l h
    simpa only [left_mem, right_mem] using cv (L p) (R l) ((planeLR S p l).mpr h)

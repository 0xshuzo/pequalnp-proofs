theorem PEqualNP.Outside.L_meta_17603.Mono : ∀ (x1 : ℕ) (x2 : PEqualNP.CircuitLowerBounds.Circuit), PEqualNP.MetaComplexity.Monotone2 x2 → ∀ (x4 : (Fin x1 → Bool) → Prop), (∀ (x5 : Fin x1 → Bool), Minimal x4 x5 → x2.eval (List.ofFn x5) = Bool.true) → (∀ (x6 : Fin x1 → Bool), Maximal (fun (x7 : Fin x1 → Bool) => ¬x4 x7) x6 → x2.eval (List.ofFn x6) = Bool.false) → ∀ (x7 : Fin x1 → Bool), x2.eval (List.ofFn x7) = Bool.true ↔ x4 x7 := by
  intro n C hC P hmin hmax x
  constructor
  · intro hx
    by_contra hP
    obtain ⟨z, hxz, hz⟩ := Finite.exists_le_maximal (p := fun x7 : Fin n → Bool => ¬ P x7) hP
    have := cmono C hC n x z hxz hx
    rw [hmax z hz] at this
    exact absurd this (by simp)
  · intro hP
    obtain ⟨y, hyx, hy⟩ := Finite.exists_le_minimal (p := P) hP
    exact cmono C hC n y x hyx (hmin y hy)


theorem must (f : Vec→Bool) (mf : up f) (tf : truth f) (s : SId) (sw : Key f (id s).1 (id s).2)
    (k : Probe) (m : (flags s).getLsbD k.val=true) : f (neg (sq k))=true := by
  obtain ⟨incident,left,right⟩ := matchTable s k m
  have le : pos (pic s k) (lic s k) ≤ (fun j=>neg (sq k) (changeVar (id s) j)) := by
    intro j
    apply Bool.le_iff_imp.mpr
    intro hj
    rcases locations _ _ j hj with rfl|rfl
    · exact left
    · exact right
  have val := mf _ _ le (tf _ _ incident)
  have eqv : f (fun j=>neg (sq k) (changeVar (id s) j)) = f (neg (sq k)) := sw (neg (sq k))
  exact eqv.symm.trans val
theorem rigidity (f g : Vec→Bool) (hf : truth f) (hg : truth g) (mf : up f) (mg : up g)
    (hn : ∀ q : Finset I,quad q → f (neg q)=false ∨ g (neg q)=false) :
    (∀ i j : V,i<j → ¬Key f i j) ∨ (∀ i j : V,i<j → ¬Key g i j) := by
  classical
  by_contra h
  push_neg at h
  obtain ⟨⟨a,b,hab,fs⟩,⟨c,d,hcd,gs⟩⟩ := h
  obtain ⟨u,hu⟩ := listed a b hab
  obtain ⟨v,hv⟩ := listed c d hcd
  have hit : ∃ k : Probe, (flags u).getLsbD k.val=true ∧ (flags v).getLsbD k.val=true := by
    by_contra no
    apply intersects u v
    apply BitVec.eq_of_getLsbD_eq
    intro j hj
    rw [BitVec.getLsbD_and]
    have clash := fun (l : (flags u).getLsbD j=true) (r : (flags v).getLsbD j=true) =>
      no ⟨⟨j,hj⟩,l,r⟩
    cases A : (flags u).getLsbD j <;> cases B : (flags v).getLsbD j <;> simp_all
  obtain ⟨k,ku,kv⟩ := hit
  have FU := must f mf hf u (by simpa only [hu] using fs) k ku
  have GV := must g mg hg v (by simpa only [hv] using gs) k kv
  rcases hn (sq k) (geometry k) with q|q <;> simp_all

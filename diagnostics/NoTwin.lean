def id (s : SId) := ids[s.val]?.getD (0,0)
def sq (k : Probe) := pv[k.val]?.getD ∅
def flags (s : SId) : Mark := fm[s.val]?.getD 0
def code2 (s : SId) (k : Probe) := (mat[s.val]?.getD #[])[k.val]?.getD 0
def pic (s : SId) (k : Probe) : I := Fin.ofNat 13 (code2 s k / 13)
def lic (s : SId) (k : Probe) : I := Fin.ofNat 13 (code2 s k % 13)
def changeVar (sw : V × V) (v : V) := if v=sw.1 then sw.2 else if v=sw.2 then sw.1 else v
def Key (f : Vec→Bool) (i j : V) := ∀ x : Vec, f (fun k=>x (changeVar (i,j) k)) = f x
theorem listed : ∀ i j : V,i<j → ∃ s : SId,id s=(i,j) := by decide +kernel
theorem geometry : ∀ e : Probe,quad (sq e) := by decide +kernel

abbrev I := Fin 13
abbrev V := Fin (13+13)
abbrev Vec := V → Bool
def D : Finset I := {0,1,3,9}
def pos (p l : I) : Vec := Fin.append (fun i => decide (i=p)) (fun i => decide (i=l))
def neg (q : Finset I) : Vec := Fin.append (fun i => decide (i∈q)) (fun l => decide (∀ p∈q,p-l∉D))
def quad (q : Finset I) := q.card=4 ∧ ∀ l : I,(q.filter fun p=>p-l∈D).card≤2
instance (q : Finset I) : Decidable (quad q) := inferInstanceAs (Decidable (_ ∧ _))
def plus (x : Vec) (v : V) : Vec := fun j=>decide (j=v) || x j
def Uses (f : Vec → Bool) (v : V) := ∃ x y : Vec, (∀ i, i≠v → x i=y i) ∧ f x≠f y
def truth (f : Vec → Bool) := ∀ p l : I,p-l∈D → f (pos p l)=true
def up (f : Vec → Bool) := ∀ x y : Vec,x≤y → f x=true → f y=true
abbrev K := Fin 3
def samples : Array (Finset I) := #[{0,1,2,5},{3,4,7,9},{6,8,10,12}]
def sample (k : K) := samples[k.val]?.getD ∅
def table : Array Nat := #[0,0,0,42,55,0,81,98,111,125,137,151,159,0,14,28,0,4,18,32,0,0,74,10,24,12,10,18,38,0,0,70,83,0,109,0,140,153,168,39,53,41,42,56,0,97,46,60,126,0,102,0,0,13,28,39,56,67,0,95,0,117,0,145,0,0,131,0,81,0,83,84,111,112,139,88,167,116]
def code (k : K) (v : V) := table[26*k.val+v.val]?.getD 0
def pt (k : K) (v : V) : I := Fin.ofNat 13 (code k v /13)
def ln (k : K) (v : V) : I := Fin.ofNat 13 (code k v %13)
theorem good : ∀ k : K, quad (sample k) := by decide +kernel
set_option maxRecDepth 16000 in
set_option maxHeartbeats 1000000 in
theorem avoid : ∀ i j : V,∃ k : K, neg (sample k) i=false ∧ neg (sample k) j=false := by decide +kernel
set_option maxRecDepth 16000 in
set_option maxHeartbeats 1500000 in
theorem witness : ∀ k : K, ∀ v : V, neg (sample k) v=false →
    pt k v - ln k v ∈ D ∧ ∀ j : V, pos (pt k v) (ln k v) j ≤ plus (neg (sample k)) v j := by decide +kernel

theorem usesOutside (f : Vec→Bool) (hf : truth f) (hm : up f) (k : K)
    (hr : f (neg (sample k))=false) (v : V) (hv : neg (sample k) v=false) : Uses f v := by
  obtain ⟨hit,le⟩ := witness k v hv
  have yes := hm _ _ le (hf _ _ hit)
  refine ⟨neg (sample k),plus (neg (sample k)) v,?_,?_⟩
  · intro j hj
    simp [plus,hj]
  · rw [hr,yes]
    decide

theorem fullOne (f g : Vec→Bool) (hf : truth f) (hg : truth g) (mf : up f) (mg : up g)
    (hn : ∀ q : Finset I,quad q → f (neg q)=false ∨ g (neg q)=false) :
    (∀ i,Uses f i) ∨ (∀ i,Uses g i) := by
  classical
  by_contra h
  push_neg at h
  obtain ⟨⟨i,hi⟩,⟨j,hj⟩⟩ := h
  obtain ⟨k,ai,aj⟩ := avoid i j
  rcases hn (sample k) (good k) with first|second
  · exact hi (usesOutside f hf mf k first i ai)
  · exact hj (usesOutside g hg mg k second j aj)

def wire (C : Circuit) (w : Nat) (x : Vec) := (C.wires (List.ofFn x)).getD w false
theorem wireMono (C : Circuit) (hm : Monotone2 C) (w : Nat) : up (wire C w) := by
  intro x y le yes
  exact PEqualNP.Outside.L_meta_2880.cmono (⟨C.gates,w⟩ : Circuit) hm 26 x y le yes

theorem circuit (C : Circuit) (a b : Nat) (hm : Monotone2 C)
    (yes : ∀ p l : I,p-l∈D → wire C a (pos p l)=true ∧ wire C b (pos p l)=true)
    (no : ∀ q : Finset I,quad q → wire C a (neg q)=false ∨ wire C b (neg q)=false) :
    (∀ i,Uses (wire C a) i) ∨ (∀ i,Uses (wire C b) i) :=
  fullOne _ _ (fun p l h => (yes p l h).1) (fun p l h => (yes p l h).2)
    (wireMono C hm a) (wireMono C hm b) no

theorem matchTable : ∀ s : SId,∀ k : Probe, (flags s).getLsbD k.val=true →
  pic s k-lic s k∈D ∧ neg (sq k) (changeVar (id s) ((pic s k).castAdd 13))=true ∧
  neg (sq k) (changeVar (id s) (Fin.natAdd 13 (lic s k)))=true := by decide +kernel

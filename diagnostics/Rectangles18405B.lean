theorem rectangle (v : V) (s : Finset E) (t : Finset Q) (sub : s⊆owners v)
    (quiet : ∀ q∈t,neg q v=false) : (∑ e∈s,∑ q∈t,weights e q)≤1512 := by
  rw [Finset.sum_comm]
  apply le_trans _ (feasible v s sub)
  unfold budget

  have eq : (∑ q∈t,∑ e∈s,weights e q) = ∑ q : Q,if q∈t then ∑ e∈s,weights e q else 0 := by
    rw [← Finset.sum_filter]
    simp
  rw [eq]
  apply Finset.sum_le_sum
  intro q _
  by_cases inc : q∈t
  · simp [inc,quiet q inc]
  · by_cases b : neg q v=true <;> simp [inc,b]

theorem leaves56 (φ : DMFormula 26)
    (mono : DMFormula.rec (motive:= fun _ : DMFormula 26 => Prop)
      (fun (_ : V) (c : Bool) => c=true) (fun _ _ a b => a ∧ b) (fun _ _ a b => a ∧ b) φ)
    (accept : ∀ e,φ.eval (pos e)=true) (reject : ∀ q,φ.eval (neg q)=false) : 56≤φ.leaves := by
  classical
  obtain ⟨X,Y,L,_,unique,hx,hy⟩ := cover531_formulaRectanglesStrong φ mono
  let S (i : Fin φ.leaves) := Finset.univ.filter fun e : E => X i (pos e)
  let T (i : Fin φ.leaves) := Finset.univ.filter fun q : Q => Y i (neg q)
  let cell (i : Fin φ.leaves) (e : E) (q : Q) : Int := if e∈S i ∧ q∈T i then weights e q else 0
  have sumCell (e : E) (q : Q) : (∑ i,cell i e q)=weights e q := by
    obtain ⟨i,h,only⟩ := unique _ _ (accept e) (reject q)
    rw [Finset.sum_eq_single i]
    · simp [cell,S,T,h]
    · intro j _ ne
      apply if_neg
      intro yes
      exact ne (only j ⟨(Finset.mem_filter.mp yes.1).2,(Finset.mem_filter.mp yes.2).2⟩)
    · simp
  have per (i : Fin φ.leaves) : (∑ e,∑ q,cell i e q)≤1512 := by
    have step := rectangle (L i) (S i) (T i)
      (fun e he => Finset.mem_filter.mpr ⟨Finset.mem_univ _,(hx i _ (Finset.mem_filter.mp he).2).2⟩)
      (fun q hq => (hy i _ (Finset.mem_filter.mp hq).2).2)
    convert step using 1
    simp only [S,T,Finset.sum_filter,cell]
    apply Finset.sum_congr rfl
    intro e _
    by_cases h : X i (pos e) <;> simp [h,S,T]
  have h := Finset.sum_le_sum (s:=(Finset.univ : Finset (Fin φ.leaves))) (fun i _ => per i)
  have swap : (∑ i,∑ e,∑ q,cell i e q) = ∑ e,∑ q,∑ i,cell i e q := by
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
  rw [swap] at h
  simp only [sumCell,total,Finset.sum_const,Finset.card_univ,Fintype.card_fin,nsmul_eq_mul] at h
  omega


def power (n : Nat) := 2^n
def slot (p i : Nat) := (p / power (3*i))%8
def bitrow (g r : Nat) := (g / power (5*r))%32
def small (x : Nat) : Bool := (x &&& (x-1)) == 0
def goodRow (g : Nat) : Bool := (List.range 6).all fun i => let v:=bitrow g i; v==0 || !(small v)
def perm (n p : Nat) : Bool := (List.range n).all fun i =>
  slot p i < n && (List.range i).all fun j => slot p j != slot p i
def imageBits (g p c : Nat) : Nat := (List.range 30).foldl (fun a v =>
  if g.testBit v then a ||| power (5*slot p (v/5)+slot c (v%5)) else a) 0
def per (i v : Nat) : Bool := Id.run do
  let (g,k) := states[i]!
  if !g.testBit v || k≤2 || (g==105703 && k≤4) then return true
  let (a,b) := (edges[i]!)[v]!
  let j := a / power 30
  if j≥states.size then return false
  let (h,k') := states[j]!
  let m := a%power 30
  let p := b%power 18
  let c := b/power 18
  let e := imageBits h p c
  return k'+1==k && perm 6 p && perm 5 c && !(e.testBit v) &&
    ((e ||| m) &&& g)==(e ||| m) &&
    (List.range 6).all (fun i =>
      let u:=bitrow m i
      let w:=bitrow e i
      small u && (u==0 || w==0) && (bitrow g i==0 || u!=0 || w!=0)) &&
    (List.range 5).all (fun j =>
      let col:=34636833*power j
      let u:=m &&& col
      small u && (u==0 || (e &&& col)==0))
def node (i : Nat) : Bool := goodRow (states[i]!).1 && (List.range 30).all (per i)

abbrev Frame := Fin 30

def first (o : Nat) : Frame := Fin.ofNat 30 (order[o]! / 8)
def last (o : Nat) : Frame := Fin.ofNat 30 (24 + order[o]! % 8)
def point (f : Frame) (r : Sample) : Sample :=
  Fin.ofNat 60 ((images[f.val]! >>> (6*r.val))%64)
def decode (z : Nat) : Part := ⟨z >>> 7, z % 64, z.testBit 6⟩
def pieces (f : Frame) : List Part := (patterns[f.val]!).toList.map decode
def pass (f : Frame) (m : Nat) : Nat := roll (pieces f) m
def transform (o m : Nat) : Nat := (pass (last o) (pass (first o) m)) % (2^60)

theorem domains : ∀ (f : Frame) (r : Sample), routes (pieces f) r.val (point f r).val := by decide +kernel
theorem pairs : ∀ (o : ID) (r : Sample),
    point (first o.val) (point (last o.val) r) = backward words[o.val]! 9 r := by decide +kernel
theorem bit (o : ID) (m : Nat) (r : Sample) :
    (transform o.val m).testBit r.val = m.testBit ((orient o).s.symm r).val := by
  rw [transform, Nat.testBit_mod_two_pow]
  simp only [decide_eq_true_eq.mpr r.isLt,Bool.true_and]
  change (roll (pieces (last o.val)) _).testBit r.val = _
  rw [rollCorrect (domains _ r)]
  change (roll (pieces (first o.val)) _).testBit (point (last o.val) r).val = _
  rw [rollCorrect (domains _ _),pairs,orient,backApply]
end PCX150.Factors

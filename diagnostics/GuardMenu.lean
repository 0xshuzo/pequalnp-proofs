def swapStar (f g : Nat) := if (g &&& (g-1)) = 0 ∧ g<f then (g,f) else (f,g)
def ordinary (op : Nat) (x y z : Wire) : Bool :=
  if op=2 then decide (z.a=0 ∧ z.b=0 ∧ x.b=0)
  else if x.a=0 then decide ((z.a,z.b)=(y.a,y.b))
  else if y.a=0 then decide ((z.a,z.b)=(x.a,x.b))
  else if op=1 then decide (x.b=0 ∧ y.b=0 ∧ z.a=(x.a ||| y.a) ∧ z.b=0)
  else decide (x.b=0 ∧ y.b=0 ∧ ((z.a,z.b)=swapStar x.a y.a ∨ (z.a,z.b)=swapStar y.a x.a) ∧ z.a ≠ 0 ∧ (z.a &&& (z.a-1))=0 ∧ z.b ≠ 0)
def signed (op : Nat) (x y z : Wire) : Bool := decide (z.dy =
  if op=2 then Nat.xor 17592186044415 x.dy else if op=1 then x.dy ||| y.dy else x.dy &&& y.dy)
def good (op : Nat) (x y z : Wire) := ordinary op x y z && signed op x y z

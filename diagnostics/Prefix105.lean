set_option maxRecDepth 200000 in
theorem validCheck : chkL (axPHP 5 4) cert=true := by decide +kernel
theorem physical : IsLinDerivation (linOfClause '' PHP 5 4) (cert.map Prod.fst) :=
  chkL_sound _ (axPHP 5 4) (axPHP_sound 5 4) _ validCheck
theorem lengths : cert.length=105 := by decide +kernel
theorem noBottom : (∅ : LinClause (Fin 5 × Fin 4))∉cert.map Prod.fst := by decide +kernel

def witness (x : Nat) (v : Fin 5 × Fin 4) : Bool := x.testBit (4*v.1.val+v.2.val)
def onFace (p : Fin 5) (h : Fin 4) (x : Nat) : Prop :=
  ∀ i : Fin 5, ∀ j : Fin 4, (i=p ∨ j=h) → witness x (i,j)=decide (i=p ∧ j=h)

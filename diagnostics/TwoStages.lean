def unions (cap : Nat) (groups : List Mask) (supply : List Mask) : List Mask :=
  supply.foldl (fun xs z => xs ++ ((xs.map (fun v => v ||| z)).filter (fits cap groups))) [0]
def bank (cap : Nat) (groups : List Mask) (supply : List Mask) : List Mask :=
  (unions cap groups supply).filter (room cap groups)
def retained (g a b : Mask) : Mask := g &&& ((a &&& (allRows ^^^ b)) ^^^ allRows)
def viable (cap : Nat) (groups : List Mask) (a b : Mask) : Bool :=

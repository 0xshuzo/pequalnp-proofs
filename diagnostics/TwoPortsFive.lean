def required : Fin 5 → Fin 139 := ![6,7,10,13,14]
def row (s : Nat) : Input := fun i => s.testBit i.val
def firstMask : Fin 5 → Nat := ![8590465142,67909796,67309056,8590532743,8590541959]
def secondMask : Fin 5 → Nat := ![8590465078,67909668,67308032,8590524551,8590525575]
abbrev firstRow (j : Fin 5) := row (firstMask j)
abbrev secondRow (j : Fin 5) := row (secondMask j)

set_option maxHeartbeats 6000000 in
set_option maxRecDepth 12000 in
theorem sameElsewhere : ∀ j i, i ≠ required j →
    tapBank (firstRow j) i = tapBank (secondRow j) i := by decide +kernel

set_option maxRecDepth 12000 in
theorem blocked : ∀ j a b, ¬ (arms (firstRow j) a b = target (firstRow j) ∧
    arms (secondRow j) a b = target (secondRow j)) := by decide +kernel

def indexColor (i : Fin 139) : Fin 5 :=
  if i = required 0 then 0 else if i = required 1 then 1 else if i = required 2 then 2
  else if i = required 3 then 3 else 4
theorem colors : ∀ j, indexColor (required j) = j := by decide

theorem noFour (select : Fin 4 → Fin 139) (decoder : (Fin 4 → Bool) → Bool × Bool) :
    ¬ ∀ x, let ab := decoder (fun i => tapBank x (select i))
           arms x ab.1 ab.2 = target x := by
  intro ok
  let pack (x : Input) : Fin 4 → Bool := fun i => tapBank x (select i)
  have allPins (j : Fin 5) : ∃ i, select i = required j := by
    by_contra! missing
    have eq : pack (firstRow j) = pack (secondRow j) :=
      funext (fun i => sameElsewhere j (select i) (missing i))
    have h1 := ok (firstRow j)
    have h2 := ok (secondRow j)
    change arms (firstRow j) (decoder (pack (firstRow j))).1 (decoder (pack (firstRow j))).2 = _ at h1
    change arms (secondRow j) (decoder (pack (secondRow j))).1 (decoder (pack (secondRow j))).2 = _ at h2
    rw [← eq] at h2
    exact blocked j _ _ ⟨h1,h2⟩
  have onto : Function.Surjective (fun i => indexColor (select i)) := by
    intro j
    obtain ⟨i,hi⟩ := allPins j
    refine ⟨i, ?_⟩
    change indexColor (select i) = j
    rw [hi, colors]
  have impossible := Fintype.card_le_of_surjective _ onto
  simpa using impossible

def lane (k : K) (i : I) := boards[24*k.val+i.val]!
def val (x : Nat) (v : V) := x.testBit (4*v.1.val+v.2.val)
def rowKey (p : P) : K := ⟨p.val,by omega⟩
def atRow (p : P) (l : Literal V) := l.1.1=p ∧ l.2=true

set_option maxRecDepth 6000 in
theorem invariant : ∀p : P, ∀l : Literal V, (∀i : I, val (lane (rowKey p) i) l.1 ≠ l.2) ↔
    atRow p l := by decide +kernel
theorem onlyPos {p : P} {c : C} (own : ∀i : I,¬ClauseSat (val (lane (rowKey p) i)) c) :
    ∀l∈c,atRow p l := by
  intro l mem
  apply (invariant p l).1
  intro i lit
  exact own i ⟨l,mem,lit⟩

def occupants (k : K) : Nat := #[1,2,4,8,16,3,5,9,17,6,10,18,12,20,24,3,5,9,17,6,10,18,12,20,24,3,5,9,17,6,10,18,12,20,24,3,5,9,17,6,10,18,12,20,24][k.val]!
def fixedAt (x : Nat) (p : P) (h : H) : Bool :=
  ((x >>> (4*p.val)) &&& 15) == (1 <<< h.val)
def possible (p : P) (k : K) : List H :=
  (List.finRange 4).filter (fun h=>(List.finRange 24).any (fun i=>fixedAt (lane k i) p h))
set_option maxRecDepth 6000 in
theorem three : ∀p : P, ∀k : K, (occupants k).testBit p.val=false → 3 ≤ (possible p k).length := by decide +kernel

theorem forcedPivot {a r n : C} {v : V} (rule : r=a.erase (v,true) ∪ n.erase (v,false))
    {p : P} {h : H} (yes : ((p,h),true)∈a) (gone : ((p,h),true)∉r) : v=(p,h) := by
  by_contra diff
  apply gone
  rw [rule]
  apply Finset.mem_union_left
  exact Finset.mem_erase.mpr ⟨fun z=>diff (congrArg Prod.fst z).symm,yes⟩
end PEqualNP.Outside.L_pcx_166.LastRead

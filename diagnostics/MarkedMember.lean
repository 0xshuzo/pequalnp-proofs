def entryN (i : NI) := datas[i.val]?.getD (0,0,0,0,0,0)
def jumpN (i : NI) (p : Fin 6) (h : Fin 5) : NI × Fin 72 × Fin 48 :=
  let val := (entryN i).2.2.2.2.2 >>> (33*(5*p.val+h.val))
  (Fin.ofNat 531 (val%65536),Fin.ofNat 72 ((val>>>16)%1024),Fin.ofNat 48 ((val>>>26)%128))
def nativeLit (z : Nat) : L := ((Fin.ofNat 6 (z/10),Fin.ofNat 5 ((z/2)%5)),z%2==0)
def flag (i : NI) (l : L) : Bool :=
  (if l.2 then (entryN i).2.1 else (entryN i).2.2.1).testBit (5*l.1.1.val+l.1.2.val)
def firstLit (i : NI) := nativeLit (entryN i).2.2.2.1
def otherLit (i : NI) := nativeLit (entryN i).2.2.2.2.1
def stateB (i : NI) : I := Fin.ofNat 62 (entryN i).1
def onBoard (i : NI) (l : L) := cell (stateB i) l.1.1 l.1.2
def Here (i : NI) := flag i (firstLit i)=true ∧
  (onBoard i (firstLit i)=some (firstLit i).2 ∨
    (flag i (otherLit i)=true ∧ firstLit i≠otherLit i ∧ onBoard i (firstLit i)=none ∧ onBoard i (otherLit i)=none))
def Query (i : NI) (p : Fin 6) (h : Fin 5) :=
  let (j,x,y) := jumpN i p h
  let a := xPerm x
  let b := yPerm y
  depth (stateB j)+1=depth (stateB i) ∧ cell (stateB j) (a p) (b h)≠none ∧
  (∀q k, cell (stateB i) q k=none ∨ cell (stateB j) (a q) (b k)=cell (stateB i) q k) ∧
  ∀ (q : Fin 6) (k : Fin 5) (v : Bool), flag j ((a q,b k),v)=flag i ((q,k),v)
set_option maxRecDepth 64000 in
set_option maxHeartbeats 0 in
theorem boardCheck : ∀i : NI, Here i := by unfold Here; decide +kernel
set_option maxRecDepth 64000 in
set_option maxHeartbeats 0 in
theorem nextCheck : ∀i : NI, depth (stateB i)≠0 → onBoard i (firstLit i)≠some (firstLit i).2 →
   ∀p h, cell (stateB i) p h=none → Query i p h := by unfold Query; decide +kernel
def moved (a : Equiv.Perm (Fin 6)) (b : Equiv.Perm (Fin 5)) (l : L) : L := ((a l.1.1,b l.1.2),l.2)
def matched (c : C) (i : NI) (a : Equiv.Perm (Fin 6)) (b : Equiv.Perm (Fin 5)) :=
  ∀l, l∈c ↔ flag i (moved a b l)=true
theorem moved_back (a : Equiv.Perm (Fin 6)) (b : Equiv.Perm (Fin 5)) (l : L) :
    moved a b (moved a.symm b.symm l)=l := by rcases l with ⟨⟨p,h⟩,sg⟩; simp [moved]
theorem with_literal {s l c k} (member : l∈c) (holds : Holds s l) (g : KeepGame BaseSafe k s) :
    KeepGame (fun t => BaseSafe t ∧ Safe t c) k s := by
  induction k generalizing s with
  | zero => exact ⟨g,Or.inl ⟨l,member,holds⟩⟩
  | succ k ih =>
    refine ⟨⟨g.1,Or.inl ⟨l,member,holds⟩⟩,?_⟩
    intro v uv
    obtain ⟨t,st,fix,tail⟩ := g.2 v uv
    exact ⟨t,st,fix,ih (st _ _ holds) tail⟩
theorem marked_play (n : Nat) (i : NI) (di : depth (stateB i)=n)
    (a : Equiv.Perm (Fin 6)) (b : Equiv.Perm (Fin 5)) (c : C) (m : matched c i a b) :
    KeepGame (fun s => BaseSafe s ∧ Safe s c) n (value (stateB i) a b) := by
  let back := moved a.symm b.symm
  have mem (l : L) (hit : flag i l=true) : back l∈c :=
    (m _).mpr (by simpa [back,moved_back] using hit)
  have ev (l : L) : value (stateB i) a b (back l).1 = onBoard i l := by
    rcases l with ⟨⟨p,h⟩,sg⟩
    simp [value,onBoard,back,moved]
  have B := boardCheck i
  by_cases pos : onBoard i (firstLit i)=some (firstLit i).2
  · exact with_literal (mem _ B.1) (show Holds _ (back (firstLit i)) by
      simpa [Holds,ev] using pos) (play n (stateB i) di a b)
  · obtain ⟨bm,ne,u,v⟩ := B.2.resolve_left pos
    have safe : Safe (value (stateB i) a b) c := by
      refine Or.inr ⟨_,mem _ B.1,_,mem _ bm,?_,(ev _).trans u,(ev _).trans v⟩
      intro eq
      apply ne
      simpa [back,moved_back] using congrArg (moved a b) eq
    cases n with
    | zero => exact ⟨base_good _ _ _,safe⟩
    | succ n =>
      refine ⟨⟨base_good _ _ _,safe⟩,?_⟩
      rintro ⟨p,h⟩ unknown
      let r := jumpN i (a p) (b h)
      let ap := a.trans (xPerm r.2.1)
      let bp := b.trans (yPerm r.2.2)
      obtain ⟨rank,fix,extend,mark⟩ := nextCheck i (by omega) pos (a p) (b h) unknown
      have mx : matched c r.1 ap bp := by
        rintro ⟨⟨q,k⟩,sg⟩
        exact (m _).trans (by simpa [moved,ap,bp] using congrArg (fun v : Bool => v=true) (mark (a q) (b k) sg).symm)
      refine ⟨value (stateB r.1) ap bp,?_,fix,marked_play n r.1 (by omega) ap bp c mx⟩
      rintro ⟨q,k⟩ bit was
      rcases extend (a q) (b k) with absent | same
      · change cell (stateB i) (a q) (b k)=some bit at was
        simp_all
      · exact same.trans was
termination_by n

def testedClause : C := Finset.univ.filter (fun l => flag 0 l=true)
theorem checked_template : ∃s, KeepGame (fun t => BaseSafe t ∧ Safe t testedClause) 9 s := by
  refine ⟨_,marked_play 9 0 (by decide +kernel) (Equiv.refl _) (Equiv.refl _) testedClause ?_⟩
  intro l
  simp [testedClause,moved]

theorem safe_expand {s : Val} {c d : C} (sub : c⊆d) (h : Safe s c) : Safe s d := by
  rcases h with ⟨l,ml,yes⟩ | ⟨a,ha,b,hb,ne,ua,ub⟩
  · exact Or.inl ⟨l,sub ml,yes⟩
  · exact Or.inr ⟨a,sub ha,b,sub hb,ne,ua,ub⟩
theorem marked_member_lower {cs : List C} (run : IsRUPRun (PHP 6 5) cs)
    (out : (∅ : C)∈cs) {d : C} (member : d∈cs) (sub : testedClause⊆d) : 12≤cs.length := by
  classical
  by_contra! len
  have tested_non : testedClause.Nonempty := by decide +kernel
  have dne : d≠∅ := (tested_non.mono sub).ne_empty
  have hm : (∅ : C)∈cs.toFinset := List.mem_toFinset.mpr out
  have cm : d∈cs.toFinset.erase ∅ := Finset.mem_erase.mpr ⟨dne,List.mem_toFinset.mpr member⟩
  let saved := (cs.toFinset.erase ∅).erase d
  have bound : saved.card≤9 := by
    simp only [saved,Finset.card_erase_of_mem cm,Finset.card_erase_of_mem hm]
    have hh := List.toFinset_card_le (l:=cs)
    omega
  obtain ⟨s,g⟩ := checked_template
  obtain ⟨t,_,⟨bt,ct⟩,rest⟩ := avoidKept 9 s g saved bound
  have none : ∀c∈cs, ¬Single t c := by
    intro c mc
    by_cases emp : c=∅
    · subst c
      simp [Single]
    · by_cases same : c=d
      · subst c
        exact safe_not_single (safe_expand sub ct)
      · exact rest c (Finset.mem_erase.mpr ⟨same,Finset.mem_erase.mpr ⟨emp,List.mem_toFinset.mpr mc⟩⟩)
  have bad := safe_run bt run none ∅ out
  simp [Safe] at bad

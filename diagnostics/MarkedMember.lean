def entry (i : I) := states[i.val]?.getD (0,0,0,0)
def depth (i : I) : Nat := (entry i).1
def cell (i : I) (p : Fin 6) (h : Fin 5) : Option Bool :=
  let v := 5*p.val+h.val
  if (entry i).2.1.testBit v then none else some ((entry i).2.2.1.testBit v)
def response (i : I) (p : Fin 6) (h : Fin 5) : I × IP × IH :=
  let bits := (entry i).2.2.2 >>> (24*(5*p.val+h.val))
  (⟨bits % 256 % 62,by omega⟩,⟨(bits / 256) % 256 % 67,by omega⟩,⟨(bits / 65536) % 256 % 44,by omega⟩)

abbrev RowsGood (i : I) := ∀ p : Fin 6, (∃ h, cell i p h = some true) ∨
    ∃ h k, h ≠ k ∧ cell i p h = none ∧ cell i p k = none
abbrev PairsGood (i : I) := ∀ (p q : Fin 6) (h : Fin 5), p ≠ q →
    cell i p h = some false ∨ cell i q h = some false ∨ (cell i p h = none ∧ cell i q h = none)
abbrev MoveOK (i : I) (p : Fin 6) (h : Fin 5) :=
  let r := response i p h
  let j := r.1
  let a := permP r.2.1
  let b := permH r.2.2
  depth j + 1 = depth i ∧ cell j (a p) (b h) ≠ none ∧
    ∀ (q : Fin 6) (k : Fin 5), cell i q k = none ∨ cell j (a q) (b k) = cell i q k

set_option maxRecDepth 16000 in
set_option maxHeartbeats 0 in
theorem boards : ∀ i, RowsGood i ∧ PairsGood i := by decide +kernel

set_option maxRecDepth 16000 in
set_option maxHeartbeats 0 in
theorem strategy : ∀ (i : I), depth i ≠ 0 → ∀ p h, cell i p h = none → MoveOK i p h := by decide +kernel

def value (i : I) (a : Equiv.Perm (Fin 6)) (b : Equiv.Perm (Fin 5)) (v : V) := cell i (a v.1) (b v.2)

theorem base_good (i : I) (a : Equiv.Perm (Fin 6)) (b : Equiv.Perm (Fin 5)) : BaseSafe (value i a b) := by
  intro c hc
  rcases hc with ⟨p,rfl⟩ | ⟨p,q,h,pq,rfl⟩
  · have mem (h : Fin 5) : ((p,h),true) ∈ Finset.univ.image (fun j : Fin 5 => ((p,j),true)) :=
      Finset.mem_image.mpr ⟨h,Finset.mem_univ _,rfl⟩
    rcases (boards i).1 (a p) with ⟨h,on⟩ | ⟨h,k,ne,uh,uk⟩
    · exact Or.inl ⟨_,mem (b.symm h),by simpa [Holds,value] using on⟩
    · refine Or.inr ⟨_,mem (b.symm h),_,mem (b.symm k),?_,?_,?_⟩
      · intro eq
        exact ne (b.symm.injective (congrArg (fun l : L => l.1.2) eq))
      · simpa [value] using uh
      · simpa [value] using uk
  · have memp : ((p,h),false) ∈ ({((p,h),false),((q,h),false)} : C) := by simp
    have memq : ((q,h),false) ∈ ({((p,h),false),((q,h),false)} : C) := by simp
    rcases (boards i).2 (a p) (a q) (b h) (fun eq => pq (a.injective eq)) with hp | hq | ⟨up,uq⟩
    · exact Or.inl ⟨_,memp,hp⟩
    · exact Or.inl ⟨_,memq,hq⟩
    · exact Or.inr ⟨_,memp,_,memq,fun eq => pq (congrArg (fun l : L => l.1.1) eq),up,uq⟩

theorem play (d : Nat) (i : I) (di : depth i = d) (a : Equiv.Perm (Fin 6)) (b : Equiv.Perm (Fin 5)) :
    Game d (value i a b) := by
  induction d generalizing i a b with
  | zero => exact base_good i a b
  | succ d ih =>
    refine ⟨base_good i a b,?_⟩
    rintro ⟨p,h⟩ unknown
    let r := response i (a p) (b h)
    obtain ⟨rank,fixed,ext⟩ := strategy i (by omega) (a p) (b h) unknown
    let ap := a.trans (permP r.2.1)
    let bp := b.trans (permH r.2.2)
    refine ⟨value r.1 ap bp,?_,fixed,ih r.1 (Nat.succ.inj (rank.trans di)) ap bp⟩
    rintro ⟨q,k⟩ bit was
    rcases ext (a q) (b k) with absent | same
    · change cell i (a q) (b k) = some bit at was
      simp_all
    · exact same.trans was


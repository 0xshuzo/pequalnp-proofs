def inc (v : CountVec) (x : Nat) : CountVec :=
  let c1 := v.w0 &&& x
  let c2 := v.w1 &&& c1
  let c3 := v.w2 &&& c2
  let c4 := v.w3 &&& c3
  ⟨v.w0 ^^^ x, v.w1 ^^^ c1,v.w2 ^^^ c2,v.w3 ^^^ c3,v.w4 ^^^ c4⟩
def thresh (v : CountVec) (k : Nat) : Nat :=
  let advance (i a z : Nat) := if k.testBit i then a &&& z else a ||| z

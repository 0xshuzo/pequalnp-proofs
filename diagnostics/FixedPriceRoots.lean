    fits (permute o (s &&& a)) (one j) (two j) && fits (permute o (s &&& b)) (one j) (two j)
def getUp (a z : Nat) : Nat :=
  let m := testMask (z % 2048)
  let t := (z>>>11)%64
  let j := (z>>>17)%4096
  let o := z>>>29
  let allowed := if j=0 then max 1 (baseScore full (R a) m 43) else
